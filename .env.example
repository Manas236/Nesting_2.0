# ============================================================
# MySQL connection settings
# ------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# The .env file holds secrets and is git-ignored — never commit it.
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=nesting_tree

# ============================================================
# In-page editor sign-in
# ------------------------------------------------------------
# All three are REQUIRED for editing to work, and the server refuses to
# serve any write route without EDIT_SECRET — see src/lib/edit-auth.ts.
# Generate all three with:
#     openssl rand -base64 32 | tr -d '=+/' | cut -c1-40
# Put the real values in .env on the server and nowhere else. Never in
# this file, never in DEPLOYMENT.md, never in a commit.
# ============================================================

# The secret second path segment: the editor signs in at /studio/<slug>.
# LONG AND RANDOM, not a word — "admin", "editor" or "login" is on every
# scanner's wordlist and the whole point of this value is to be off them.
# Nothing links to it and it is not in robots.txt (listing it there would
# publish it). Read at REQUEST time, so changing it is `systemctl restart
# nestingtree` — not a rebuild.
EDIT_LOGIN_SLUG=replace_me_with_40_random_characters

# What the person actually types into the box. This is the protection;
# the slug above only decides who ever finds the box.
EDIT_PASSPHRASE=replace_me_with_a_long_random_passphrase

# The HMAC key the seven-day session cookie is signed with. 32+ random
# bytes. Nothing derives from it and nothing needs to survive a rotation,
# so change it freely — but know that changing EITHER this or
# EDIT_PASSPHRASE invalidates every cookie already issued and signs
# everybody out the moment the service restarts.
EDIT_SECRET=replace_me_with_32_or_more_random_bytes
