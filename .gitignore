.image-audit/

# local text-audit scratch — the script and the report it generates. Kept out
# of the tree so audit runs never dirty a working branch.
audit/

# 325 MB of duplicated, unreferenced assets moved out of public/ on
# 13 Aug 2026 — see SEO-AUDIT-13AUG2026.md. Nothing in src/ points at them and
# they were never tracked; kept on disk rather than deleted so the decision is
# reversible. Delete the folder once you are sure.
_quarantine/
