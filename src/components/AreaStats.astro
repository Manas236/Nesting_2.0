---
/* Carpet-area stat strip for the flat-types section of a project page.

   Figures are the RERA carpet areas printed on that project's
   approved building plan, held in src/data/<project>.ts as a
   `stats: { label, value }[]` field on each unit type:

     <AreaStats stats={u.stats} class="mt-8" />

   Designed to sit on a bg-card ground — the tiles are bg-stone.

   KILL SWITCH: set `features.areaStats = false` in src/data/site.ts
   and every strip on every project page stops rendering, along with
   the source line underneath it (guarded by the same flag at each
   call site). Nothing needs deleting — flip it back to restore. */
import { features } from "../data/site";

interface Props {
  stats: { label: string; value: string }[];
  /** Spacing and width at the call site — no max-width is set here,
      so each caller passes its own (e.g. "mt-8 max-w-md"). */
  class?: string;
}

const { stats, class: extra = "" } = Astro.props;
---

{
  features.areaStats && (
    <dl class:list={["flex flex-col gap-3", extra]}>
      {stats.map((s) => (
        <div class="flex items-baseline justify-between gap-4 bg-stone border border-line rounded-[3px] px-4 py-3">
          <dt class="text-muted text-sm">{s.label}</dt>
          <dd class="font-display font-bold tracking-tight text-ink text-sm text-right tabular-nums">
            {s.value}
          </dd>
        </div>
      ))}
    </dl>
  )
}
