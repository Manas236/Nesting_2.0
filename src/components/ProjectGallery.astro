---
/* ============================================================
   ProjectGallery — real photography strip for the project pages.
   Sits directly below the flat/home layout renders: the owner's call,
   13 Aug 2026 — down by the footer nobody ever reached it.

   Photos are documentary site shots (real buildings, real finishes),
   so the layout is a natural masonry (CSS columns) that keeps each
   image at its native aspect ratio — no cropping decisions, no
   forced tiles. Clicking a photo opens a lightbox with prev / next
   and keyboard control; with JS off it degrades to a plain grid of
   links that still open each image.

   Usage:
     <ProjectGallery project="Rudra" items={gallery} />
   where `items` is `{ src, alt, category }[]` from the project's
   data file. Everything is real — never pass renders or stock here.
   ============================================================ */
import { galleryImage, type GalleryItem } from "../lib/gallery-images";

/* The masonry is 3 columns inside a 1600 px container with 1.5rem gaps
   and 3rem of page padding, so a slot tops out near 31vw; 2 columns with
   1.25rem gaps from 640 px, and one full-bleed column below that. */
const SIZES = "(min-width: 1024px) 31vw, (min-width: 640px) 47vw, 92vw";

interface Props {
  project: string;
  items: GalleryItem[];
  eyebrow?: string;
  heading?: string;
  lead?: string;
  /* Same escape hatch as <BuildProgress/>: the gallery now lands mid-page,
     so each project page passes the background that keeps its own
     stone/card alternation reading correctly. */
  sectionClass?: string;
}

const {
  project,
  items,
  eyebrow = "The gallery",
  heading = `${project}, in photographs.`,
  lead = `Real photographs from ${project}: the building, the common areas and the finishes, shot on site.`,
  sectionClass = "bg-stone py-24 lg:py-32 border-t border-line scroll-mt-20",
} = Astro.props;
---

{
  items && items.length > 0 && (
    <section id="gallery" class={sectionClass}>
      <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
        <div class="reveal max-w-3xl mb-16 lg:mb-20">
          <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600">
            {eyebrow}
          </span>
          <h2 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]">
            {heading}
          </h2>
          <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">{lead}</p>
        </div>

        <div class="gallery-masonry" data-gallery>
          {items.map((it, i) => {
            /* The link — and so the lightbox — always points at the full
               image; only the grid downloads the 640 px thumbnail. */
            const img = galleryImage(it, SIZES);
            return (
            <a
              href={it.src}
              class="gallery-item reveal group"
              data-gallery-item
              data-index={i}
              style={`--reveal-d:${((i % 4) * 0.06).toFixed(2)}s`}
              aria-label={`View photo${it.category ? ` — ${it.category}` : ""}`}
            >
              <img
                src={img.src}
                srcset={img.srcset}
                sizes={img.sizes}
                width={img.width}
                height={img.height}
                alt={it.alt}
                class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
              <span class="gallery-scrim" aria-hidden="true" />
              {it.category && (
                <span class="gallery-tag font-display">{it.category}</span>
              )}
              <span class="gallery-zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
                </svg>
              </span>
            </a>
            );
          })}
        </div>
      </div>

      {/* Lightbox overlay — hidden until a photo is clicked (JS only). */}
      <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label={`${project} photo viewer`}>
        <button class="lightbox-close" data-lightbox-close type="button" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <button class="lightbox-nav lightbox-prev" data-lightbox-prev type="button" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <figure class="lightbox-figure">
          <img class="lightbox-img" data-lightbox-img src="" alt="" />
          <figcaption class="lightbox-caption font-display" data-lightbox-caption></figcaption>
        </figure>
        <button class="lightbox-nav lightbox-next" data-lightbox-next type="button" aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>
        <span class="lightbox-count font-display" data-lightbox-count></span>
      </div>
    </section>
  )
}

<style>
  /* --- masonry grid via CSS columns (keeps native aspect ratios) --- */
  .gallery-masonry {
    column-count: 1;
    column-gap: 1rem;
  }
  @media (min-width: 640px) {
    .gallery-masonry {
      column-count: 2;
      column-gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .gallery-masonry {
      column-count: 3;
      column-gap: 1.5rem;
    }
  }

  .gallery-item {
    position: relative;
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-card, #efeee9);
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.08));
    cursor: zoom-in;
  }
  @media (min-width: 640px) {
    .gallery-item {
      margin-bottom: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .gallery-item {
      margin-bottom: 1.5rem;
    }
  }

  .gallery-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(15, 18, 10, 0.55) 0%, rgba(15, 18, 10, 0) 42%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .gallery-item:hover .gallery-scrim {
    opacity: 1;
  }

  .gallery-tag {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #fff;
    background: rgba(15, 18, 10, 0.5);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 0.35rem 0.7rem;
    border-radius: 2px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .gallery-item:hover .gallery-tag {
    opacity: 1;
    transform: none;
  }

  .gallery-zoom {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(15, 18, 10, 0.5);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .gallery-zoom svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .gallery-item:hover .gallery-zoom {
    opacity: 1;
    transform: none;
  }

  /* --- lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(10, 12, 8, 0.94);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.is-open {
    opacity: 1;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(92vw, 1200px);
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 3px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .lightbox-caption {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
  }
  .lightbox-caption:empty {
    display: none;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .lightbox-close {
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    width: 3rem;
    height: 3rem;
  }
  .lightbox-close svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3.25rem;
    height: 3.25rem;
  }
  .lightbox-nav svg {
    width: 1.6rem;
    height: 1.6rem;
  }
  .lightbox-prev {
    left: clamp(0.75rem, 3vw, 2rem);
  }
  .lightbox-next {
    right: clamp(0.75rem, 3vw, 2rem);
  }
  .lightbox-count {
    position: absolute;
    bottom: clamp(1rem, 3vw, 2rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item img,
    .gallery-scrim,
    .gallery-tag,
    .gallery-zoom,
    .lightbox {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const gallery = document.querySelector("[data-gallery]");
    const box = document.querySelector("[data-lightbox]");
    if (!gallery || !box) return;

    const items = Array.from(gallery.querySelectorAll("[data-gallery-item]"));
    const imgEl = box.querySelector("[data-lightbox-img]");
    const capEl = box.querySelector("[data-lightbox-caption]");
    const countEl = box.querySelector("[data-lightbox-count]");
    const btnClose = box.querySelector("[data-lightbox-close]");
    const btnPrev = box.querySelector("[data-lightbox-prev]");
    const btnNext = box.querySelector("[data-lightbox-next]");

    const slides = items.map((a) => ({
      src: a.getAttribute("href"),
      cap: a.querySelector("img")?.getAttribute("alt") || "",
      tag: a.querySelector(".gallery-tag")?.textContent || "",
    }));

    let current = 0;
    let lastFocused = null;

    function render() {
      const s = slides[current];
      if (!s) return;
      imgEl.setAttribute("src", s.src);
      imgEl.setAttribute("alt", s.cap);
      capEl.textContent = s.tag;
      countEl.textContent = `${current + 1} / ${slides.length}`;
      const single = slides.length < 2;
      btnPrev.hidden = single;
      btnNext.hidden = single;
    }

    function open(i) {
      current = i;
      lastFocused = document.activeElement;
      render();
      box.hidden = false;
      box.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => box.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      btnClose.focus();
    }

    function close() {
      box.classList.remove("is-open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      const finish = () => {
        box.hidden = true;
        box.removeEventListener("transitionend", finish);
      };
      box.addEventListener("transitionend", finish);
      // Fallback in case transitionend doesn't fire.
      setTimeout(() => { if (!box.classList.contains("is-open")) box.hidden = true; }, 350);
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function go(delta) {
      current = (current + delta + slides.length) % slides.length;
      render();
    }

    items.forEach((a, i) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        open(i);
      });
    });

    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => go(-1));
    btnNext.addEventListener("click", () => go(1));
    box.addEventListener("click", (e) => {
      if (e.target === box) close();
    });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") go(-1);
      else if (e.key === "ArrowRight") go(1);
    });
  })();
</script>
