---
/* Scan-to-connect band for the project pages.
   Sits between the "Nesting Tree advantage" strip and the enquiry form.

   To go live, drop the QR artwork into public/images/qr/ and pass it in:
     <QrBlock project="Shikhar" src="/images/qr/shikhar.png" />
   Until then the dashed placeholder holds the exact footprint. */
interface Props {
  project: string;
  /** Path to the QR artwork. Leave unset to render the placeholder. */
  src?: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
  caption?: string;
}

const {
  project,
  src,
  eyebrow = "Scan to connect",
  heading = "Point your camera here.",
  body = `Scan the code for the ${project} brochure, floor plans and a direct line to our sales team — no forms, no waiting.`,
  caption = "Open your camera and hold it over the code",
} = Astro.props;
---

<section id="qr" class="bg-ink text-stone py-20 lg:py-28 scroll-mt-20">
  <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="reveal max-w-xl">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-100"
          >{eyebrow}</span
        >
        <h2
          class="font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          {heading}
        </h2>
        <p class="text-stone/60 text-lg sm:text-xl leading-relaxed mt-6">{body}</p>
      </div>

      <div class="reveal flex lg:justify-end" style="--reveal-d:0.08s">
        <figure class="w-full max-w-[340px]">
          <div
            class="aspect-square w-full bg-white/[0.04] border border-dashed border-white/25 rounded-[2px] grid place-items-center p-6"
          >
            {
              src ? (
                <img
                  src={src}
                  alt={`QR code for ${project}`}
                  width="512"
                  height="512"
                  loading="lazy"
                  class="w-full h-full object-contain"
                />
              ) : (
                <div class="text-center">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-12 h-12 mx-auto text-stone/40"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <path d="M14 14h3v3h-3zM20 14h1M14 20h3M20 17v4" />
                  </svg>
                  <span class="block font-display text-xs font-bold uppercase tracking-[0.18em] text-stone/50 mt-5">
                    QR code
                  </span>
                  <span class="block text-stone/35 text-xs mt-2">Placeholder — artwork pending</span>
                </div>
              )
            }
          </div>
          <figcaption
            class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/45 mt-4 text-center"
          >
            {caption}
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
