---
/* ---------------------------------------------------------------------------
   SiteHeader — the single source of truth for the site navbar.

   Every page renders this component, so the global links, spacing, entrance
   animation and transparent→solid scroll behaviour are identical everywhere.
   Page-specific section jump links (Overview / Units / Amenities …) are passed
   in via `sections` and render as a secondary strip *below* the global row,
   rather than replacing the global links the way the old per-page copies did.
--------------------------------------------------------------------------- */
import { brand, nav, whatsappHref } from "../data/site";

interface Props {
  /** Optional in-page jump links, rendered as a sub-nav strip. */
  sections?: { label: string; href: string }[];
  /** Unused for the CTA now — kept for backwards compatibility. */
  ctaHref?: string;
  /** Project name, from a project page. Names the building in the CTA's
      pre-filled WhatsApp message; omit it anywhere else and the message
      falls back to a general enquiry. */
  project?: string;
}

const { sections = [], project } = Astro.props;

// "WhatsApp Us" opens a WhatsApp chat with the sales number. It used to open
// the visitor's email app on desktop and the dialer on touch devices, which
// needed the two data-cta-* attributes and a pointer check in the script
// below; wa.me covers both (app on a phone, WhatsApp Web on a desktop), so
// one plain href replaces all of it. See whatsappHref in src/data/site.ts.
const waHref = whatsappHref(
  project
    ? `Hi ${brand.name}, I'd like to enquire about ${project}.`
    : `Hi ${brand.name}, I'd like to enquire about your homes.`
);

const path = Astro.url.pathname;
const isHome = path === "/";

// Hash-only hrefs (#contact) only resolve on the home page; from anywhere else
// they have to point back at the home page's section.
const resolve = (href: string) => (href.startsWith("#") && !isHome ? `/${href}` : href);

// /projects/shikhar should still light up the "Projects" link.
const isActive = (href: string) => {
  if (href.startsWith("#")) return false;
  if (href === "/") return isHome;
  return path === href || path.startsWith(`${href}/`);
};

const ctaDelay = (0.3 + nav.length * 0.08).toFixed(2);
---

<!-- Sits under the header (z-40 vs z-50) and over the page, so the open menu
     reads as an overlay instead of as a strip of transparent nav laid on top
     of live content. Tapping it closes the menu. -->
<div id="menu-scrim" class="md:hidden fixed inset-0 z-40" aria-hidden="true"></div>

<header id="site-header" class="fixed top-0 left-0 right-0 z-50">
  <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
    <div class="flex items-center justify-between h-[72px] lg:h-20">
      <!-- Owner's instruction (punch-list item 1): "the customer should know
           they have reached the NT page" — the mark had to be bigger.

           WHY THE LOCKUP TURNED SIDEWAYS. It used to stack the mark above a
           two-line wordmark, which came to ~72px inside an 80px bar — about
           8px of headroom, so the mark could not grow by any amount worth
           having. Side by side, the bar's height stops being the constraint
           and the mark goes 36px → 56px on desktop, 32px → 44px on mobile.

           THE BAR HEIGHT ITSELF MUST NOT CHANGE. `scroll-mt-20` (80px) is on
           59 anchored sections across the site and is matched to `lg:h-20`
           here. Grow the header and every jump link lands with its heading
           tucked underneath it — so if the mark needs to be bigger still,
           either those 59 values move too, or the wordmark goes. -->
      <a href="/" class="nav-animate flex items-center gap-2.5 shrink-0" style="--nav-d:0.15s">
        <img
          src={brand.logoMark}
          alt={`${brand.name} logo`}
          width="36"
          height="42"
          class="h-11 w-auto lg:h-14 drop-shadow-sm"
        />
        <span
          class="nav-wordmark font-display font-extrabold text-base lg:text-lg tracking-tight leading-[1.05]"
          data-no-edit
          >Nesting<br />Tree</span
        >
      </a>

      <nav
        class="hidden md:flex items-center gap-7 lg:gap-11 font-display text-[13px] font-bold uppercase tracking-[0.08em]"
      >
        {
          nav.map((item, i) => (
            <a
              href={resolve(item.href)}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={["nav-link", "nav-animate", { "is-current": isActive(item.href) }]}
              style={`--nav-d:${(0.3 + i * 0.08).toFixed(2)}s`}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        class="nav-cta nav-animate hidden md:inline-flex font-display font-bold text-[13px] uppercase tracking-[0.08em] px-5 py-2.5 rounded-[2px]"
        style={`--nav-d:${ctaDelay}s`}>WhatsApp Us</a
      >

      <button
        id="menu-toggle"
        class="nav-animate md:hidden p-2 -mr-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        style="--nav-d:0.3s"
      >
        <svg
          class="nav-toggle-icon w-6 h-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          ><path class="icon-open" d="M4 7h16M4 12h16M4 17h16"></path><path
            class="icon-close"
            d="M6 6l12 12M18 6L6 18"></path></svg
        >
      </button>
    </div>

    <!-- No background of its own: the header paints the surface behind both
         rows, so the bar and the panel are one block of colour. -->
    <div id="mobile-menu" class="md:hidden -mx-5 sm:-mx-6 px-5 sm:px-6">
      <nav class="flex flex-col gap-1 pb-6 font-display font-bold text-base uppercase tracking-wide">
        {
          nav.map((item) => (
            <a
              href={resolve(item.href)}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="mobile-link py-3.5"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={waHref}
          target="_blank"
          rel="noopener"
          class="mobile-cta mobile-link mt-4 text-center px-5 py-3.5 rounded-[2px]"
          >WhatsApp Us</a
        >
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    // Nothing to do for "WhatsApp Us" any more: it is a plain wa.me link that
    // works the same on every device. This script is scroll state and the
    // mobile menu only.
    const header = document.getElementById("site-header");
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const scrim = document.getElementById("menu-scrim");

    // One place to flip every part of the open state: the panel, the scrim,
    // the header's dark surface and the page scroll lock. They have to move
    // together — a panel without the lock lets the page scroll underneath and
    // recolour the header mid-open.
    const setMenu = (open) => {
      menu.classList.toggle("open", open);
      scrim.classList.toggle("open", open);
      header.classList.toggle("menu-open", open);
      document.documentElement.classList.toggle("menu-lock", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => setMenu(!menu.classList.contains("open")));
    scrim.addEventListener("click", () => setMenu(false));
    menu
      .querySelectorAll(".mobile-link")
      .forEach((link) => link.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setMenu(false);
    });

    // Rotating or resizing past the mobile breakpoint hides the toggle, so
    // close up rather than leave the scroll lock with no button to release it.
    const desktop = window.matchMedia("(min-width: 768px)");
    desktop.addEventListener("change", (e) => {
      if (e.matches) setMenu(false);
    });
  })();
</script>
