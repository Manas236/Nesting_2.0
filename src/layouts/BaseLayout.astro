---
import "../styles/global.css";
import { CACHE_PREFIX } from "../lib/editable";
import { brand } from "../data/site";
import { organizationSchema, jsonLd } from "../lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /* An extra JSON-LD node for THIS page, emitted as a second script
     alongside the site-wide Organization one. Project pages pass
     `residenceSchema(...)`, which returns null when a project should
     not have a node — so null and undefined both mean "emit nothing"
     and neither is a mistake to guard against at the call site. */
  schema?: unknown;
  /* Keep this page out of the search index. Only /thank-you sets it: a
     form-confirmation page is a bad search result for everyone who
     reaches it that way. "follow" is deliberate — the links out of it
     to /projects and the policies still pass on normally.

     It is NOT the whole story. /thank-you is also disallowed in
     robots.txt, and a crawler that honours the disallow never fetches
     the page and so never sees this tag. The two overlap on purpose:
     the disallow is what stops the crawl, and this is what holds if the
     page is ever reached anyway — today it is behind a 303 from
     /api/contact with nothing linking to it. */
  noindex?: boolean;
}

const {
  title = "Nesting Tree — Residential Developer · Navi Mumbai",
  /* The homepage's description as well as the fallback — index.astro
     passes none. Google renders about 155 characters, so the tail of
     this sentence is what gets cut: keep the region and the amenity
     list ahead of the year, not after it. The old wording ran to 179
     and spent its last 41 saying "Building homes in Navi Mumbai since
     2004" — a second "Navi Mumbai" in a line that had already said it.

     Region and year are interpolated for the usual reason: they are
     facts about the company and there is one place they live. The year
     is `legacyYear`, which is what a bare "Since …" has to be — see the
     rule on `brand` in src/data/site.ts. The amenity list is worded to
     match the one in the Organization schema description. */
  description =
    `Nesting Tree builds amenity-first homes across ${brand.region}. ` +
    `Rooftop, gym, lift, CCTV, security and parking: built in, not bolted on. ` +
    `Since ${brand.legacyYear}.`,
  // Share-card image. Pass one of the purpose-built 1200×630 cards in
  // /images/og/ — NOT a hero render. See the note below.
  image = "/images/og/default.jpg",
  schema,
  noindex = false,
} = Astro.props;

/* ---------- Social share URLs ----------
   og:image MUST be absolute. A relative path silently produces no preview
   image on WhatsApp, Facebook and LinkedIn — they do not resolve it against
   the page. `Astro.site` comes from `site` in astro.config.mjs.

   The images in /images/og/ are built to the 1200×630 card ratio and kept
   under ~110 KB, because WhatsApp will not render a large image. Do not point
   these tags at a hero render: those are 1.5–2 MB portrait files, and the
   architect's title block is baked into the bottom of several of them. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

/* ---------- Structured data ----------
   The same Organization node on every page, which is what schema.org's
   @id is for: crawlers fold the repeats into one entity rather than
   reading each page as a separate company. Built from src/data/site.ts —
   see src/lib/structured-data.ts before changing any value. */
const orgLd = jsonLd(organizationSchema(new URL(Astro.site!)));

/* The page's own node, if it has one — currently the per-project
   Residence, built by residenceSchema() in the same file. It goes in a
   SECOND script tag rather than into an @graph with the company: the
   Organization is identical on all fourteen pages and is what makes the
   repeats fold into one entity, and merging a page-specific node into it
   would make every page's company block different from every other's. */
const pageLd = schema ? jsonLd(schema) : null;

/* ---------- In-page text editing ----------
   The feature is injected here and only here, as two script tags.

   1. An inline head script. It has to be inline, in the head, ahead of
      everything: it starts the fetch for this page's saved text while the
      rest of the document is still being parsed, and it paints the copy
      already cached in localStorage the moment the DOM exists — which is
      before the deferred editor runs, so returning visitors do not watch
      the built-in text flip to the edited text.

      It also owns the two things both halves have to agree on: how an
      element's edit_key is spelled, and how text is normalised before
      comparing. The editor imports neither — it calls back into
      window.__ntEdit, so there is exactly one implementation of each.

   2. A bundled module script at the end of the body: the gestures, the
      toolbar and saving, none of which the first paint needs.

   The prose lives up here rather than beside the tags because an inline
   script followed by a MULTI-LINE HTML comment does not survive the Astro
   compiler — it reports "Unexpected token" and fails the build. Keep any
   comment down there to a single line. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nesting Tree" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={orgLd} is:inline />
    {pageLd && <script type="application/ld+json" set:html={pageLd} is:inline />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Enable scroll-reveal only when JS + motion are available, so
         no-JS and reduced-motion users always see fully rendered content.
         Set in <head> to avoid any flash of pre-animation state. -->
    <script is:inline>
      if (
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
        "IntersectionObserver" in window
      ) {
        document.documentElement.classList.add("reveal-on");
      }
    </script>

    <!-- In-page text editing, part 1 of 2 — see the note in the frontmatter. -->
    <script is:inline define:vars={{ NT_CACHE_PREFIX: CACHE_PREFIX }}>
      window.__ntEdit = (function () {
        /* Written as escapes rather than literals: these characters are
           invisible in an editor, and a mangled one fails silently. */
        var RE_NBSP = new RegExp("\u00a0", "g");
        var RE_ZERO_WIDTH = new RegExp("[\u200b-\u200d\ufeff]", "g");

        /* Same shape the server stores: lower case, no trailing slash. */
        var path = location.pathname.split("?")[0].split("#")[0].toLowerCase();
        if (path.length > 1) path = path.replace(/\/+$/, "");
        if (!path) path = "/";

        var cacheKey = NT_CACHE_PREFIX + path;

        /* Mirrors normalizeText() in src/lib/editable.ts. Prerendered
           markup wraps copy across source lines, so this is what makes
           "did this element still hold the original text?" answerable. */
        function normalize(s) {
          return String(s == null ? "" : s)
            .replace(RE_NBSP, " ")
            .replace(RE_ZERO_WIDTH, "")
            .replace(/[\r\n\t]+/g, " ")
            .replace(/\s{2,}/g, " ")
            .trim();
        }

        function textOf(el) {
          return normalize(el.textContent);
        }

        /* Editable means one text node and nothing else: a leaf holding
           a single run of words. Anything richer would lose its children
           the moment we assigned textContent. */
        function isTextLeaf(el) {
          return (
            el.childNodes.length === 1 &&
            el.firstChild.nodeType === 3 &&
            normalize(el.firstChild.nodeValue) !== ""
          );
        }

        function setText(el, t) {
          el.textContent = t;
        }

        /* Tags whose text is not copy, or which have no text to speak
           of, and the blocks the markup has opted out by hand. Both live
           here rather than in the editor because the wrap pass below and
           the editor's marking pass have to agree on them exactly. */
        var SKIP_TAGS =
          " SCRIPT STYLE SVG INPUT TEXTAREA SELECT OPTION IFRAME " +
          "NOSCRIPT CANVAS VIDEO AUDIO IMG BR HR TEMPLATE ";
        var OPT_OUT = "svg, [data-nt-ui], [data-no-edit], [aria-hidden='true']";

        function skipTag(el) {
          return SKIP_TAGS.indexOf(" " + el.tagName + " ") !== -1;
        }

        /* ---- Loose copy ----
           A heading broken by a <br>, a button with an icon beside its
           label, a legal clause with a <strong> in the middle of it: the
           words are there, but the element holding them is not a text
           leaf, and writing textContent to it would delete the <br>, the
           icon or the <strong>. Before anything is applied or marked,
           every such run is given a wrapper element of its own, which
           makes it a leaf and so editable on its own terms.

           The wrapper is <nt-t>, a tag that appears nowhere in the
           markup, and that is the whole trick: an edit_key is a path of
           tag:nth-of-type() segments, nth-of-type counts per tag, so
           introducing a tag nothing else uses cannot renumber a single
           existing key. Every edit already in the database still lands
           on the element it was made on.

           Leading and trailing spaces are left outside the wrapper.
           They are what separates "Or call" from the link after it, and
           an edit normalises away everything inside the element it
           touches. */
        var WRAP_TAG = "nt-t";
        var RE_LETTER = /[a-z]/i;
        var RE_EDGES = /^(\s*)([\s\S]*?)(\s*)$/;
        var didWrap = false;

        function looseRuns() {
          var out = [];
          var walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
            null
          );
          var node = walker.nextNode();
          while (node) {
            var p = node.parentElement;
            if (
              p &&
              p.tagName !== "NT-T" &&
              normalize(node.nodeValue) !== "" && // the gaps between tags
              !isTextLeaf(p) && // already reachable whole
              !skipTag(p) &&
              !p.closest(OPT_OUT) &&
              RE_LETTER.test(node.nodeValue) // "·", ".", a stray dash
            ) {
              out.push(node);
            }
            node = walker.nextNode();
          }
          return out;
        }

        function wrapRun(node) {
          var parts = RE_EDGES.exec(node.nodeValue);
          var el = document.createElement(WRAP_TAG);
          el.textContent = parts[2];
          var parent = node.parentNode;
          if (parts[1]) parent.insertBefore(document.createTextNode(parts[1]), node);
          parent.insertBefore(el, node);
          if (parts[3]) parent.insertBefore(document.createTextNode(parts[3]), node);
          parent.removeChild(node);
        }

        /* Idempotent, and called by both halves: whichever runs first
           settles the shape of the DOM that keys are computed against. */
        function ensureWrapped() {
          if (didWrap || !document.body) return;
          didWrap = true;
          /* Collected in full first, so the walk never meets a wrapper
             it has just made. */
          var runs = looseRuns();
          for (var i = 0; i < runs.length; i++) wrapRun(runs[i]);
        }

        /* tag:nth-of-type(n) segments from <body>, joined by ">".
           nth-of-type counts from the start of the sibling list, so the
           toolbar the editor appends to <body> cannot renumber anything
           already on the page — append only, never prepend. */
        function keyFor(el) {
          var parts = [];
          var node = el;
          while (node && node !== document.body && node.nodeType === 1) {
            var n = 1;
            var sib = node.previousElementSibling;
            while (sib) {
              if (sib.tagName === node.tagName) n++;
              sib = sib.previousElementSibling;
            }
            parts.unshift(node.tagName.toLowerCase() + ":nth-of-type(" + n + ")");
            node = node.parentElement;
          }
          return node === document.body ? parts.join(">") : "";
        }

        function elFor(key) {
          if (!key) return null;
          try {
            return document.body.querySelector(":scope>" + key);
          } catch (e) {
            return null;
          }
        }

        function place(el, key, text, original) {
          /* The anchor is the text the page was BUILT with. Stash it
             before overwriting, so a later save still reports it. */
          if (!el.dataset.ntOriginal) el.dataset.ntOriginal = original;
          el.dataset.ntKey = key;
          /* What we last wrote here, so a later pass can tell its own
             handiwork from the text the page shipped with. */
          el.dataset.ntApplied = text;
          el.setAttribute("data-nt-edited", "");
          setText(el, text);
          return el;
        }

        function applyOne(key, text, original) {
          if (!text) return null;

          var el = elFor(key);
          if (el && isTextLeaf(el)) {
            var now = textOf(el);
            /* Three ways this element is the right one to write to:
               it still holds the text the page shipped with; it already
               holds this exact text; or we put what it holds there
               ourselves for this same key — which is the cache pass
               being overtaken by a newer value from the server. */
            if (
              now === original ||
              now === text ||
              (el.dataset.ntKey === key && el.dataset.ntApplied === now)
            )
              return place(el, key, text, original);
          }

          /* The markup moved under the key. Do NOT overwrite whatever
             lives there now — go find the text this edit replaced. */
          var all = document.body.querySelectorAll("*");
          for (var i = 0; i < all.length; i++) {
            var c = all[i];
            if (!isTextLeaf(c)) continue;
            if (c.closest("[data-nt-ui]")) continue;
            if (textOf(c) === original) return place(c, key, text, original);
          }
          return null; // nothing matches: skip, silently
        }

        function applyAll(map) {
          var n = 0;
          if (!map) return n;
          for (var key in map) {
            if (!Object.prototype.hasOwnProperty.call(map, key)) continue;
            var e = map[key];
            if (e && applyOne(key, e.text, e.original)) n++;
          }
          return n;
        }

        function readCache() {
          try {
            return JSON.parse(localStorage.getItem(cacheKey) || "{}") || {};
          } catch (e) {
            return {};
          }
        }

        function writeCache(map) {
          try {
            localStorage.setItem(cacheKey, JSON.stringify(map || {}));
          } catch (e) {
            /* private mode, or the quota is full: the page still works */
          }
        }

        /* Off before the parser has even reached the body. Never cached. */
        var ready = fetch("/api/content?path=" + encodeURIComponent(path), {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .catch(function () {
            return null;
          });

        /* readystatechange -> "interactive" fires once the document is
           parsed and BEFORE deferred scripts run, so the cached copy is
           on screen by the time the editor boots. */
        function applyCache() {
          ensureWrapped();
          applyAll(readCache());
        }
        if (document.readyState === "loading") {
          document.addEventListener("readystatechange", function onState() {
            if (document.readyState === "loading") return;
            document.removeEventListener("readystatechange", onState);
            applyCache();
          });
        } else {
          applyCache();
        }

        return {
          path: path,
          cacheKey: cacheKey,
          normalize: normalize,
          textOf: textOf,
          isTextLeaf: isTextLeaf,
          setText: setText,
          skipTag: skipTag,
          optOut: OPT_OUT,
          ensureWrapped: ensureWrapped,
          keyFor: keyFor,
          elFor: elFor,
          applyOne: applyOne,
          applyAll: applyAll,
          readCache: readCache,
          writeCache: writeCache,
          ready: ready,
        };
      })();
    </script>
  </head>
  <body class="text-ink antialiased">
    <slot />

    <!-- In-page text editing, part 2 of 2: the editor. Bundled by Astro, so it loads deferred. -->
    <script>
      import "../scripts/inline-edit.js";
    </script>
  </body>
</html>
