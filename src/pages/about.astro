---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";

import { brand, contact, projects, journey } from "../data/site";
import { about } from "../data/about";

// Absolute links so the header/footer work from this standalone route
// (in-page anchors resolve against the home page, not /about).
// "The Standard" (amenities) is product content and lives on /projects,
// alongside the buildings it describes — hence the cross-page anchor.
const footerLinks = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "The Standard", href: "/projects#amenities" },
  { label: "Journey", href: "#journey" },
  { label: "Contact", href: "/#contact" },
];

// Masthead film. The Rudra elevation doubles as the poster so the first paint
// is instant and reduced-motion visitors still get a still frame.
const mastheadVideo = "/images/projects/about.mp4";
const mastheadPoster = "/images/projects/Rudra.jpg";

// On-this-page jump links. This page is now purely the company story.
const sections = [
  { label: "Story", href: "#story" },
  { label: "Founder", href: "#founder" },
  { label: "Vision", href: "#vision" },
  { label: "Journey", href: "#journey" },
];
---

<BaseLayout
  title="About — Nesting Tree · Residential Developer, Navi Mumbai"
  description="Two decades of Navi Mumbai housing since 2004 and the engineering pedigree of K.D. Construction. Nesting Tree builds amenity-first, clear-title homes."
>
  <!-- ============================ NAVBAR ============================ -->
  <SiteHeader sections={sections} />

  <!-- ============================ MASTHEAD ============================ -->
  <section
    class="relative h-[100svh] min-h-[620px] w-full bg-ink text-stone overflow-hidden"
  >
    <video
      class="hero-img-reveal absolute top-0 left-0 w-full h-full object-cover object-[60%_center] sm:object-center"
      src={mastheadVideo}
      poster={mastheadPoster}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Nesting Tree homes and residents in Navi Mumbai"></video>
    <!-- layered scrims: nav legibility (top), copy (bottom), headline (left) -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/25 to-ink/70"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/75 via-ink/25 to-transparent"></div>

    <div
      class="relative h-full max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col justify-end pb-16 lg:pb-24"
    >
      <span
        class="hero-rise font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.24em] text-olive-100 block"
        style="--rise-d:0.1s">{about.kicker}</span
      >
      <h1
        class="hero-rise font-display font-bold text-white text-[2.75rem] sm:text-6xl lg:text-[6rem] leading-[0.95] tracking-tight mt-5 max-w-4xl"
        style="--rise-d:0.22s"
      >
        {about.title}
      </h1>
      <p
        class="hero-rise text-white/70 text-base sm:text-lg lg:text-xl mt-7 max-w-2xl leading-relaxed"
        style="--rise-d:0.36s"
      >
        {about.lede}
      </p>
      <p
        class="hero-fade font-display text-[11px] font-bold uppercase tracking-[0.2em] text-white/45 mt-10 flex flex-wrap gap-x-3 gap-y-1 items-center"
        style="--fade-d:0.6s"
      >
        <span>Building since {brand.legacyYear}</span><span class="text-white/25">·</span>
        <span>{brand.region}</span><span class="text-white/25">·</span>
        <span>{contact.maharera}</span>
      </p>
    </div>
  </section>

  <!-- ============================ OUR STORY ============================ -->
  <section id="story" class="bg-stone py-16 sm:py-20 lg:py-28 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <!-- Eyebrow sits above the grid so the headline and the lead paragraph
           share the same top edge across both columns. -->
      <span
        class="reveal font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-olive-600 flex items-center gap-3"
      >
        <span class="h-px w-8 bg-olive-600/50" aria-hidden="true"></span>
        {about.story.label}
      </span>

      <div class="grid lg:grid-cols-12 gap-y-8 lg:gap-x-16 mt-5 lg:mt-7">
        <!-- Heading rail. Sticks alongside the copy on large screens so the
             section title stays anchored while the story scrolls past. -->
        <div class="lg:col-span-4">
          <h2
            class="reveal lg:sticky lg:top-28 font-display font-bold text-[2rem] sm:text-4xl lg:text-5xl tracking-tight leading-[1.05] text-balance lg:pt-1"
            style="--reveal-d:0.08s"
          >
            {about.story.heading}
          </h2>
        </div>

        <div class="lg:col-span-8">
          <!-- Lead: set apart with an olive rule so the wall of copy has an
               entry point on small screens. -->
          <p
            class="reveal text-ink text-[1.0625rem] sm:text-xl lg:text-[1.375rem] leading-[1.6] font-medium max-w-[62ch] border-l-2 border-olive/40 pl-5 sm:pl-6"
            style="--reveal-d:0.12s"
          >
            {about.story.lead}
          </p>

          <div
            class="reveal mt-8 sm:mt-10 max-w-[62ch] lg:max-w-none grid lg:grid-cols-2 gap-y-5 lg:gap-x-12"
            style="--reveal-d:0.2s"
          >
            {
              about.story.paragraphs.map((para) => (
                <p class="text-muted text-[0.9375rem] sm:text-base lg:text-[1.0625rem] leading-[1.75]">
                  {para}
                </p>
              ))
            }
          </div>
        </div>
      </div>

      <!-- At-a-glance spec strip. Stacked rows on phones (long values get the
           full width), a 4-up divided strip from lg. -->
      <div class="reveal mt-12 sm:mt-14 lg:mt-20">
        <span
          class="font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-olive-600 flex items-center gap-3"
        >
          <span class="h-px w-8 bg-olive-600/50" aria-hidden="true"></span>
          At a Glance
        </span>
        <dl
          class="grid sm:grid-cols-2 lg:grid-cols-4 mt-5 sm:mt-7 border-t border-line lg:divide-x lg:divide-line"
        >
          {
            about.story.facts.map((f, i) => (
              <div
                class={`py-4 sm:py-5 lg:py-6 border-b border-line lg:border-b-0 lg:px-8 ${
                  i === 0 ? "lg:pl-0" : ""
                } ${i === about.story.facts.length - 1 ? "lg:pr-0" : ""}`}
              >
                <dt class="font-display text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.16em] text-mutedlight">
                  {f.k}
                </dt>
                <dd class="font-display font-bold text-lg sm:text-xl lg:text-2xl tracking-tight mt-1.5 lg:mt-2 text-ink leading-tight">
                  {f.v}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ===================== FOUNDER / LEADERSHIP ===================== -->
  <section
    id="founder"
    class="relative bg-ink text-stone py-20 lg:py-28 overflow-hidden scroll-mt-20"
  >
    <div class="absolute inset-0 blueprint-dark opacity-50"></div>

    <div class="relative max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-y-12 lg:gap-x-16 items-stretch">
        <!-- Founder portrait -->
        <div class="lg:col-span-5">
          <div
            class="reveal-img relative aspect-[4/5] lg:aspect-auto lg:h-full min-h-[26rem] w-full max-w-md lg:max-w-none mx-auto lg:mx-0 overflow-hidden rounded-[3px] blueprint-dark border border-white/10"
          >
            <img
              src="/images/Kd_Sir.JPG"
              alt={`${about.founder.name}, ${about.founder.role} of Nesting Tree`}
              width="2793"
              height="4160"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
            />
            <!-- Bottom gradient so the caption stays legible over the photo -->
            <div
              class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/85 via-black/45 to-transparent"
            ></div>
            <span
              class="tick top-5 left-5 border-t-2 border-l-2"
              style="border-color:rgba(255,255,255,.35)"></span>
            <span
              class="tick bottom-5 right-5 border-b-2 border-r-2"
              style="border-color:rgba(255,255,255,.35)"></span>
            <div class="absolute inset-x-0 bottom-0 px-7 pb-7 flex flex-col">
              <span
                class="font-display font-bold text-2xl lg:text-3xl text-white tracking-tight"
                >{about.founder.name}</span
              >
              <span
                class="font-display text-[11px] font-bold uppercase tracking-[0.2em] text-olive-100 mt-2"
                >{about.founder.role}</span
              >
              <span
                class="font-display text-[11px] font-semibold uppercase tracking-[0.16em] text-white/50 mt-4 pt-4 border-t border-white/15"
                >{about.founder.tenure}</span
              >
            </div>
          </div>
        </div>

        <!-- Story column -->
        <div class="lg:col-span-7 lg:pl-4">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-100"
            >{about.founder.label}</span
          >
          <h2
            class="reveal font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mt-4 leading-[1.05] max-w-xl"
            style="--reveal-d:0.08s"
          >
            {about.founder.heading}
          </h2>
          <p
            class="reveal text-white text-lg sm:text-xl lg:text-2xl leading-relaxed font-medium mt-6 max-w-xl"
            style="--reveal-d:0.14s"
          >
            {about.founder.lead}
          </p>
          <div class="reveal mt-6 space-y-5 max-w-xl" style="--reveal-d:0.2s">
            {
              about.founder.paragraphs.map((para) => (
                <p class="text-stone/60 text-base sm:text-lg leading-relaxed">{para}</p>
              ))
            }
          </div>

          <!-- Values triad — integrity, grit, intelligence -->
          <dl
            class="reveal grid sm:grid-cols-3 gap-x-8 gap-y-8 mt-10 pt-8 border-t border-white/10"
            style="--reveal-d:0.28s"
          >
            {
              about.founder.values.map((v) => (
                <div>
                  <dt class="font-display font-bold text-lg lg:text-xl tracking-tight text-olive-100">
                    {v.k}
                  </dt>
                  <dd class="text-stone/55 text-sm leading-relaxed mt-2">{v.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= VISION & MISSION ======================= -->
  <section id="vision" class="bg-olive-100 py-20 lg:py-28 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-y-14 lg:gap-x-16">
        <!-- Sticky editorial intro -->
        <div class="lg:col-span-4 lg:sticky lg:top-28 self-start">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >What Drives Us</span
          >
          <h2
            class="reveal font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mt-4 leading-[1.05] text-ink"
            style="--reveal-d:0.08s"
          >
            The principles behind every home we build.
          </h2>
          <p
            class="reveal text-olive-dark/75 text-base sm:text-lg leading-relaxed mt-6 max-w-sm"
            style="--reveal-d:0.16s"
          >
            {about.principlesIntro}
          </p>
        </div>

        <!-- Stacked statements -->
        <div class="lg:col-span-8 lg:pl-6">
          {
            about.principles.map((p, i) => (
              <article
                class={`reveal ${
                  i > 0 ? "mt-12 pt-12 lg:mt-16 lg:pt-16 border-t border-olive-600/25" : ""
                }`}
                style={`--reveal-d:${(i * 0.12).toFixed(2)}s`}
              >
                <div class="flex items-baseline gap-4 sm:gap-6">
                  <span class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-olive-600 leading-none tabular-nums">
                    {p.no}
                  </span>
                  <h3 class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-ink">
                    {p.kicker}
                  </h3>
                </div>
                <p class="text-ink/75 text-lg sm:text-xl lg:text-[1.6rem] lg:leading-[1.5] leading-relaxed mt-6 lg:mt-7 max-w-2xl font-medium">
                  {p.body}
                </p>
                {p.paragraphs?.map((para) => (
                  <p class="text-ink/75 text-base sm:text-lg lg:text-xl leading-relaxed mt-6 lg:mt-7 max-w-2xl">
                    {para}
                  </p>
                ))}
                {p.points && (
                  <ul class="mt-7 lg:mt-8 space-y-4 max-w-2xl">
                    {p.points.map((point) => (
                      <li class="flex gap-3.5 sm:gap-4">
                        <span
                          class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-olive-600"
                          aria-hidden="true"
                        />
                        <span class="text-ink/75 text-base sm:text-lg lg:text-xl leading-relaxed">
                          {point}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== JOURNEY / TIMELINE ===================== -->
  <section id="journey" class="bg-stone py-20 lg:py-28 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="max-w-3xl">
        <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Our Journey</span
        >
        <h2
          class="reveal font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]" style="--reveal-d:0.1s"
        >
          Building since {brand.legacyYear}. One standard throughout.
        </h2>
        <p
          class="reveal font-display text-sm font-semibold uppercase tracking-[0.06em] text-muted mt-6 flex flex-wrap gap-x-3 gap-y-2 items-center" style="--reveal-d:0.2s"
        >
          <span>Est. {brand.legacyYear} · Nesting Tree since {brand.foundedYear}</span><span class="text-concrete">·</span>
          <span>Navi Mumbai</span><span class="text-concrete">·</span>
          <span>Delivered &amp; Ongoing</span><span class="text-concrete">·</span>
          <span>{contact.maharera}</span>
        </p>
      </div>

      <div class="mt-14 lg:mt-20 border-t border-line">
        {
          journey.map((m) => (
            <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-8 py-8 lg:py-10 border-b border-line items-baseline">
              <div class="lg:col-span-3">
                <span class="font-display font-bold text-5xl lg:text-6xl tracking-tight text-ink">
                  {m.year}
                </span>
              </div>
              <div class="lg:col-span-4">
                <h3 class="font-display font-bold text-xl lg:text-2xl tracking-tight">{m.title}</h3>
                <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-olive-600 mt-2">
                  {m.place}
                </p>
              </div>
              <p class="lg:col-span-5 text-muted text-base lg:text-lg leading-relaxed">{m.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="bg-ink text-stone">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 pt-16 pb-10 border-b border-white/10">
      <h3
        class="reveal font-display font-bold text-[3.25rem] sm:text-[6rem] lg:text-[8rem] leading-none tracking-tight"
      >
        NESTING TREE
      </h3>
    </div>

    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 py-14">
      <div class="grid sm:grid-cols-2 lg:grid-cols-[minmax(300px,1fr)_1fr_1fr_1fr] gap-12">
        <div class="reveal">
          <p class="text-stone/55 text-sm leading-relaxed sm:whitespace-nowrap">
            {brand.footerLine}
          </p>
          <SocialLinks />
        </div>

        <div class="reveal" style="--reveal-d:0.08s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Explore
          </h5>
          <ul class="space-y-3 text-sm font-medium">
            {
              footerLinks.map((item) => (
                <li>
                  <a href={item.href} class="hover:text-olive-100 transition-colors">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--reveal-d:0.16s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Projects
          </h5>
          <ul class="space-y-3 text-sm font-medium text-stone/80">
            {
              projects.map((p) => (
                <li>
                  <a
                    href={`/projects/${p.slug}`}
                    class="hover:text-olive-100 transition-colors"
                  >
                    {p.name} — {p.status}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--reveal-d:0.24s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Contact
          </h5>
          <ul class="space-y-3 text-sm font-medium text-stone/80">
            <li class="flex items-start gap-2.5">
              <svg
                class="w-4 h-4 mt-0.5 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                ><path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"></path><circle
                  cx="12"
                  cy="9"
                  r="2.2"></circle></svg
              >
              {contact.address}
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                class="w-4 h-4 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"><path d="M4 5h16v14H4z"></path><path d="m4 6 8 7 8-7"></path></svg
              >
              <a href={`mailto:${contact.email}`} class="hover:text-olive-100 transition-colors"
                >{contact.email}</a
              >
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                class="w-4 h-4 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                ><path
                  d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"
                ></path></svg
              >
              <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="hover:text-olive-100 transition-colors"
                >{contact.phone}</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div
        class="border-t border-white/10 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone/40"
      >
        <p>&copy; {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
        <p>{contact.maharera}</p>
        <div class="flex items-center gap-5">
          <a href="/privacy" class="hover:text-stone/70 transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-stone/70 transition-colors">Terms</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    // Scroll-reveal: fade/lift elements in as they enter the viewport.
    if (document.documentElement.classList.contains("reveal-on")) {
      const revealTargets = document.querySelectorAll(".reveal, .reveal-img");
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      revealTargets.forEach((el) => io.observe(el));
    }
  </script>
</BaseLayout>
