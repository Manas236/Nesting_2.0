  </section>

  <!-- ===================== STRONG CTA / ENQUIRY ===================== -->
  <!-- Deep olive, not ink: black is reserved for the footer alone, so the page
       never alternates black. The residence photograph still carries the block;
       the scrim over it is olive-dark (#3f4729) rather than ink so the section
       reads unmistakably green against the footer below it. -->
