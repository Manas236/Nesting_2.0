---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  brand,
  contact,
  nav,
  projects,
  featuredSlug,
  home,
  homeFeaturedSlugs,
} from "../data/site";

const featured = projects.find((p) => p.slug === featuredSlug)!;

// Ongoing residences for the home page teaser (full catalogue lives on /projects).
const ongoing = homeFeaturedSlugs
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter(Boolean) as typeof projects;

// Cinematic hero film. No poster on purpose: the render used to flash in as a
// bright still before the dark opening frame loaded. Now the hero's own ink
// background shows through while the film loads (and for reduced-motion
// visitors), so there's nothing to flash — dark blends straight into dark.
const heroVideo = "/images/projects/homepage_video.mp4";

const arrow = `<path d="M5 12h14M13 6l6 6-6 6"/>`;
---

<BaseLayout>
  <!-- ============================ NAVBAR ============================ -->
  <SiteHeader />

  <!-- ============================ HERO ============================ -->
  <section id="top" class="relative h-[100svh] min-h-[620px] w-full overflow-hidden bg-ink">
    <video
      id="hero-video"
      class="hero-img-reveal absolute top-0 left-0 w-full h-full object-cover object-[65%_center] sm:object-center bg-ink"
      src={heroVideo}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Nesting Tree residences in Navi Mumbai"></video>
    <!-- layered scrims: nav legibility (top), copy (bottom), headline (left) -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/60 via-ink/10 to-transparent"></div>
    <!-- olive wash: carries the brand accent into the headline corner -->
    <div
      class="absolute inset-0 bg-gradient-to-tr from-olive-dark/40 via-olive-dark/8 to-transparent"
    >
    </div>

    <div
      class="relative h-full max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col justify-end pb-16 lg:pb-24"
    >
      <div class="max-w-4xl">
        <span
          class="hero-rise font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.24em] text-olive-100 mb-5 flex items-center gap-3"
          style="--rise-d:0.45s"
        >
          <span class="h-px w-7 sm:w-9 bg-olive-100/70 block"></span>
          {home.hero.region}
        </span>
        <h1
          class="hero-rise font-display font-black text-white text-[3rem] sm:text-7xl lg:text-[6.75rem] leading-[0.92] tracking-tight"
          style="--rise-d:0.58s"
        >
          {home.hero.headline[0]}<br />{home.hero.headline[1]}
        </h1>
        <p
          class="hero-rise text-white/72 text-base sm:text-lg lg:text-xl mt-7 max-w-xl leading-relaxed"
          style="--rise-d:0.74s"
        >
          {home.hero.sub}
        </p>
        <div class="hero-rise mt-9 flex flex-wrap items-center gap-3.5" style="--rise-d:0.88s">
          <a
            href={home.hero.primaryCta.href}
            class="font-display font-bold uppercase tracking-[0.06em] text-sm bg-white text-ink px-7 py-4 rounded-[2px] hover:bg-olive-50 transition-colors"
            >{home.hero.primaryCta.label}</a
          >
          <a
            href={home.hero.secondaryCta.href}
            class="font-display font-bold uppercase tracking-[0.06em] text-sm border border-olive-100/45 text-olive-50 px-7 py-4 rounded-[2px] hover:bg-olive/30 hover:border-olive-100/75 transition-colors"
            >{home.hero.secondaryCta.label}</a
          >
        </div>
      </div>
    </div>

    <div
      class="hero-fade absolute bottom-7 right-6 lg:right-12 text-right hidden sm:block"
      style="--fade-d:1.1s"
    >
      <p class="font-display text-[11px] font-bold uppercase tracking-[0.2em] text-white/55">
        Building since {brand.legacyYear} · {contact.maharera}
      </p>
    </div>
  </section>

  <!-- ===================== INTRO (hero film → the work) ===================== -->
  <!-- One warm editorial beat straight after the hero. Deliberately
       low-information — one image set, a short statement of why we over-build,
       a lot of air, nothing to click. -->
  <section class="bg-sand overflow-hidden py-28 sm:py-36 lg:py-44">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-y-12 lg:gap-x-20 items-center">
        <!-- Few words, large. The three pictures carry the warmth. -->
        <div class="lg:col-span-5">
          <h2
            class="reveal font-display font-bold text-ink text-[1.7rem] sm:text-3xl lg:text-[2.7rem] tracking-tight leading-[1.15] max-w-md"
          >
            {home.intro.heading}
          </h2>

          <p
            class="reveal text-muted text-base sm:text-lg leading-[1.8] mt-8 lg:mt-10 max-w-md"
            style="--reveal-d:0.10s"
          >
            {home.intro.lead}
          </p>

          <div class="reveal flex items-start gap-4 mt-9 lg:mt-11" style="--reveal-d:0.22s">
            <span class="block w-10 h-px bg-olive-600/40 mt-3 shrink-0" aria-hidden="true"></span>
            <p class="font-display font-bold text-olive-600 text-base sm:text-lg tracking-tight max-w-sm">
              {home.intro.close}
            </p>
          </div>
        </div>

        <!-- Triptych: one tall anchor beside two stacked frames. Grid rows
             stretch, so the right column matches the tall image's height. -->
        <div class="lg:col-span-7">
          <div class="grid grid-cols-12 gap-3 sm:gap-4">
            <div class="col-span-7">
              <div class="reveal-img relative aspect-[4/5] overflow-hidden rounded-[3px] bg-ink h-full">
                <img
                  src={home.intro.images[0].src}
                  alt={home.intro.images[0].alt}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover"
                  style={`object-position:${home.intro.images[0].pos}`}
                />
              </div>
            </div>
            <div class="col-span-5 flex flex-col gap-3 sm:gap-4">
              {
                home.intro.images.slice(1).map((img, i) => (
                  <div
                    class="reveal-img relative flex-1 min-h-0 overflow-hidden rounded-[3px] bg-ink"
                    style={`--reveal-d:${(0.12 + i * 0.12).toFixed(2)}s`}
                  >
                    <img
                      src={img.src}
                      alt={img.alt}
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover"
                      style={`object-position:${img.pos}`}
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FLAGSHIP / FEATURED PROJECT ===================== -->
  <!-- sand → stone: both light, so the tone shift alone carries the joint. -->
  <section class="bg-stone py-28 sm:py-36 lg:py-48 overflow-hidden">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-y-12 lg:gap-x-16 items-center">
        <!-- Framed render -->
        <div class="lg:col-span-5">
          <div class="reveal-img relative aspect-[4/5] overflow-hidden rounded-[3px] bg-ink">
            <span class="tick top-5 left-5 border-t-2 border-l-2 z-10" style="border-color:rgba(255,255,255,.35)"></span>
            <span class="tick bottom-5 right-5 border-b-2 border-r-2 z-10" style="border-color:rgba(255,255,255,.35)"></span>
            <img
              src={home.featured.image}
              alt={`${featured.name} — flagship residence by Nesting Tree`}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
              style={`object-position: ${home.featured.imagePos};`}
            />
          </div>
        </div>

        <!-- Editorial column -->
        <div class="lg:col-span-7 lg:pl-6">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >{home.featured.eyebrow}</span
          >
          <h2
            class="reveal font-display font-black text-4xl sm:text-5xl lg:text-[3.75rem] tracking-tight mt-4 leading-[1.02] max-w-xl"
            style="--reveal-d:0.08s"
          >
            {home.featured.heading}
          </h2>
          <p
            class="reveal text-ink text-lg sm:text-xl leading-relaxed font-medium mt-6 max-w-xl"
            style="--reveal-d:0.16s"
          >
            {home.featured.lead}
          </p>
          <p class="reveal text-muted text-base sm:text-lg leading-relaxed mt-5 max-w-xl" style="--reveal-d:0.22s">
            {home.featured.body}
          </p>

          <!-- spec chips -->
          <div class="reveal flex flex-wrap gap-2.5 mt-7" style="--reveal-d:0.28s">
            {
              home.featured.chips.map((chip) => (
                <span class="font-display text-[11px] font-bold uppercase tracking-[0.12em] text-olive-dark bg-olive-50 border border-olive-100 px-3.5 py-2 rounded-[2px]">
                  {chip}
                </span>
              ))
            }
          </div>

          <!-- woven trust callout -->
          <div class="reveal mt-8 border-l-2 border-olive pl-5 max-w-lg" style="--reveal-d:0.34s">
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-olive-600"
              >{home.featured.trust.k}</span
            >
            <p class="text-muted text-base leading-relaxed mt-2">{home.featured.trust.v}</p>
          </div>

          <a
            href={home.featured.cta.href}
            class="reveal group inline-flex items-center gap-2.5 font-display font-bold uppercase tracking-[0.06em] text-sm bg-ink text-stone px-7 py-4 rounded-[2px] hover:bg-inksoft transition-colors mt-9"
            style="--reveal-d:0.4s"
          >
            {home.featured.cta.label}
            <svg
              class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={arrow}
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FEATURED PROJECTS (teaser) ===================== -->
  <!-- stone → sand: both light, so the tone shift alone carries the joint. -->
  <section class="bg-sand py-28 sm:py-36 lg:py-48">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 lg:mb-16">
        <div class="max-w-2xl">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >{home.featuredProjects.eyebrow}</span
          >
          <h2
            class="reveal font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.03]"
            style="--reveal-d:0.1s"
          >
            {home.featuredProjects.heading}
          </h2>
          <p class="reveal text-muted text-base sm:text-lg max-w-md leading-relaxed mt-5" style="--reveal-d:0.18s">
            {home.featuredProjects.lead}
          </p>
        </div>
        <a
          href={home.featuredProjects.cta.href}
          class="reveal group inline-flex items-center gap-2.5 font-display font-bold uppercase tracking-[0.06em] text-sm border border-ink/25 text-ink px-6 py-3.5 rounded-[2px] hover:bg-ink hover:text-stone transition-colors shrink-0"
          style="--reveal-d:0.24s"
        >
          {home.featuredProjects.cta.label}
          <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={arrow}
          />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 lg:gap-5">
        {
          ongoing.map((p, i) => (
            <a
              href={`/projects/${p.slug}`}
              class="reveal group relative overflow-hidden rounded-[3px] bg-ink h-[88vw] sm:h-[420px] lg:h-[520px]"
              style={`--reveal-d:${(i * 0.1).toFixed(2)}s`}
            >
              <img
                src={p.image}
                alt={`${p.name} — ${p.location}`}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.05]"
                style={`object-position: ${p.objectPosition};`}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/25 to-ink/5" />
              <span
                class={`absolute top-4 left-4 font-display text-[10px] font-bold uppercase tracking-[0.14em] px-2.5 py-1 rounded-[2px] ${
                  p.status === "Ongoing" ? "bg-olive text-white" : "bg-stone/90 text-ink"
                }`}
              >
                {p.statusLabel}
              </span>
              <div class="absolute inset-x-0 bottom-0 p-5 lg:p-7">
                <h3 class="font-display font-black text-2xl lg:text-3xl text-white tracking-tight">
                  {p.name}
                </h3>
                <p class="text-white/65 text-sm mt-1">{p.location}</p>
                <p class="text-white/70 text-sm leading-relaxed mt-3 max-w-sm max-h-0 opacity-0 overflow-hidden transition-all duration-500 ease-out group-hover:max-h-40 group-hover:opacity-100">
                  {p.blurb}
                </p>
                <span class="inline-flex items-center gap-2 font-display text-[11px] font-bold uppercase tracking-[0.16em] text-olive-100 mt-4">
                  View Project
                  <svg
                    class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={arrow}
                  />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== PROOF (milestones + the difference) ===================== -->
  <!-- One stone band that carries the whole argument: the claim, the numbers
       behind it, then the three pillars. (Merged from the old separate
       Milestones and Difference sections, which were two ink blocks either
       side of a stone one and made the page strobe.) The numbers ride a native
       scroll-snap marquee — no jQuery/owl; arrows, drag, swipe and wheel all
       work. Only real figures live here; see home.milestones in
       src/data/site.ts. -->
  <section class="relative bg-stone text-ink py-28 sm:py-36 lg:py-44 overflow-hidden">
    <!-- oversized editorial watermark -->
    <span
      class="text-hollow pointer-events-none select-none absolute top-20 lg:top-24 left-0 right-0 text-center font-display font-black text-ink/[0.05] leading-none text-[26vw] lg:text-[20rem] tracking-tighter"
      aria-hidden="true">MORE</span
    >

    <div class="relative max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="max-w-3xl">
        <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >{home.difference.eyebrow}</span
        >
        <h2
          class="reveal font-display font-black text-4xl sm:text-6xl lg:text-[5rem] tracking-tight mt-5 leading-[0.98]"
          style="--reveal-d:0.1s"
        >
          {home.difference.heading[0]}<br />
          <span>{home.difference.heading[1]}</span><br />
          {home.difference.heading[2]}
        </h2>
        <p class="reveal text-muted text-base sm:text-lg mt-7 max-w-lg leading-relaxed" style="--reveal-d:0.2s">
          {home.difference.lead}
        </p>
      </div>

      <!-- The numbers, as the evidence rail under the claim. -->
      <div
        class="reveal flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3 lg:gap-10 mt-16 lg:mt-20 pb-7 border-b border-ink/10"
        style="--reveal-d:0.12s"
      >
        <div>
          <span class="font-display text-[11px] font-bold uppercase tracking-[0.22em] text-olive-600"
            >{home.milestones.eyebrow}</span
          >
          <h3 class="font-display font-bold text-xl lg:text-2xl tracking-tight mt-2">
            {home.milestones.heading}
          </h3>
        </div>
        <p class="text-muted text-sm sm:text-base leading-relaxed max-w-md lg:text-right">
          {home.milestones.lead}
        </p>
      </div>

      <!-- Track: an auto-scrolling marquee that's also a draggable/swipeable
           scroll container (see the miles-marquee script). Cards are rendered
           twice so scrollLeft wraps seamlessly at one set's width; per-card
           right-margin (not flex gap) keeps each set a clean tile. Fades in as
           one group (marquee motion defeats per-card reveal). -->
      <div class="reveal miles-marquee mt-8 lg:mt-10" style="--reveal-d:0.18s">
        <ul id="miles-track" class="miles-track flex w-max" aria-label="Milestones">
          {
            [...home.milestones.items, ...home.milestones.items].map((m, i) => (
              <li
                class="shrink-0 w-[240px] sm:w-[280px] lg:w-[300px] mr-3 lg:mr-4"
                aria-hidden={i >= home.milestones.items.length ? "true" : undefined}
              >
                <div class="h-full flex flex-col bg-sand/70 border border-ink/10 rounded-[3px] p-8 lg:p-10">
                  <span class="font-display font-black text-5xl lg:text-6xl text-ink leading-none tabular-nums">
                    {m.value}
                  </span>
                  <span class="block w-9 h-px bg-olive-600/50 mt-5 mb-6" aria-hidden="true" />
                  <span class="font-display font-bold text-lg tracking-tight text-ink">{m.label}</span>
                  <span class="font-display text-[11px] font-semibold uppercase tracking-[0.12em] text-muted mt-2 leading-relaxed block">
                    {m.sub}
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- …and what those numbers buy the resident. -->
      <div class="grid md:grid-cols-3 gap-px bg-ink/10 mt-14 lg:mt-20 border border-ink/10">
        {
          home.difference.pillars.map((p, i) => (
            <div class="reveal bg-sand p-8 sm:p-10 lg:p-12" style={`--reveal-d:${(i * 0.1).toFixed(2)}s`}>
              <span class="font-display font-black text-5xl lg:text-6xl text-olive/55 leading-none tabular-nums">
                {p.no}
              </span>
              <h3 class="font-display font-bold text-xl lg:text-2xl tracking-tight mt-6">{p.title}</h3>
              <p class="text-muted text-base leading-relaxed mt-3">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ===================== TESTIMONIALS ===================== -->
  <!-- stone → sand again: the last light beat before the olive enquiry block.
       Every voice is equal — one carousel of identical stone cards, no lead/hero
       card. Native scroll-snap rail: swipe/trackpad on touch, arrow buttons and
       dots for pointer, keyboard-operable. Cards share height (align-items:
       stretch) so uneven quote lengths still line up. Content in
       home.testimonials. -->
  <section class="bg-sand py-28 sm:py-36 lg:py-44 overflow-hidden">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-12 lg:mb-14">
        <div class="max-w-2xl">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >{home.testimonials.eyebrow}</span
          >
          <h2
            class="reveal font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.03]"
            style="--reveal-d:0.1s"
          >
            {home.testimonials.heading}
          </h2>
          <p class="reveal text-muted text-base sm:text-lg leading-relaxed mt-5 max-w-lg" style="--reveal-d:0.18s">
            {home.testimonials.lead}
          </p>
        </div>

        <!-- Prev / next. Hidden from AT (the rail itself is focusable and
             swipeable); purely a pointer affordance. -->
        <div class="reveal flex items-center gap-2.5 shrink-0" style="--reveal-d:0.24s" aria-hidden="true">
          <button
            type="button"
            data-tdir="-1"
            class="t-arrow group w-12 h-12 rounded-full border border-ink/25 text-ink flex items-center justify-center hover:bg-ink hover:text-stone hover:border-ink transition-colors disabled:opacity-30 disabled:pointer-events-none"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          </button>
          <button
            type="button"
            data-tdir="1"
            class="t-arrow group w-12 h-12 rounded-full border border-ink/25 text-ink flex items-center justify-center hover:bg-ink hover:text-stone hover:border-ink transition-colors disabled:opacity-30 disabled:pointer-events-none"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
          </button>
        </div>
      </div>

      <!-- Rail. Focusable so keyboard users can arrow-scroll it; each card snaps
           to the left edge. -->
      <div
        class="t-rail reveal"
        id="t-rail"
        tabindex="0"
        role="group"
        aria-roledescription="carousel"
        aria-label="Resident testimonials"
        style="--reveal-d:0.14s"
      >
        <ul class="t-track flex w-max gap-4 lg:gap-5">
          {
            home.testimonials.items.map((t, i) => (
              <li class="t-card shrink-0">
                <figure class="relative flex flex-col h-full bg-stone border border-ink/10 rounded-[3px] p-8 lg:p-10">
                  <span class="font-display font-black text-6xl text-olive/35 leading-[0.6]" aria-hidden="true">
                    &ldquo;
                  </span>
                  <blockquote class="text-ink/90 text-base lg:text-lg leading-[1.8] mt-4 flex-1">
                    {t.quote}
                  </blockquote>
                  <figcaption class="flex items-center gap-4 mt-8 pt-6 border-t border-ink/10">
                    <span class="w-12 h-12 shrink-0 rounded-full overflow-hidden bg-olive-50 border border-olive-100">
                      <img
                        src={t.photo}
                        alt={t.name}
                        loading="lazy"
                        class="w-full h-full object-cover"
                        style={`object-position:${t.pos}`}
                      />
                    </span>
                    <span>
                      <span class="block font-display font-bold text-ink tracking-tight">{t.name}</span>
                      <span class="block font-display text-[11px] font-semibold uppercase tracking-[0.12em] text-muted mt-1">
                        {t.detail}
                      </span>
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Progress dots — one per card, click to jump. -->
      <div class="reveal flex items-center gap-2.5 mt-8" style="--reveal-d:0.2s" aria-hidden="true">
        {
          home.testimonials.items.map((_, i) => (
