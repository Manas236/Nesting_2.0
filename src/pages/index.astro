    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/80 to-ink/45">
    </div>

    <div
      class="relative max-w-3xl mx-auto px-5 sm:px-6 py-28 sm:py-36 lg:py-44 flex flex-col items-center text-center"
    >
      <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-100"
        >{home.cta.eyebrow}</span
      >
      <h2
        class="reveal font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight text-white leading-[1.05] mt-4"
        style="--reveal-d:0.1s"
      >
        {home.cta.heading}
      </h2>
      <p class="reveal text-white/72 mt-6 text-base sm:text-lg max-w-lg leading-relaxed" style="--reveal-d:0.2s">
        {home.cta.body}
      </p>
      <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-3.5" style="--reveal-d:0.3s">
        <a
          href={`tel:${contact.phone.replace(/\s/g, "")}`}
          class="font-display font-bold uppercase tracking-[0.06em] text-sm bg-white text-ink px-7 py-4 rounded-[2px] hover:bg-stone transition-colors"
          >Schedule a Site Visit</a
        >
        <a
          href={`mailto:${contact.email}`}
          class="font-display font-bold uppercase tracking-[0.06em] text-sm border border-white/40 text-white px-7 py-4 rounded-[2px] hover:bg-white/10 transition-colors"
          >Email Us</a
        >
      </div>
      <p class="reveal font-display text-sm font-semibold text-olive-100 mt-8 tracking-wide" style="--reveal-d:0.38s">
        <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="hover:text-white transition-colors">{contact.phone}</a>
        &nbsp;·&nbsp;
        <a href={`mailto:${contact.email}`} class="hover:text-white transition-colors">{contact.email}</a>
      </p>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <!-- The only black block on the page. No rule or gap at the top: the enquiry
       section's olive gradient darkens as it descends and flows straight into
       the ink here. -->
  <footer class="bg-ink text-stone">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 pt-16 pb-10 border-b border-white/10">
      <h3
        class="reveal font-display font-black text-[3.25rem] sm:text-[6rem] lg:text-[8rem] leading-none tracking-tight"
      >
        NESTING TREE
      </h3>
    </div>

    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 py-14">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-12">
        <div class="reveal">
          <p class="text-stone/55 text-sm leading-relaxed max-w-[240px]">
            Residential developer in Navi Mumbai, building homes with more amenities
            since {brand.legacyYear}.
          </p>
          <div class="flex items-center gap-3 mt-6">
            {
              contact.socials.map((s) => (
                <a
                  href={s.href}
                  class="w-9 h-9 rounded-[2px] bg-white/5 border border-white/10 flex items-center justify-center text-xs font-display font-bold hover:bg-white/10 transition-colors"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="reveal" style="--reveal-d:0.08s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Explore
          </h5>
          <ul class="space-y-3 text-sm font-medium">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="hover:text-olive-100 transition-colors">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--reveal-d:0.16s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Projects
          </h5>
          <ul class="space-y-3 text-sm font-medium text-stone/80">
            {
              projects.map((p) => (
                <li>
                  <a
                    href={`/projects/${p.slug}`}
                    class="hover:text-olive-100 transition-colors"
                  >
                    {p.name} — {p.status}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--reveal-d:0.24s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Contact
          </h5>
          <ul class="space-y-3 text-sm font-medium text-stone/80">
            <li class="flex items-start gap-2.5">
              <svg
                class="w-4 h-4 mt-0.5 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                ><path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"></path><circle
                  cx="12"
                  cy="9"
                  r="2.2"></circle></svg
              >
              {contact.address}
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                class="w-4 h-4 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"><path d="M4 5h16v14H4z"></path><path d="m4 6 8 7 8-7"></path></svg
              >
              <a href={`mailto:${contact.email}`} class="hover:text-olive-100 transition-colors"
                >{contact.email}</a
              >
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                class="w-4 h-4 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                ><path
                  d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"
                ></path></svg
              >
              <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="hover:text-olive-100 transition-colors"
                >{contact.phone}</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div
        class="border-t border-white/10 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone/40"
      >
        <p>&copy; {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
        <p>{contact.maharera}</p>
        <div class="flex items-center gap-5">
          <a href="/privacy" class="hover:text-stone/70 transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-stone/70 transition-colors">Terms</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    // Header scroll/menu behaviour lives in SiteHeader.astro.
    // Hero film holds on its poster frame for reduced-motion visitors.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const heroVideo = document.getElementById("hero-video");
      if (heroVideo) {
        heroVideo.removeAttribute("autoplay");
        heroVideo.pause();
      }
    }

    // Scroll-reveal: fade/lift elements in as they enter the viewport.
    // Only wired up when the head guard enabled reveal-on (JS + motion OK).
    if (document.documentElement.classList.contains("reveal-on")) {
      const revealTargets = document.querySelectorAll(".reveal, .reveal-img");
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target); // reveal once, then stop watching
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      revealTargets.forEach((el) => io.observe(el));
    }

    // Milestones marquee: auto-scrolls, but is also a real scroll container so
    // the visitor can drag, swipe, or wheel through it. Cards are duplicated,
    // so we loop by wrapping scrollLeft at one set's width. Auto-motion pauses
    // while the pointer is over the strip (or dragging) and resumes on leave.
    {
      const wrap = document.querySelector(".miles-marquee");
      const track = document.getElementById("miles-track");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (wrap && track) {
        const SPEED = 42; // px per second
        const half = () => track.scrollWidth / 2; // width of one card set
        const wrapScroll = () => {
          const h = half();
          if (wrap.scrollLeft >= h) wrap.scrollLeft -= h;
          else if (wrap.scrollLeft < 0) wrap.scrollLeft += h;
        };

        let paused = false;
        let dragging = false;

        // Auto-scroll loop (skipped entirely when the visitor prefers no motion).
        if (!reduce) {
          let last = null;
          const tick = (t) => {
            if (last == null) last = t;
            const dt = (t - last) / 1000;
            last = t;
            if (!paused && !dragging) {
              wrap.scrollLeft += SPEED * dt;
              wrapScroll();
            }
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);

          wrap.addEventListener("pointerenter", () => (paused = true));
          wrap.addEventListener("pointerleave", () => {
            if (!dragging) paused = false;
          });
        }

        // Keep manual scrolling (wheel / trackpad / swipe) inside the loop.
        wrap.addEventListener("scroll", wrapScroll, { passive: true });

        // Click-and-drag to scroll with a mouse.
        let startX = 0;
        let startScroll = 0;
        wrap.addEventListener("pointerdown", (e) => {
          dragging = true;
          startX = e.clientX;
          startScroll = wrap.scrollLeft;
          wrap.classList.add("is-dragging");
          wrap.setPointerCapture(e.pointerId);
        });
        wrap.addEventListener("pointermove", (e) => {
          if (!dragging) return;
          wrap.scrollLeft = startScroll - (e.clientX - startX);
        });
        const endDrag = (e) => {
          if (!dragging) return;
          dragging = false;
          wrap.classList.remove("is-dragging");
          wrap.releasePointerCapture?.(e.pointerId);
          paused = wrap.matches(":hover"); // resume only if the pointer left
        };
        wrap.addEventListener("pointerup", endDrag);
        wrap.addEventListener("pointercancel", endDrag);
      }
    }

    // Testimonials carousel. The rail is a native scroll-snap container, so
    // swipe/trackpad/keyboard already work with zero JS. This only layers on the
    // pointer conveniences: arrow buttons, click-to-jump dots, mouse drag, and
    // keeping the active dot in sync with wherever the visitor has scrolled.
    {
      const rail = document.getElementById("t-rail");
      const track = rail?.querySelector(".t-track");
      if (rail && track) {
        const cards = [...track.children];
        const arrows = [...document.querySelectorAll(".t-arrow")];
        const dots = [...document.querySelectorAll(".t-dot")];

        // Left edge of card i, relative to the rail's own scroll origin.
        const cardLeft = (i) => cards[i].offsetLeft - track.offsetLeft;

        // Which card is nearest the current left edge.
        const activeIndex = () => {
          const x = rail.scrollLeft;
          let best = 0;
          let dist = Infinity;
          cards.forEach((_, i) => {
            const d = Math.abs(cardLeft(i) - x);
            if (d < dist) { dist = d; best = i; }
          });
          return best;
        };

        const goTo = (i) => {
          const max = cards.length - 1;
          const clamped = Math.max(0, Math.min(max, i));
          rail.scrollTo({ left: cardLeft(clamped) });
        };

        // Reflect scroll position in the dots and arrow disabled states. The
        // last "page" starts once the rail is scrolled as far right as it goes,
        // so the final dot lights up even though card N never reaches the edge.
        const sync = () => {
          const atStart = rail.scrollLeft <= 2;
          const atEnd = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 2;
          const active = atEnd ? dots.length - 1 : activeIndex();
          dots.forEach((d, i) => d.classList.toggle("is-active", i === active));
          arrows.forEach((a) => {
            const dir = Number(a.dataset.tdir);
            a.disabled = (dir < 0 && atStart) || (dir > 0 && atEnd);
          });
        };

        arrows.forEach((a) =>
          a.addEventListener("click", () => goTo(activeIndex() + Number(a.dataset.tdir)))
        );
        dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
        rail.addEventListener("scroll", sync, { passive: true });
        window.addEventListener("resize", sync);

        // Click-and-drag to scroll with a mouse (touch/trackpad scroll natively).
        let dragging = false;
        let startX = 0;
        let startScroll = 0;
        let moved = false;
        rail.addEventListener("pointerdown", (e) => {
          if (e.pointerType === "touch") return; // let native touch scrolling run
          dragging = true;
          moved = false;
          startX = e.clientX;
          startScroll = rail.scrollLeft;
          rail.classList.add("is-dragging");
          rail.setPointerCapture(e.pointerId);
        });
        rail.addEventListener("pointermove", (e) => {
          if (!dragging) return;
          const dx = e.clientX - startX;
          if (Math.abs(dx) > 3) moved = true;
          rail.scrollLeft = startScroll - dx;
        });
        const endDrag = (e) => {
          if (!dragging) return;
          dragging = false;
          rail.classList.remove("is-dragging");
          rail.releasePointerCapture?.(e.pointerId);
          if (moved) goTo(activeIndex()); // settle onto the nearest snap point
        };
        rail.addEventListener("pointerup", endDrag);
        rail.addEventListener("pointercancel", endDrag);
        // Swallow the click that follows a drag so it doesn't select text/links.
        rail.addEventListener("click", (e) => { if (moved) e.preventDefault(); }, true);

        sync();
      }
    }
  </script>

  <style>
    /* Milestones marquee: a real horizontal scroll container that JS also
       auto-advances. Cards are duplicated so scrollLeft wraps seamlessly at one
       set's width. Scrollbar hidden; drag/swipe/wheel all work. */
    .miles-marquee {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none; /* Firefox */
      cursor: grab;
      touch-action: pan-x; /* let vertical page scroll pass through on touch */
    }
    .miles-marquee::-webkit-scrollbar {
      display: none; /* WebKit */
    }
    .miles-marquee.is-dragging {
      cursor: grabbing;
      user-select: none;
      scroll-behavior: auto;
    }

    /* Testimonials carousel: a scroll-snap rail. Cards share height, snap to the
       left edge, and the rail is drag/swipe/wheel/keyboard scrollable. Arrows and
       dots (progressive enhancement) drive it via scrollTo in the script. */
    .t-rail {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none; /* Firefox */
      cursor: grab;
      -webkit-overflow-scrolling: touch;
    }
    .t-rail::-webkit-scrollbar {
      display: none; /* WebKit */
    }
    .t-rail:focus-visible {
      outline: 2px solid var(--color-olive);
      outline-offset: 4px;
    }
    .t-rail.is-dragging {
      cursor: grabbing;
      user-select: none;
      scroll-behavior: auto;
    }
    .t-card {
      scroll-snap-align: start;
      width: 86vw;
      max-width: 34rem;
    }
    @media (min-width: 640px) {
      .t-card { width: 48%; }
    }
    @media (min-width: 1024px) {
      .t-card { width: calc((100% - 2 * 1.25rem) / 3); } /* 3 up, matches gap-5 */
    }
    .t-dot {
      width: 0.5rem;
    }
    .t-dot.is-active {
      width: 1.5rem;
      background: var(--color-olive);
    }
    @media (prefers-reduced-motion: reduce) {
      .t-rail { scroll-behavior: auto; }
    }
  </style>
</BaseLayout>
