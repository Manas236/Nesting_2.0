---
/* ============================================================
   Privacy Policy
   ------------------------------------------------------------
   Covers the enquiry form on every page (src/pages/api/contact.ts),
   which writes name / phone / email / project / message / source
   page into the `leads` table. Written against India's Digital
   Personal Data Protection Act, 2023.

   IMPORTANT: this was drafted to be accurate to what the site
   actually does — it is not legal advice and has not been
   reviewed by a lawyer. Have it checked before relying on it.
   Two placeholders need filling before or shortly after launch:
   the grievance officer's name and the registered office address.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { brand, contact } from "../data/site";

const lastUpdated = "28 July 2026";
---

<BaseLayout
  title="Privacy Policy — Nesting Tree"
  description="How Nesting Tree collects, uses and protects the personal information you share through our enquiry forms."
>
  <SiteHeader />

  <main class="bg-stone">
    <!-- ===== Header ===== -->
    <section class="bg-ink text-stone pt-36 pb-16 lg:pt-44 lg:pb-20">
      <div class="max-w-[900px] mx-auto px-5 sm:px-6 lg:px-12">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-100"
          >Legal</span
        >
        <h1
          class="font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05] text-white"
        >
          Privacy Policy
        </h1>
        <p class="text-stone/60 text-sm mt-6">Last updated {lastUpdated}</p>
      </div>
    </section>

    <!-- ===== Body ===== -->
    <section class="py-16 lg:py-24">
      <div class="max-w-[900px] mx-auto px-5 sm:px-6 lg:px-12 legal">
        <p class="lead">
          {brand.name} respects your privacy. This policy explains what personal information we
          collect when you use this website, why we collect it, and what rights you have over it. It
          applies to <strong>nestingtree.in</strong> and the enquiry forms on it.
        </p>

        <h2>1. Who we are</h2>
        <p>
          {brand.name} is a residential developer operating in {brand.region}. For anything relating
          to this policy or to your personal information, contact us at{" "}
          <a href={`mailto:${contact.email}`}>{contact.email}</a> or{" "}
          <a href={`tel:${contact.phone.replace(/\s/g, "")}`}>{contact.phone}</a>.
        </p>

        <h2>2. What we collect</h2>
        <p>
          We only collect what you type into an enquiry form. When you submit one, we record:
        </p>
        <ul>
          <li><strong>Your name</strong> — required, so we know who we are speaking to.</li>
          <li><strong>Your phone number</strong> — required, and how we usually respond.</li>
          <li><strong>Your email address</strong> — optional.</li>
          <li><strong>The project you enquired about</strong> — optional.</li>
          <li><strong>Your message</strong> — optional, and only what you choose to write.</li>
          <li>
            <strong>The page you enquired from</strong> — recorded automatically so we know which
            residence prompted your enquiry.
          </li>
        </ul>
        <p>
          We do not run advertising or analytics trackers on this site, and we do not use cookies to
          profile you. This site loads its typefaces from Google Fonts, which means your browser
          makes a request to Google's servers and Google receives your IP address as part of that
          request.
        </p>

        <h2>3. Why we use it</h2>
        <p>
          To respond to your enquiry, share availability, pricing and project details, arrange a site
          visit, and follow up about the residence you asked about. That is the whole purpose. We
          process this information on the basis of the consent you give when you submit the form.
        </p>

        <h2>4. What we never do</h2>
        <ul>
          <li>We do not sell your personal information.</li>
          <li>We do not rent, trade or share your details with other developers or brokers.</li>
          <li>We do not use your information for any purpose you did not contact us about.</li>
        </ul>
        <p>
          We share your details only with our own sales team, and with service providers who host our
          website and database and act on our instructions.
        </p>

        <h2>5. How long we keep it</h2>
        <p>
          We keep enquiry records for as long as needed to deal with your enquiry and any resulting
          purchase, and thereafter only for as long as the law requires us to. If you ask us to
          delete your details and we are not legally required to keep them, we will.
        </p>

        <h2>6. Security</h2>
        <p>
          Enquiries are stored in an access-controlled database and we take reasonable technical and
          organisational measures to protect them. No method of transmission or storage is completely
          secure, and we cannot guarantee absolute security.
        </p>

        <h2>7. Your rights</h2>
        <p>
          Under the Digital Personal Data Protection Act, 2023, you may ask us to give you a summary
          of the personal data we hold about you, correct or complete anything inaccurate, erase your
          data where we are not required to retain it, withdraw your consent at any time, or nominate
          someone to exercise these rights on your behalf. To do any of these, write to{" "}
          <a href={`mailto:${contact.email}`}>{contact.email}</a>. We will respond within a reasonable
          period.
        </p>

        <h2>8. Grievances</h2>
        <p>
          If you are unhappy with how we have handled your personal information, contact our
          Grievance Officer at <a href={`mailto:${contact.email}`}>{contact.email}</a>, marking your
          message "Grievance — Privacy". If your concern is not resolved, you may escalate it to the
          Data Protection Board of India.
        </p>

        <h2>9. Children</h2>
        <p>
          This site is intended for adults enquiring about buying a home. We do not knowingly collect
          personal information from children.
        </p>

        <h2>10. Changes to this policy</h2>
        <p>
          We may update this policy from time to time. The date at the top of this page shows when it
          was last changed.
        </p>

        <h2>11. Contact</h2>
        <p>
          {brand.name}<br />
          {contact.address}<br />
          <a href={`mailto:${contact.email}`}>{contact.email}</a> ·{" "}
          <a href={`tel:${contact.phone.replace(/\s/g, "")}`}>{contact.phone}</a>
        </p>
      </div>
    </section>

    <!-- ===== Footer bar ===== -->
    <footer class="bg-ink text-stone">
      <div class="max-w-[900px] mx-auto px-5 sm:px-6 lg:px-12 py-8">
        <div
          class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone/40"
        >
          <p>&copy; {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
          <div class="flex items-center gap-5">
            <a href="/" class="hover:text-stone/70 transition-colors">Home</a>
            <a href="/terms" class="hover:text-stone/70 transition-colors">Terms</a>
          </div>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .legal :global(.lead) {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink, #1c1c1a);
  }
  .legal :global(h2) {
    font-family: Archivo, system-ui, sans-serif;
    font-weight: 900;
    letter-spacing: -0.01em;
    font-size: 1.35rem;
    margin-top: 2.75rem;
    margin-bottom: 0.85rem;
  }
  .legal :global(p),
  .legal :global(li) {
    line-height: 1.75;
    color: #55554f;
  }
  .legal :global(p) {
    margin-bottom: 1rem;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.35rem;
    margin-bottom: 1rem;
  }
  .legal :global(li) {
    margin-bottom: 0.45rem;
  }
  .legal :global(strong) {
    color: #1c1c1a;
    font-weight: 600;
  }
  .legal :global(a) {
    color: #5c6b3c;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal :global(a:hover) {
    color: #3f4a29;
  }
</style>
