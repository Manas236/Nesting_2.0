    }

    /* --- LIVE: JS on + motion OK → pin + two columns + spotlight --- */
    .dsky.is-live .dsky-inner {
      display: grid;
      grid-template-columns: minmax(0, 55%) minmax(0, 45%);
    }
    .dsky.is-live .dsky-left {
      display: block;
    }
    .dsky.is-live .dsky-canvas {
      /* --header-h matches the fixed header (lg:h-20 = 5rem). Padding the pinned
         pane by it drops the whole square below the nav — the composite clears
         the header instead of tucking under it. At ≥667px tall the square keeps
         its size (88vh still fits the reduced height); it only shrinks on very
         short viewports, where clipping would otherwise look worse. */
      --header-h: 5rem;
      position: sticky;
      top: 0;
      height: 100vh;
      padding-top: var(--header-h);
    }
    .dsky.is-live .dsky-stages {
      max-width: none;
      margin: 0;
      padding: 0;
    }
    .dsky.is-live .dstage {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 2.5rem 0 3.75rem;
      border-bottom: 0;
      opacity: 0.22;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dsky.is-live .dstage.is-active {
      opacity: 1;
      transform: none;
    }
    .dsky.is-live .dstage-icon {
      transition: transform 0.4s;
    }
    .dsky.is-live .dstage.is-active .dstage-icon {
      transform: scale(1.06);
    }

    @media (prefers-reduced-motion: reduce) {
      .dmark-dot,
      .dmark-num,
      .dstage,
      .dstage-icon,
      .dstage-cta {
        transition: none;
      }
