    {/* lg+ — the pinned star-trail: you stay still, the sky wheels around the
        building. Scroll rotates the arc field and walks the olive arc; the
        building never moves. Enabled only when JS adds `.is-live`
        (reduced motion / no-JS fall back to the vertical panel list below). */}
    <div class="hidden lg:block dsky" data-dsky>
      <div class="dsky-inner">
        {/* LEFT 55% — the sky (decorative, aria-hidden) */}
        <div class="dsky-left">
          <div class="dsky-canvas">
            {/* right-edge fade into cream — sits BEHIND the composite so it
                only softens the sky margins into the copy panel; it never
                washes the building or the ring (which read crisp on top). */}
            <span class="dsky-fade" aria-hidden="true"></span>

            {/* The composite and the ring share ONE pixel space: the stage box
                carries the composite's exact aspect (1080×1080) and the SVG
                viewBox matches it, so every ring coordinate is expressed in
                composite pixels. The ring therefore stays concentric with the
                BUILDING at any width, with no JS. All four ring numbers live
                as the CSS custom properties below — nudge them there, or use
                the `?ring=debug` overlay to re-tune on a real screen. */}
            <div
              class="dsky-stage"
              data-dsky-stage
              style="--ring-cx:547; --ring-cy:560; --ring-r:458; --ring-span:125; --b-left:179; --b-right:931; --b-top:374; --b-bottom:1038;"
            >
              {/* dark sky fill under the photo — matches its corner sky so the
                  feathered edges have nothing lighter to reveal */}
              <span class="dsky-skyfill" aria-hidden="true"></span>
              <img
                class="dsky-building"
                src="/images/Project_Images/Dhruva/Render/dhruva-startrail-square.png"
                alt=""
              />

              {/* Rotating star-trail layer — the streak render with its navy
                  backdrop knocked out to transparency (…-alpha.png), so it
                  overlays the sky with NO tint and its turning corners never
                  seam. The wrapper carries the FIXED roofline fade so streaks
                  stop above the building; only the inner <img> rotates, spun
                  around the pole by scroll. Lives only when `.is-live` (the
                  pinned desktop pane). */}
              <span class="dsky-trailwrap" aria-hidden="true">
                <img
                  class="dsky-trail"
                  data-dsky-trail
                  src="/images/Project_Images/Dhruva/Render/star-trail-animation-alpha.png"
                  alt=""
                  loading="lazy"
                />
              </span>

              <svg
                class="dsky-ring"
                viewBox="0 0 1080 1080"
                fill="none"
                aria-hidden="true"
                data-dsky-ring
              >
                <defs>
                  {/* Both open ends sit low, so a single vertical gradient
                      dissolves them into the tree line while the apex + sides
                      stay solid. y1/y2 (apex→end) are set by the client script
                      so the fade tracks the live ring numbers. */}
                  <linearGradient
                    id="dsky-ends"
                    data-dsky-grad
                    gradientUnits="userSpaceOnUse"
                    x1="0"
                    y1="102"
                    x2="0"
                    y2="823"
                  >
                    <stop offset="0" stop-opacity="1"></stop>
                    <stop offset="0.82" stop-opacity="1"></stop>
                    <stop offset="1" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
                {/* paths (d) are built by the client script from the CSS vars */}
                <path class="dsky-track-bloom" data-dsky-bloom></path>
                <path class="dsky-track" data-dsky-track></path>
                <path
                  class="dsky-progress"
                  data-dsky-progress
                  pathLength="1"
                  stroke-dasharray="1"
                  stroke-dashoffset="1"
                ></path>
                <g class="dsky-debug" data-dsky-debug></g>
              </svg>

              {/* waypoint markers — real buttons, placed on the ring by JS in
                  the stage's own pixel space (percent of the square box == the
                  composite pixel ÷ viewBox), painted above the ring. */}
              {skyWaypoints.map((w, i) => (
                <button class="dmark" data-dmark={i} type="button" aria-label={`Go to ${w.label}`}>
                  <span class="dmark-num">{w.index}</span>
                  <span class="dmark-dot"></span>
                </button>
              ))}
            </div>

            {/* right-edge dissolve into the cream copy column beside it —
                the Shikhar look. Canvas-level (full pane height) so it fades
                the whole right edge into the page whether the square fills the
                column or centres with a dark margin; sits above the composite
                so the star-trail + ring melt into the text column on the right.
                Tunable via the --rightfade-start / --rightfade-end knobs. */}
            <span class="dsky-rightfade" aria-hidden="true"></span>
          </div>
        </div>

        {/* RIGHT 45% — one panel per waypoint; the centred one is active */}
        <ol class="dsky-stages">
          {skyWaypoints.map((w, i) => (
            <li class="dstage" data-index={i}>
              <div class="dstage-body">
                <div class="dstage-meta">
                  <span class="dstage-index">{w.index}</span>
                  <span class="dstage-label">{w.label}</span>
                  {w.badge && <span class="dstage-badge">{w.badge}</span>}
                </div>
                <span class="dstage-icon">
                  <svg
                    class="w-7 h-7"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
