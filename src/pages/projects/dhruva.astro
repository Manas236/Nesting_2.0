  </style>

  <script>
    // Dhruva star-trail: an opaque night composite with a sage ring drawn over
    // it, both in the composite's own pixel space (SVG viewBox == image), so the
    // ring stays concentric with the BUILDING. Scroll grows the progress arc and
    // the active marker walks the fixed track. Panel/observer plumbing lives in
    // scripts/waypoints.ts.
    import { initWaypoints } from "../../scripts/waypoints";

    const root = document.querySelector<HTMLElement>("[data-dsky]");
    // `reveal-on` is set by the head guard only when JS is on AND motion is
    // allowed — the exact gate we want for pinning + the walking marker.
    if (root && document.documentElement.classList.contains("reveal-on")) {
      const canvas = root.querySelector<HTMLElement>(".dsky-canvas");
      const stage = root.querySelector<HTMLElement>("[data-dsky-stage]");
      const track = root.querySelector<SVGPathElement>("[data-dsky-track]");
      const bloom = root.querySelector<SVGPathElement>("[data-dsky-bloom]");
      const progress = root.querySelector<SVGPathElement>("[data-dsky-progress]");
      const grad = root.querySelector<SVGLinearGradientElement>("[data-dsky-grad]");
      const debugG = root.querySelector<SVGGElement>("[data-dsky-debug]");
      const trail = root.querySelector<HTMLImageElement>("[data-dsky-trail]");
      const markers = Array.from(root.querySelectorAll<HTMLElement>("[data-dmark]"));
      const stages = Array.from(root.querySelectorAll<HTMLElement>(".dstage"));

      const VB = 1080; // composite viewBox size (square)
      const ANGLES = [-108, -69, -30, 30, 69, 108]; // 01…06: up the left, down the right
      const debug =
        new URLSearchParams(location.search).get("ring") === "debug";

      if (canvas && stage && track && bloom && progress && grad) {
        root.classList.add("is-live");

        const num = (name: string, fallback: number): number => {
          const v = parseFloat(getComputedStyle(stage).getPropertyValue(name));
          return Number.isFinite(v) ? v : fallback;
        };
        // point on the ring at `deg` measured from vertical, clockwise positive
        const pt = (cx: number, cy: number, r: number, deg: number): [number, number] => {
          const t = (deg * Math.PI) / 180;
          return [cx + r * Math.sin(t), cy - r * Math.cos(t)];
        };
        // open arc from −span to +span, drawn the long way over the apex
        const arcPath = (cx: number, cy: number, r: number, span: number): string => {
          const [x0, y0] = pt(cx, cy, r, -span);
          const [x1, y1] = pt(cx, cy, r, span);
          const large = 2 * span > 180 ? 1 : 0;
          return `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${r} ${r} 0 ${large} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
        };

        // Build the ring + markers from the four CSS custom properties. Runs
        // once on load; in debug it re-runs each frame so live var edits show.
        const build = (): void => {
          const cx = num("--ring-cx", 547);
          const cy = num("--ring-cy", 560);
          const r = num("--ring-r", 458);
          const span = num("--ring-span", 125);

          const d = arcPath(cx, cy, r, span);
          track.setAttribute("d", d);
          bloom.setAttribute("d", d);
          progress.setAttribute("d", d);

          // vertical end-fade spans apex → the (equal-height) open ends
          grad.setAttribute("y1", String(cy - r));
          grad.setAttribute("y2", String(cy - r * Math.cos((span * Math.PI) / 180)));

          // markers: percent of the square stage == composite pixel ÷ viewBox
          markers.forEach((m, i) => {
            const [x, y] = pt(cx, cy, r, ANGLES[i] ?? 0);
            m.style.left = `${(x / VB) * 100}%`;
            m.style.top = `${(y / VB) * 100}%`;
          });

          if (debug) drawDebug(cx, cy, r);
        };

        // --- calibration overlay (?ring=debug) — dead code otherwise ---
        const svgns = "http://www.w3.org/2000/svg";
        let readout: HTMLDivElement | null = null;
        const mk = (
          name: string,
          attrs: Record<string, string | number>
        ): SVGElement => {
          const el = document.createElementNS(svgns, name);
          for (const k in attrs) el.setAttribute(k, String(attrs[k]));
          return el;
        };
        function drawDebug(cx: number, cy: number, r: number): void {
          if (!debugG) return;
          debugG.classList.add("on");
          debugG.replaceChildren();
          const bl = num("--b-left", 0);
          const br = num("--b-right", VB);
          const bt = num("--b-top", 0);
          const bb = num("--b-bottom", VB);
          debugG.appendChild(
            mk("rect", { x: bl, y: bt, width: br - bl, height: bb - bt,
              fill: "none", stroke: "#ff5db1", "stroke-width": 1 })
          );
          debugG.appendChild(
            mk("circle", { cx, cy, r, fill: "none",
              stroke: "#7cd7ff", "stroke-width": 1, "stroke-dasharray": "6 6" })
          );
          debugG.appendChild(mk("line", { x1: cx - 16, y1: cy, x2: cx + 16, y2: cy, stroke: "#ff5db1", "stroke-width": 1 }));
          debugG.appendChild(mk("line", { x1: cx, y1: cy - 16, x2: cx, y2: cy + 16, stroke: "#ff5db1", "stroke-width": 1 }));
          ANGLES.forEach((a, i) => {
            const [x, y] = pt(cx, cy, r, a);
            const t = mk("text", { x: x + 14, y: y + 5, fill: "#d6e896", "font-size": 22, "font-family": "monospace" });
            t.textContent = String(i + 1).padStart(2, "0");
            debugG.appendChild(t);
          });
          if (!readout) {
            readout = document.createElement("div");
            readout.className = "dsky-readout";
            document.body.appendChild(readout);
          }
          readout.textContent =
            `ring  cx ${cx.toFixed(0)}   cy ${cy.toFixed(0)}   r ${r.toFixed(0)}\n` +
            `bbox  L ${bl}  R ${br}  T ${bt}  B ${bb}`;
        }

        initWaypoints(root, {
          panelSelector: ".dstage",
          markerSelector: "[data-dmark]",
          onActive(i) {
            markers.forEach((m, idx) =>
              m.setAttribute("aria-current", idx === i ? "true" : "false")
            );
          },
        });

        // Marker buttons navigate independent of scroll position (keyboard OK).
        markers.forEach((m, i) =>
          m.addEventListener("click", () =>
            stages[i]?.scrollIntoView({ behavior: "smooth", block: "center" })
          )
        );

        // Continuous scroll progress → progress-arc growth (start end → far end)
        // and the trail's rotation: the star-trail render wheels around the pole
        // by up to TRAIL_SWEEP° across the pinned scroll while the building holds
        // (transform-origin pins it to the pole; the scale keeps the turning
        // square's edges out of the open sky).
        const TRAIL_SWEEP = 22; // degrees; positive = clockwise (matches the sky's wheel)
        let ticking = false;
        const onScroll = (): void => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const rect = root.getBoundingClientRect();
            const total = root.offsetHeight - window.innerHeight;
            const p =
              total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
            progress.style.strokeDashoffset = String(1 - p);
            if (trail)
              trail.style.transform =
                `rotate(${(p * TRAIL_SWEEP).toFixed(2)}deg) scale(1.08)`;
            ticking = false;
          });
        };

        build();
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", build, { passive: true });
        if (debug) {
          const loop = () => {
            build();
            requestAnimationFrame(loop);
          };
          requestAnimationFrame(loop);
        }
      }
    }
  </script>
</BaseLayout>
