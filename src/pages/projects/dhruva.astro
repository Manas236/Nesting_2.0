    /* --- The sky canvas: an opaque night composite with a sage ring drawn
       over it. The composite and the ring share ONE coordinate space, so the
       ring is concentric with the building, not the canvas box. --- */
    .dsky-canvas {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0c0e2d; /* seam-matched to the composite's own top-corner sky */
    }

    /* The shared pixel space. A square box (the composite's 1:1 aspect) sized
       to fit both the column width and the viewport height; object-fit:contain
       makes the image fill it exactly, and the ring's SVG viewBox (1080×1080)
       maps 1:1 onto it — so every ring coordinate is a composite pixel. */
    .dsky-stage {
      position: relative;
      aspect-ratio: 1 / 1;
      width: min(100%, 88vh);
      container-type: inline-size; /* markers + dots size against the box */
    }
    /* Sky fill BEHIND the photo (over .dsky-fade, under the img). It paints the
       composite's own corner-sky colour right up to the photo's edge, so when
       the photo feathers there is nothing lighter to reveal — no halo. Anchored
       to the stage, it eases out to the pane's existing sky at its corners. */
    .dsky-skyfill {
      position: absolute;
      inset: -16%;
      pointer-events: none;
      background: radial-gradient(
        farthest-corner at 50% 50%,
        #0d0f2d 0 76%,
        transparent 100%
      );
    }
    .dsky-building {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      /* Feather all four edges into the sky so the square boundary dissolves.
         Ramps are asymmetric: the bottom is shallow (last ~10%) so the tree line
         (y≈720) and the arc ends (y≈823) stay fully opaque and dissolve INTO the
         trees, not into a fade. Percentages are nudgeable custom properties. */
      --feather-top: 7%;
      --feather-bottom: 10%;
      --feather-left: 6%;
      --feather-right: 6%;
      -webkit-mask-image:
        linear-gradient(to bottom, transparent 0, #000 var(--feather-top)),
        linear-gradient(to top, transparent 0, #000 var(--feather-bottom)),
        linear-gradient(to right, transparent 0, #000 var(--feather-left)),
        linear-gradient(to left, transparent 0, #000 var(--feather-right));
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to bottom, transparent 0, #000 var(--feather-top)),
        linear-gradient(to top, transparent 0, #000 var(--feather-bottom)),
        linear-gradient(to right, transparent 0, #000 var(--feather-left)),
        linear-gradient(to left, transparent 0, #000 var(--feather-right));
      mask-composite: intersect;
    }
    .dsky-ring {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
    .dsky-ring stop {
      stop-color: var(--color-olive);
    }
    /* fixed sage track + its soft bloom, both dissolving at the low open ends */
    .dsky-track-bloom {
      stroke: url(#dsky-ends);
      stroke-width: 9;
      stroke-opacity: 0.22;
      stroke-linecap: round;
      filter: blur(4px);
    }
    .dsky-track {
      stroke: url(#dsky-ends);
      stroke-width: 3;
      stroke-opacity: 0.55;
      stroke-linecap: round;
    }
    /* the traveled arc — grows from the first marker as you scroll */
    .dsky-progress {
      stroke: url(#dsky-ends);
      stroke-width: 3.4;
      stroke-opacity: 0.95;
      stroke-linecap: round;
      filter: drop-shadow(0 0 5px rgba(110, 122, 69, 0.9));
    }

    .dsky-fade {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        to right,
        rgba(14, 17, 48, 0.25) 0%,
        rgba(14, 17, 48, 0) 30%,
        rgba(244, 242, 236, 0) 58%,
        var(--color-stone) 100%
      );
    }

    /* Right-side dissolve INTO the cream copy column beside it — the Shikhar
       look. Canvas-level + full-height, so the pane's right edge always melts
       into the page: it covers the star-trail's right side and, when the square
       centres (leaving a dark margin), that margin too — no hard navy band
       against the copy.

       The catch: the square is `min(100%, 88vh)` and CENTRED, so its right edge
       (and the dark margin beside it) slides left on short/wide viewports and
       sits flush-right on tall ones. A fixed % start can't win — low enough to
       cover the margin when centred would wash the ring when it fills the pane.
       So we anchor the fade's LEFT edge to the square's own geometry instead:

           --sq        : half the centred square's width, in canvas units. Mirrors
                         the stage's `min(100%, 88vh)` (halved → min(50%, 44vh)).
           --fade-from : where the cream STARTS, as a fraction of the half-square
                         measured out from centre. The ring's rightmost point is
                         at ~0.86; 0.88 clears it by a hair. The fade is fully
                         transparent AT the start, so the ring stays untouched.
                         (At full width this resolves to 50%+0.88·50% = 94% — the
                         old safe value — and slides left as the square shrinks,
                         swallowing the navy margin.) Raise toward 1 to hug the
                         edge tighter; lower to eat further into the pane.
           --fade-solid: where it reaches full cream, as a fraction of the span
                         from the start to the canvas edge. Lower = cream sooner. */
    .dsky-rightfade {
      --sq: min(50%, 44vh);
      --fade-from: 0.88;
      --fade-solid: 45%;
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      left: calc(50% + var(--fade-from) * var(--sq));
      pointer-events: none;
      background: linear-gradient(
        to right,
        rgba(244, 242, 236, 0) 0,
        var(--color-stone) var(--fade-solid)
      );
    }

    /* Rotating star-trail render (…-alpha.png — navy backdrop knocked out to
       transparency). The wrapper is FIXED and just carries the roofline fade so
       the streaks stop above the building; because the layer is transparent it
       overlays the sky with no tint, so no blend mode is needed and the turning
       square never seams. The inner <img> is the only thing that rotates. */
    .dsky-trailwrap {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      /* trails fade out just above the rooflines (~34%), same idea as the old
         SVG sky mask, so they read across the open sky and never paint the
         building. This mask is on the FIXED wrapper, so it stays level while
         the image below turns. */
      -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 30%, transparent 37%);
      mask-image: linear-gradient(to bottom, #000 0, #000 30%, transparent 37%);
    }
    .dsky-trail {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      transform-origin: 50.6% 51.9%; /* the ring pole (cx547, cy560 of 1080) */
      transform: rotate(0deg) scale(1.08); /* slight overscan keeps streaks in frame as it turns */
      will-change: transform;
    }

