  <script is:inline>
    const header = document.getElementById("site-header");
    const onScroll = () =>
      header.classList.toggle("is-scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    toggle.addEventListener("click", () => menu.classList.toggle("open"));
    menu.querySelectorAll(".mobile-link").forEach((link) =>
      link.addEventListener("click", () => menu.classList.remove("open"))
    );

    // Scroll-reveal: fade/lift elements in as they enter the viewport.
    // Only wired up when the head guard enabled reveal-on (JS + motion OK).
    if (document.documentElement.classList.contains("reveal-on")) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      document
        .querySelectorAll(".reveal, .reveal-img")
        .forEach((el) => io.observe(el));
    }
  </script>

