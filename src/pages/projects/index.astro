---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";

import { brand, contact, projects, stats, amenities, pipeline } from "../../data/site";

// Standalone route → absolute links; in-page anchors resolve to the home page.

const footerLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "The Standard", href: "#amenities" },
  { label: "Contact", href: "/#contact" },
];

// On-this-page jump links: the standard every building is held to, then the
// buildings themselves.
const sections = [
  { label: "Projects", href: "#catalogue" },
  { label: "The Standard", href: "#amenities" },
];

// Line-icon fallbacks for amenities with no photograph yet (currently "03").
const amenityIcons: Record<string, string> = {
  "01": `<rect x="2" y="9" width="4" height="6" rx="1"/><rect x="18" y="9" width="4" height="6" rx="1"/><line x1="6" y1="12" x2="18" y2="12" stroke-width="2"/>`,
  "02": `<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>`,
  "03": `<rect x="2.5" y="9" width="13" height="7" rx="2"/><circle cx="8" cy="12.5" r="1.8"/><path d="M16 10.5 21 8v9l-5-2.5z" stroke-linejoin="round"/>`,
  "04": `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 16V8h3.2a2.6 2.6 0 1 1 0 5.2H9"/>`,
  "05": `<rect x="4" y="2.5" width="16" height="19" rx="2"/><path d="M12 2.5v19"/><path d="M9.4 10 8 8l-1.4 2"/><path d="M14.6 14 16 16l1.4-2"/>`,
  "06": `<path d="M3 21 9 17.5V6.5L3 3zM21 21l-6-3.5V6.5L21 3z"/><path d="M9 12h6"/>`,
};

// Ongoing / delivered bands, derived from status so a new project lands in
// the right band the moment it's added to site.ts. This is the full catalogue
// — the home page only teases a curated few.
const portfolio = [
  {
    kicker: "Ongoing",
    // Not a blanket "under construction" any more: Udaan is in this band on
    // the owner's instruction while still in approvals, with nothing on site.
    // Each card carries its own status label, and this caption covers both.
    caption: "Under way in Karanjade, Panvel — on site now, or in approvals.",
    items: projects.filter((p) => p.status === "Ongoing"),
  },
  {
    kicker: "Delivered",
    caption: "Completed, sold out and handed over in Karanjade, Panvel.",
    items: projects.filter((p) => p.status === "Delivered"),
  },
];

const arrow = `<path d="M5 12h14M13 6l6 6-6 6"/>`;

// Masthead film. The Dhruva elevation doubles as the poster so the first paint
// is instant and reduced-motion visitors still get a still frame.
const mastheadVideo = "/images/projects/construction.mp4";
const mastheadPoster = "/images/projects/Dhruva-Elevation_image.jpg";

const pageTitle = `Projects — Ongoing & Delivered Residences · ${brand.name}`;
const pageDesc =
  "The complete Nesting Tree portfolio in Karanjade, Navi Mumbai — ongoing and delivered residences, each built to the same amenity-first standard. Explore every project.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- ============================ NAVBAR ============================ -->
  <SiteHeader sections={sections} />

  <!-- ============================ MASTHEAD ============================ -->
  <section
    class="relative h-[100svh] min-h-[620px] w-full bg-ink text-stone overflow-hidden"
  >
    <video
      class="hero-img-reveal absolute top-0 left-0 w-full h-full object-cover object-[60%_center] sm:object-center"
      src={mastheadVideo}
      poster={mastheadPoster}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Nesting Tree residences under construction in Karanjade, Navi Mumbai"></video>
    <!-- layered scrims: nav legibility (top), copy (bottom), headline (left) -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/25 to-ink/70"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/75 via-ink/25 to-transparent"></div>

    <div
      class="relative h-full max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col justify-end pb-16 lg:pb-24"
    >
      <span
        class="hero-rise font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.24em] text-olive-100 block"
        style="--rise-d:0.1s">Our Portfolio</span
      >
      <h1
        class="hero-rise font-display font-black text-white text-[2.75rem] sm:text-6xl lg:text-[6rem] leading-[0.95] tracking-tight mt-5 max-w-4xl"
        style="--rise-d:0.22s"
      >
        Every project, a promise we keep.
      </h1>
      <p
        class="hero-rise text-white/70 text-base sm:text-lg lg:text-xl mt-7 max-w-2xl leading-relaxed"
        style="--rise-d:0.36s"
      >
        From groundbreaking to handover — and every year after — here's what we're building,
        and what we've already delivered.
      </p>

      <dl
        class="hero-fade grid grid-cols-3 gap-4 mt-12 max-w-lg border-t border-white/10 pt-8"
        style="--fade-d:0.6s"
      >
        <!-- "Projects", not "Residences": the figure now includes Udaan,
             which is a commercial building. `stats.residences` is the
             homes-only count if this tile ever needs to say residences. -->
        <div>
          <dt class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-white/45">
            Projects
          </dt>
          <dd class="font-display font-black text-3xl lg:text-4xl tracking-tight mt-2">
            {stats.projects}
          </dd>
        </div>
        <div>
          <dt class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-white/45">
            Delivered
          </dt>
          <dd class="font-display font-black text-3xl lg:text-4xl tracking-tight mt-2">
            {stats.delivered}
          </dd>
        </div>
        <div>
          <dt class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-white/45">
            Ongoing
          </dt>
          <dd class="font-display font-black text-3xl lg:text-4xl tracking-tight mt-2">
            {stats.ongoing}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===================== FULL CATALOGUE =====================
       Leads the page: a projects/portfolio page shows the listings first,
       since that's what the visitor came for. "The Standard" follows below
       as the proof behind the buildings. -->
  <section id="catalogue" class="bg-stone py-20 lg:py-28 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="flex flex-col gap-16 lg:gap-24">
        {
          portfolio.map((group) => (
            <div class="rail-band" data-band>
              <div class="reveal flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 border-b border-line pb-5 mb-10">
                <div class="flex items-center gap-3.5">
                  <h2 class="font-display font-black text-3xl lg:text-4xl tracking-tight">
                    {group.kicker}
                  </h2>
                  <span
                    class={`font-display text-[11px] font-bold uppercase tracking-[0.14em] px-3 py-1.5 rounded-full ${
                      group.kicker === "Ongoing"
                        ? "bg-olive text-white"
                        : "bg-olive-50 text-olive-600"
                    }`}
                  >
                    {group.items.length}{" "}
                    {group.items.length === 1 ? "project" : "projects"}
                  </span>
                </div>
                <p class="text-muted text-sm sm:text-base max-w-md sm:text-right leading-relaxed">
                  {group.caption}
                </p>
              </div>

              {/* ---------- The cards, as a scroll-snap rail ----------
                   Was a 3-up grid. With four ongoing projects the fourth card
                   wrapped onto a row of its own and read as an afterthought,
                   and the same would happen to every 4th, 7th … project added.
                   A rail never orphans a card at any count.

                   Mechanics are the home page's testimonial carousel, not a
                   new invention: native scroll-snap (so swipe, trackpad and
                   keyboard work with zero JS), with arrows, dots and mouse
                   drag layered on as progressive enhancement. Two differences
                   from that one, both deliberate:
                     · no inner `w-max` track — the scroll container IS the
                       flex container. Card widths are percentages, so they
                       need a definite basis to resolve against, and the rail
                       is the only box here that has one.
                     · `.reveal` sits on the rail, not on each card. A card
                       scrolled out of view horizontally never intersects, so
                       per-card reveals would leave blanks in the rail.

                   The controls and edge fades below hide themselves whenever
                   everything already fits (Delivered, at desktop width), so a
                   band that doesn't scroll shows no scroll furniture. */}
              <div class="reveal p-railwrap relative">
                <div
                  class="p-rail flex gap-3 lg:gap-4"
                  data-rail
                  tabindex="0"
                  role="group"
                  aria-roledescription="carousel"
                  aria-label={`${group.kicker} projects`}
                >
                  {group.items.map((p) => (
                    <a
                      href={`/projects/${p.slug}`}
                      draggable="false"
                      class="p-card group relative shrink-0 overflow-hidden rounded-[3px] bg-ink h-[86vw] sm:h-[380px] lg:h-[500px]"
                    >
                      <img
                        src={p.image}
                        alt={`${p.name} — ${p.location}`}
                        loading="lazy"
                        draggable="false"
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.05]"
                        style={`object-position: ${p.objectPosition};`}
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/25 to-ink/5" />
                      <span
                        class={`absolute top-4 left-4 font-display text-[10px] font-bold uppercase tracking-[0.14em] px-2.5 py-1 rounded-[2px] ${
                          p.status === "Ongoing" ? "bg-olive text-white" : "bg-stone/90 text-ink"
                        }`}
                      >
                        {p.statusLabel}
                      </span>
                      <div class="absolute inset-x-0 bottom-0 p-5 lg:p-7">
                        <h3 class="font-display font-black text-2xl lg:text-3xl text-white tracking-tight">
                          {p.name}
                        </h3>
                        <p class="text-white/65 text-sm mt-1">{p.location}</p>
                        <p class="text-white/70 text-sm leading-relaxed mt-3 max-w-sm max-h-0 opacity-0 overflow-hidden transition-all duration-500 ease-out group-hover:max-h-40 group-hover:opacity-100">
                          {p.blurb}
                        </p>
                        <span class="inline-flex items-center gap-2 font-display text-[11px] font-bold uppercase tracking-[0.16em] text-olive-100 mt-4">
                          View Project
                          <svg
                            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            set:html={arrow}
                          />
                        </span>
                      </div>
                    </a>
                  ))}
                </div>

                {/* Edge fades — the "there's more this way" hint. Purely
                    decorative and click-through; JS toggles them with the
                    scroll position. */}
                <span class="rail-fade rail-fade-l" aria-hidden="true" />
                <span class="rail-fade rail-fade-r" aria-hidden="true" />
              </div>

              {/* Dots + arrows. Hidden from assistive tech — the rail itself is
                  focusable, swipeable and arrow-key scrollable.

                  Hidden by default and shown only once the script confirms the
                  band actually overflows, so a band that fits (Delivered, on a
                  desktop) shows no scroll furniture, and a visitor with JS off
                  never gets buttons that do nothing. Deliberately NOT a
                  `.reveal`: it can start out display:none, and an element that
                  never intersects never gets its in-view class — it would come
                  back from a resize permanently invisible. */}
              <div class="p-controls items-center justify-between gap-6 mt-7" aria-hidden="true">
                <div class="flex items-center gap-2.5">
                  {group.items.map((_, i) => (
                    <button
                      type="button"
                      data-dot={i}
                      class="p-dot h-2 rounded-full bg-ink/20 hover:bg-ink/40 transition-all"
                    />
                  ))}
                </div>
                <div class="flex items-center gap-2.5 shrink-0">
                  <button
                    type="button"
                    data-dir="-1"
                    class="p-arrow w-11 h-11 lg:w-12 lg:h-12 rounded-full border border-ink/25 text-ink flex items-center justify-center hover:bg-ink hover:text-stone hover:border-ink transition-colors disabled:opacity-30 disabled:pointer-events-none"
                  >
                    <svg
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M19 12H5M11 18l-6-6 6-6" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-dir="1"
                    class="p-arrow w-11 h-11 lg:w-12 lg:h-12 rounded-full border border-ink/25 text-ink flex items-center justify-center hover:bg-ink hover:text-stone hover:border-ink transition-colors disabled:opacity-30 disabled:pointer-events-none"
                  >
                    <svg
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={arrow}
                    />
                  </button>
                </div>
              </div>
            </div>
          ))
        }

        {/* ---------- IN APPROVALS ----------
             Projects from `pipeline` in src/data/site.ts — approved on paper
             but not yet building. Deliberately NOT one of the bands above:
             those are driven by `projects`, whose count feeds the "residences"
             and "under construction" figures site-wide, and these projects are
             neither. Sits directly under Ongoing because it is forward-looking
             work, but reads as its own, quieter thing.

             The treatment is text-only ON PURPOSE — no render exists, the card
             links nowhere because there is no detail page to link to, and
             there is no call to action because an unregistered project must
             not be advertised for sale. Don't add one. */}
        {
          pipeline.length > 0 && (
            <div>
              <div class="reveal flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 border-b border-line pb-5 mb-10">
                <div class="flex items-center gap-3.5">
                  <h2 class="font-display font-black text-3xl lg:text-4xl tracking-tight">
                    In Approvals
                  </h2>
                  <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] px-3 py-1.5 rounded-full bg-olive-50 text-olive-600">
                    {pipeline.length}{" "}
                    {pipeline.length === 1 ? "project" : "projects"}
                  </span>
                </div>
                <p class="text-muted text-sm sm:text-base max-w-md sm:text-right leading-relaxed">
                  Still working to optimize usage. Bookings are not open as yet.
                </p>
              </div>

              <div class="flex flex-col gap-4">
                {pipeline.map((p, i) => (
                  <div
                    class="reveal relative rounded-[3px] border border-line bg-white/50 p-6 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] gap-8 lg:gap-14"
                    style={`--reveal-d:${(i * 0.09).toFixed(2)}s`}
                  >
                    <div>
                      <span class="inline-block font-display text-[10px] font-bold uppercase tracking-[0.14em] px-2.5 py-1 rounded-[2px] bg-olive-50 text-olive-600 border border-olive-100">
                        {p.statusLabel}
                      </span>
                      <h3 class="font-display font-black text-3xl lg:text-4xl tracking-tight mt-5">
                        {p.name}
                      </h3>
                      <p class="text-muted text-sm mt-1.5">{p.location}</p>
                      <p class="text-ink/75 text-sm sm:text-base leading-relaxed mt-5 max-w-xl">
                        {p.blurb}
                      </p>
                    </div>

                    <div class="lg:border-l lg:border-line lg:pl-14">
                      <h4 class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-muted">
                        Where it stands
                      </h4>
                      <ul class="mt-5 flex flex-col gap-3">
                        {p.facts.map((fact) => (
                          <li class="flex items-start gap-3 text-sm text-ink/80 leading-relaxed">
                            <span
                              class="mt-[0.45rem] w-1.5 h-1.5 rounded-full bg-olive-600/50 shrink-0"
                              aria-hidden="true"
                            />
                            {fact}
                          </li>
                        ))}
                      </ul>
                      <p class="text-muted text-xs leading-relaxed mt-6">
                        Plans, drawings and a project page will be published here once the
                        approvals are through.
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ===================== THE STANDARD (amenities) =====================
       Follows the catalogue: the buildings come first, then the proof of the
       "amenity-first standard" the masthead claims. Product content, housed
       here rather than on /about because these amenities describe the homes
       above. A light card grid — it previously ran as six full-bleed ink rows,
       ~2,600px of unbroken black that dominated its whole page. -->
  <section id="amenities" class="bg-olive-50 py-20 lg:py-28 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="max-w-3xl">
        <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >The Nesting Tree Standard</span
        >
        <h2
          class="reveal font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05] text-ink"
          style="--reveal-d:0.1s"
        >
          Amenities that add value to your living.
        </h2>
        <p
          class="reveal text-muted text-base sm:text-lg mt-6 max-w-xl leading-relaxed"
          style="--reveal-d:0.2s"
        >
          You pay a little more for a Nesting Tree home, and you get more than four walls. This is
          what comes built into every building above.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 lg:gap-4 mt-12 lg:mt-16">
        {
          amenities.map((a, i) => (
            <article
              class="reveal bg-card border border-line rounded-[3px] overflow-hidden flex flex-col"
              style={`--reveal-d:${((i % 3) * 0.08).toFixed(2)}s`}
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-concrete">
                {a.image ? (
                  <img
                    src={a.image}
                    alt={`${a.kicker} — ${a.title}`}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover"
                    style={`object-position: ${a.objectPosition ?? "center"};`}
                  />
                ) : (
                  <div class="absolute inset-0 blueprint-light flex flex-col items-center justify-center gap-2.5 text-ink/35">
                    <svg
                      class="w-8 h-8"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={amenityIcons[a.no]}
                    />
                    <span class="font-display text-[10px] font-bold uppercase tracking-[0.18em]">
                      {a.kicker} Imagery
                    </span>
                  </div>
                )}
                <span class="absolute top-3 left-3 font-display font-black text-[11px] tracking-[0.1em] bg-ink/85 text-stone px-2 py-1 rounded-[2px] tabular-nums">
                  {a.no}
                </span>
              </div>

              <div class="p-6 lg:p-7 flex flex-col flex-1">
                <span class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-olive-600">
                  {a.kicker}
                </span>
                <h3 class="font-display font-black text-xl lg:text-2xl tracking-tight mt-2 text-ink leading-tight">
                  {a.title}
                </h3>
                <p class="text-muted text-sm sm:text-base leading-relaxed mt-3 flex-1">{a.body}</p>
                <p class="font-display text-[10px] font-bold uppercase tracking-[0.12em] text-olive-dark mt-5 pt-4 border-t border-line">
                  {a.featured}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="bg-ink text-stone">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 pt-16 pb-10 border-b border-white/10">
      <h3
        class="reveal font-display font-black text-[3.25rem] sm:text-[6rem] lg:text-[8rem] leading-none tracking-tight"
      >
        NESTING TREE
      </h3>
    </div>

    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 py-14">
      <div class="grid sm:grid-cols-2 lg:grid-cols-[minmax(300px,1fr)_1fr_1fr_1fr] gap-12">
        <div class="reveal">
          <p class="text-stone/55 text-sm leading-relaxed sm:whitespace-nowrap">
            {brand.footerLine}
          </p>
          <div class="flex items-center gap-3 mt-6">
            {
              contact.socials.map((s) => (
                <a
                  href={s.href}
                  class="w-9 h-9 rounded-[2px] bg-white/5 border border-white/10 flex items-center justify-center text-xs font-display font-bold hover:bg-white/10 transition-colors"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="reveal" style="--reveal-d:0.08s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Explore
          </h5>
          <ul class="space-y-3 text-sm font-medium">
            {
              footerLinks.map((item) => (
                <li>
                  <a href={item.href} class="hover:text-olive-100 transition-colors">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--reveal-d:0.16s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Projects
          </h5>
          <ul class="space-y-3 text-sm font-medium text-stone/80">
            {
              projects.map((p) => (
                <li>
                  <a
                    href={`/projects/${p.slug}`}
                    class="hover:text-olive-100 transition-colors"
                  >
                    {p.name} — {p.status}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="reveal" style="--reveal-d:0.24s">
          <h5 class="font-display font-bold text-sm uppercase tracking-wide text-stone/40 mb-4">
            Contact
          </h5>
          <ul class="space-y-3 text-sm font-medium text-stone/80">
            <li class="flex items-start gap-2.5">
              <svg
                class="w-4 h-4 mt-0.5 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                ><path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"></path><circle
                  cx="12"
                  cy="9"
                  r="2.2"></circle></svg
              >
              {contact.address}
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                class="w-4 h-4 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"><path d="M4 5h16v14H4z"></path><path d="m4 6 8 7 8-7"></path></svg
              >
              <a href={`mailto:${contact.email}`} class="hover:text-olive-100 transition-colors"
                >{contact.email}</a
              >
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                class="w-4 h-4 shrink-0 text-olive-100"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                ><path
                  d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"
                ></path></svg
              >
              <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="hover:text-olive-100 transition-colors"
                >{contact.phone}</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div
        class="border-t border-white/10 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone/40"
      >
        <p>&copy; {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
        <p>{contact.maharera}</p>
        <div class="flex items-center gap-5">
          <a href="/privacy" class="hover:text-stone/70 transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-stone/70 transition-colors">Terms</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    if (document.documentElement.classList.contains("reveal-on")) {
      const revealTargets = document.querySelectorAll(".reveal, .reveal-img");
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      revealTargets.forEach((el) => io.observe(el));
    }

    /* ---------- Project rails ----------
       One instance per band ([data-band]), so Ongoing and Delivered scroll
       independently. The rail is a native scroll-snap container: swipe,
       trackpad, shift-wheel and keyboard already work with this script
       disabled. Everything here is enhancement — arrows, click-to-jump dots,
       mouse drag, edge fades — plus the check that hides all of it when a
       band already fits. Adapted from the testimonial carousel on the home
       page; keep the two in step if you change one. */
    document.querySelectorAll("[data-band]").forEach((band) => {
      const rail = band.querySelector("[data-rail]");
      if (!rail) return;

      const cards = [...rail.children];
      const arrows = [...band.querySelectorAll(".p-arrow")];
      const dots = [...band.querySelectorAll(".p-dot")];
      if (!cards.length) return;

      // Left edge of card i in the rail's own scroll coordinates. Measured
      // from live rects plus the current scrollLeft rather than offsetLeft:
      // offsetLeft is relative to whichever ancestor happens to be positioned,
      // which is a detail of the markup above this rail, and this isn't.
      const cardLeft = (i) =>
        rail.scrollLeft +
        (cards[i].getBoundingClientRect().left - rail.getBoundingClientRect().left);

      // Which card currently sits nearest the rail's left edge.
      const activeIndex = () => {
        const x = rail.scrollLeft;
        let best = 0;
        let dist = Infinity;
        cards.forEach((_, i) => {
          const d = Math.abs(cardLeft(i) - x);
          if (d < dist) {
            dist = d;
            best = i;
          }
        });
        return best;
      };

      const goTo = (i) => {
        const clamped = Math.max(0, Math.min(cards.length - 1, i));
        rail.scrollTo({ left: cardLeft(clamped) });
      };

      // Reflect scroll position in the dots, the arrow disabled states and the
      // edge fades — and drop the whole control row when nothing overflows.
      // The last "page" begins once the rail is scrolled fully right, so the
      // final dot lights up even though card N never reaches the left edge.
      const sync = () => {
        const overflow = rail.scrollWidth - rail.clientWidth;
        const scrolls = overflow > 2;
        band.classList.toggle("can-scroll", scrolls);
        if (!scrolls) {
          band.classList.remove("can-left", "can-right");
          return;
        }
        const atStart = rail.scrollLeft <= 2;
        const atEnd = rail.scrollLeft >= overflow - 2;
        band.classList.toggle("can-left", !atStart);
        band.classList.toggle("can-right", !atEnd);
        const active = atEnd ? dots.length - 1 : activeIndex();
        dots.forEach((d, i) => d.classList.toggle("is-active", i === active));
        arrows.forEach((a) => {
          const dir = Number(a.dataset.dir);
          a.disabled = (dir < 0 && atStart) || (dir > 0 && atEnd);
        });
      };

      arrows.forEach((a) =>
        a.addEventListener("click", () => goTo(activeIndex() + Number(a.dataset.dir)))
      );
      dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
      rail.addEventListener("scroll", sync, { passive: true });
      window.addEventListener("resize", sync);

      // Click-and-drag with a mouse (touch and trackpad scroll natively).
      let dragging = false;
      let startX = 0;
      let startScroll = 0;
      let moved = false;
      rail.addEventListener("pointerdown", (e) => {
        if (e.pointerType === "touch") return; // let native touch scrolling run
        dragging = true;
        moved = false;
        startX = e.clientX;
        startScroll = rail.scrollLeft;
        rail.classList.add("is-dragging");
        rail.setPointerCapture(e.pointerId);
      });
      rail.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        rail.scrollLeft = startScroll - dx;
      });
      const endDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        rail.classList.remove("is-dragging");
        rail.releasePointerCapture?.(e.pointerId);
        if (moved) goTo(activeIndex()); // settle onto the nearest snap point
      };
      rail.addEventListener("pointerup", endDrag);
      rail.addEventListener("pointercancel", endDrag);
      // The cards are links: swallow the click that ends a drag so dragging
      // the rail never navigates to whichever project you let go over.
      rail.addEventListener(
        "click",
        (e) => {
          if (moved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      // Images finish loading after first paint and can change scrollWidth.
      window.addEventListener("load", sync);
      sync();
    });
  </script>

  <style>
    /* Project rails. The scroll container is also the flex container, so the
       cards' percentage widths resolve against its definite width and the
       `shrink-0` cards overflow it horizontally — the textbook scroller, with
       no intrinsic-size guesswork. Widths match the grid this replaced:
       1-up on phones, 2-up from sm, 3-up from lg. */
    .p-rail {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none; /* Firefox */
      cursor: grab;
      -webkit-overflow-scrolling: touch;
    }
    .p-rail::-webkit-scrollbar {
      display: none; /* WebKit */
    }
    .p-rail:focus-visible {
      outline: 2px solid var(--color-olive);
      outline-offset: 4px;
    }
    .p-rail.is-dragging {
      cursor: grabbing;
      user-select: none;
      scroll-behavior: auto;
    }
    .p-card {
      scroll-snap-align: start;
      width: 100%;
    }
    @media (min-width: 640px) {
      .p-card {
        width: calc((100% - 0.75rem) / 2); /* 2 up, matches gap-3 */
      }
    }
    @media (min-width: 1024px) {
      .p-card {
        width: calc((100% - 2 * 1rem) / 3); /* 3 up, matches lg:gap-4 */
      }
    }

    /* Edge fades: the hint that the rail has more to the right. Sized to the
       rail alone (the wrapper holds nothing else) and click-through, so they
       never sit between a pointer and a project card. */
    .rail-fade {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 3.5rem;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    @media (min-width: 1024px) {
      .rail-fade {
        width: 5rem;
      }
    }
    .rail-fade-l {
      left: 0;
      background: linear-gradient(to right, var(--color-stone), transparent);
    }
    .rail-fade-r {
      right: 0;
      background: linear-gradient(to left, var(--color-stone), transparent);
    }
    .rail-band.can-left .rail-fade-l,
    .rail-band.can-right .rail-fade-r {
      opacity: 1;
    }

    .p-dot {
      width: 0.5rem;
    }
    .p-dot.is-active {
      width: 1.5rem;
      background: var(--color-olive);
    }

    /* Scroll furniture is opt-in: the script adds `can-scroll` only when the
       rail genuinely overflows, and re-checks on resize — so Delivered keeps
       its dots on a phone (2-up, it does scroll) and drops them on a desktop
       (3-up, it doesn't), and no-JS visitors never see inert buttons. */
    .p-controls {
      display: none;
    }
    .rail-band.can-scroll .p-controls {
      display: flex;
    }

    @media (prefers-reduced-motion: reduce) {
      .p-rail {
        scroll-behavior: auto;
      }
    }
  </style>
</BaseLayout>
