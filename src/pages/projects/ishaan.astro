---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import AreaStats from "../../components/AreaStats.astro";
import BuildProgress from "../../components/BuildProgress.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { brand, contact, features, projects, sales, whatsappHref } from "../../data/site";
import {
  TBD,
  ishaan,
  heroStats,
  overview,
  unitTypes,
  unitTypesNote,
  buildProgress,
  floorPlans,
  levels,
  amenityGroups,
  gallery,
} from "../../data/ishaan";
import { residenceSchema } from "../../lib/structured-data";

/* ---------- Line-icon set (24×24, stroke currentColor) ----------
   Keyed to the `icon` fields in src/data/ishaan.ts. Kept here as
   presentation, the way the homepage keeps its amenity icons. The
   set carries the full Building / Lifestyle / Interiors vocabulary
   used by shikhar.ts and dhruva.ts, so filling `amenityGroups` in
   the data file needs no change here.                             */
const icons: Record<string, string> = {
  tower: `<rect x="7" y="3" width="10" height="18" rx="1"/><path d="M4 21h16"/><path d="M10.5 7h.01M13.5 7h.01M10.5 11h.01M13.5 11h.01M10.5 15h.01M13.5 15h.01"/>`,
  elevator: `<rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M12 2.5v19"/><path d="m9.6 8.5-1.1 1.6h2.2z"/><path d="m9.6 15.5-1.1-1.6h2.2z"/><path d="M14.5 9h2.5M14.5 12h2.5M14.5 15h2.5"/>`,
  lobby: `<path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/><path d="M4 21h16"/><path d="M14.2 12h.01"/>`,
  stairs: `<path d="M3 21h4v-4h4v-4h4v-4h4v-4h2"/><path d="M3 21v-2"/>`,
  parking: `<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M9.5 16.5v-9h3.4a2.8 2.8 0 0 1 0 5.6H9.5"/>`,
  waterproof: `<path d="M12 3 5 6v5c0 4.6 3 8.1 7 9 4-.9 7-4.4 7-9V6z"/><path d="M12 9.5c1.2 1.6 2 2.7 2 3.7a2 2 0 0 1-4 0c0-1 .8-2.1 2-3.7z"/>`,
  gym: `<path d="M6.5 8v8M3.5 9.8v4.4M17.5 8v8M20.5 9.8v4.4M6.5 12h11"/>`,
  rooftop: `<circle cx="12" cy="12.5" r="3.2"/><path d="M12 4.5v2M5 12.5H3.2M20.8 12.5H19M6.9 7.4 5.7 6.2M18.3 6.2l-1.2 1.2"/><path d="M3 20.5h18"/>`,
  shop: `<path d="M3.5 9 5 5h14l1.5 4z"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-5.5h5V20"/>`,
  star: `<path d="m12 4 2.3 5 5.4.5-4.1 3.6 1.3 5.3L12 16.6 7.1 18.4l1.3-5.3-4.1-3.6 5.4-.5z"/>`,
  tiles: `<rect x="3.5" y="3.5" width="17" height="17" rx="1"/><path d="M3.5 12h17M12 3.5v17"/>`,
  faucet: `<path d="M12 3.5c2.6 3.7 4.2 6.2 4.2 8.3a4.2 4.2 0 0 1-8.4 0c0-2.1 1.6-4.6 4.2-8.3z"/>`,
  window: `<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M12 3v18M4 12h16"/>`,
  grill: `<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M9 4v16M14 4v16M4 9h16M4 14h16"/>`,
  fan: `<circle cx="12" cy="12" r="1.8"/><path d="M12 10.2c-.4-2.8.6-5.2 2.4-5.2 1.5 0 1.8 2.3-.6 3.6M13.8 12c2.8-.4 5.2.6 5.2 2.4 0 1.5-2.3 1.8-3.6-.6M12 13.8c.4 2.8-.6 5.2-2.4 5.2-1.5 0-1.8-2.3.6-3.6M10.2 12c-2.8.4-5.2-.6-5.2-2.4 0-1.5 2.3-1.8 3.6.6"/>`,
  loft: `<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 9h16"/><path d="M8 6.4h.01M11 6.4h.01"/><path d="M11 13h6"/>`,
};

const arrow = `<path d="M5 12h14M13 6l6 6-6 6"/>`;
const pin = `<path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/>`;

const sections = [
  { label: "Overview", href: "#overview" },
  { label: "Units", href: "#units" },
  { label: "Floor plans", href: "#floorplans" },
  { label: "Gallery", href: "#gallery" },
  { label: "Progress", href: "#progress" },
  { label: "Amenities", href: "#amenities" },
];

/* A value we were never given prints nothing at all. It used to render
   as a muted "Insufficient information" placeholder; that came off every
   project page on the owner's instruction (13 Aug 2026) — a page that
   announces its own gaps reads as broken rather than honest. The gap is
   still never filled with a guess: the line, row or block simply stays
   off the page until the real value lands in src/data/ishaan.ts. */
const isTBD = (v: string) => v.includes(TBD);

/* Hero film. The still render stays on as the poster, so the first paint is
   instant and reduced-motion visitors keep the premium frame. */
const heroVideo = "/images/projects/ishaan.mp4";

const pageTitle = `Ishaan — G+4 Residential, Karanjade · ${brand.name}`;
const pageDesc =
  "Ishaan by Nesting Tree — a G+4 building at Karanjade, Navi Mumbai. Twelve homes, every one of them a 1RK, with no commercial units in the building.";

/* This page's Residence node, emitted into <head> beside the site-wide
   Organization one. Every value is read from src/data/ishaan.ts — see
   src/lib/structured-data.ts before changing anything about it. Ishaan
   is not RERA-registered, so the node carries no identifier: that is
   the `maharera: TBD` in the data file doing its job. */
const schema = residenceSchema(ishaan, gallery, new URL(Astro.site!));
---

<BaseLayout title={pageTitle} description={pageDesc} image="/images/og/ishaan.jpg" schema={schema}>
  <!-- ============================ NAVBAR ============================ -->
  <SiteHeader sections={sections} ctaHref="#enquire" project="Ishaan" />

  <!-- ============================ HERO ============================ -->
  <section id="top" class="relative h-[100svh] min-h-[680px] w-full overflow-hidden bg-ink">
    <video
      id="hero-video"
      class="hero-img-reveal absolute top-0 left-0 w-full h-full object-cover"
      style={`object-position:${ishaan.heroPosition}`}
      src={heroVideo}
      poster={ishaan.hero}
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-label="Ishaan — residential building by Nesting Tree, Karanjade, Navi Mumbai"></video>
    <!-- top scrim for nav legibility + bottom scrim for copy -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/45 via-transparent to-transparent"></div>

    <div
      class="relative h-full max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col justify-end pb-16 lg:pb-24"
    >
      <!-- breadcrumb -->
      <nav
        class="hero-rise font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.18em] text-white/65 mb-7"
        style="--rise-d:0.15s"
      >
        <a href="/projects" class="hover:text-white transition-colors">Projects</a>
        <span class="mx-2.5 text-white/35">/</span>
        <span class="text-olive-100">Ishaan</span>
      </nav>

      <!-- status + rera pills -->
      <div class="hero-rise flex flex-wrap items-center gap-2.5 mb-7" style="--rise-d:0.28s">
        <span
          class="inline-flex items-center gap-2 font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-olive text-white px-3.5 py-1.5 rounded-[2px]"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-olive-100"></span>
          {ishaan.status}
        </span>
        {
          ishaan.pills.map((p) => (
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-white/12 text-white border border-white/25 px-3.5 py-1.5 rounded-[2px] backdrop-blur-sm">
              {p}
            </span>
          ))
        }
        {
          /* The MahaRERA pill appears once the number is supplied. */
          !isTBD(ishaan.maharera) && (
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-white/12 text-white border border-white/25 px-3.5 py-1.5 rounded-[2px] backdrop-blur-sm">
              MahaRERA {ishaan.maharera}
            </span>
          )
        }
      </div>

      <h1
        class="hero-rise font-display font-bold text-white text-[3.5rem] sm:text-8xl lg:text-[8.5rem] leading-[0.9] tracking-tight"
        style="--rise-d:0.4s"
      >
        Ishaan
      </h1>
      <p
        class="hero-rise text-white/80 text-lg sm:text-xl lg:text-2xl mt-7 max-w-2xl leading-relaxed"
        style="--rise-d:0.54s"
      >
        {ishaan.tagline}
      </p>

      <p
        class="hero-rise flex items-start gap-2.5 text-white/65 text-sm sm:text-base mt-8 max-w-xl leading-relaxed"
        style="--rise-d:0.66s"
      >
        <svg
          class="w-4.5 h-4.5 mt-0.5 shrink-0 text-olive-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={pin}
        ></svg>
        {ishaan.address}
      </p>
    </div>
  </section>

  <!-- ====================== HEADLINE STATS BAND ====================== -->
  <section class="bg-ink text-stone border-t border-white/10">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {
          heroStats.map((s, i) => (
            <div
              class={`reveal py-12 lg:py-16 px-2 sm:px-4 lg:px-8 ${
                i % 2 === 1 ? "border-l border-white/10" : ""
              } ${i >= 2 ? "border-t border-white/10 lg:border-t-0" : ""} ${
                i !== 0 ? "lg:border-l lg:border-white/10" : ""
              }`}
              style={`--reveal-d:${(i * 0.08).toFixed(2)}s`}
            >
              <p class="font-display font-bold text-5xl sm:text-6xl lg:text-7xl tracking-tight text-white leading-none">
                {s.figure}
              </p>
              <p class="font-display text-xs sm:text-sm font-bold uppercase tracking-[0.16em] text-olive-100 mt-4">
                {s.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ OVERVIEW ============================ -->
  <section id="overview" class="bg-stone py-24 lg:py-32 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">
        <!-- main column -->
        <div class="lg:col-span-8">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >Project overview</span
          >
          <h2
            class="reveal font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05] max-w-2xl"
            style="--reveal-d:0.08s"
          >
            Twelve homes, one plan
          </h2>
          <p
            class="reveal text-muted text-lg sm:text-xl leading-relaxed mt-7 max-w-2xl"
            style="--reveal-d:0.16s"
          >
            {overview.intro}
          </p>

          <!-- key facts — a fact we have not been given is dropped from the
               list entirely rather than printed as a placeholder -->
          <dl class="reveal mt-12 border-t border-line">
            {
              overview.facts
                .filter((f) => !isTBD(f.value))
                .map((f) => (
                  <div class="grid sm:grid-cols-3 gap-2 sm:gap-8 py-6 border-b border-line">
                    <dt class="font-display text-xs font-bold uppercase tracking-[0.14em] text-muted pt-1">
                      {f.label}
                    </dt>
                    <dd class="sm:col-span-2 font-display font-semibold text-lg lg:text-xl tracking-tight text-ink">
                      {f.value}
                    </dd>
                  </div>
                ))
            }
          </dl>

          <!-- unit mix — three tiles; the mix really is one line -->
          <div class="reveal mt-14">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Unit mix</span
            >
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-px bg-line border border-line mt-5">
              {
                overview.unitMix.map((u) => (
                  <div class="bg-card p-6 lg:p-8">
                    <p class="font-display font-bold text-4xl lg:text-5xl tracking-tight text-ink leading-none">
                      {u.figure}
                    </p>
                    <p class="text-muted text-sm leading-snug mt-3">{u.label}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- location & connectivity -->
          <div class="reveal mt-14 bg-olive-50 border border-olive-100 rounded-[3px] p-8 lg:p-10">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Location & connectivity</span
            >
            <p class="text-inksoft text-lg leading-relaxed mt-4 max-w-2xl">
              {overview.connectivity}
            </p>
            <a
              href={ishaan.mapsUrl}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 font-display font-bold uppercase tracking-[0.06em] text-sm text-olive-600 mt-7"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={pin}
              ></svg>
              View on Google Maps
              <svg
                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={arrow}
              ></svg>
            </a>
          </div>
        </div>

        <!-- sticky enquiry rail -->
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <div class="reveal reveal-right bg-ink text-stone rounded-[4px] p-8 lg:p-9">
              <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-100"
                >Register your interest</span
              >
              <p class="font-display font-bold text-2xl lg:text-3xl tracking-tight mt-3 leading-tight">
                Talk to the Ishaan sales team.
              </p>
              <p class="text-stone/60 text-base leading-relaxed mt-4">
                Ishaan is pre-launch. Register early for pricing and first access when bookings open.
              </p>

              <a
                href={sales.phoneHref}
                class="flex items-center gap-4 mt-8 pt-7 border-t border-white/10 group"
              >
                <span
                  class="w-11 h-11 rounded-full bg-olive/25 border border-olive-100/30 flex items-center justify-center shrink-0 text-olive-100"
                >
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"
                    ></path></svg
                  >
                </span>
                <span>
                  <span
                    class="block font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/50"
                    >{sales.name} · Sales</span
                  >
                  <span
                    class="block font-display font-bold text-xl tracking-tight group-hover:text-olive-100 transition-colors"
                    >{sales.phone}</span
                  >
                </span>
              </a>

              <p class="flex items-start gap-3 mt-6 text-stone/60 text-sm leading-relaxed">
                <svg
                  class="w-4.5 h-4.5 mt-0.5 shrink-0 text-olive-100"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.lobby}
                ></svg>
                <span><span class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/45 block mb-1">Office</span>{sales.office}</span>
              </p>

              <a
                href="#enquire"
                class="block text-center font-display font-bold uppercase tracking-[0.06em] text-sm bg-white text-ink px-6 py-4 rounded-[2px] mt-8 hover:bg-stone transition-colors"
                >Enquire about Ishaan</a
              >

              <!-- Second path, not a replacement: the button above still goes
                   to the enquiry form, which is what captures a lead. This one
                   is for the visitor who would rather just message. -->
              <a
                href={whatsappHref(`Hi ${brand.name}, I'd like to know more about Ishaan.`)}
                target="_blank"
                rel="noopener"
                class="block text-center font-display font-bold uppercase tracking-[0.06em] text-sm border border-white/40 text-white px-6 py-4 rounded-[2px] mt-3 hover:bg-white/10 transition-colors"
                >WhatsApp us</a
              >
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===================== UNIT TYPES — THE FLAT LAYOUTS ===================== -->
  <section id="units" class="bg-card py-24 lg:py-32 border-t border-line scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="reveal max-w-3xl mb-16 lg:mb-24">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Flat layout</span
        >
        <h2
          class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          One of a kind, twelve times over.
        </h2>
        <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">
          Twelve homes, three to a typical floor, and every one of them a 1RK.
        </p>
      </div>

      <div class="flex flex-col gap-24 lg:gap-32">
        {
          unitTypes.map((u, i) => (
            /* No `plan` → no image column, and the details run full
               width rather than leaving half the row empty. See the
               note on `UnitType.plan` in src/data/ishaan.ts. */
            <article
              class={`reveal grid gap-12 lg:gap-20 items-center ${u.plan ? "lg:grid-cols-2" : ""}`}
            >
              {/* flat layout render */}
              {u.plan && (
                <div class={`relative ${i % 2 === 1 ? "lg:order-2" : ""}`}>
                  <div class="absolute -inset-3 sm:-inset-5 bg-olive-50 rounded-[4px] -z-0" />
                  <div class="relative bg-stone border border-line rounded-[3px] p-4 sm:p-6 lg:p-8">
                    <img
                      src={u.plan}
                      alt={
                        u.planPending
                          ? `Ishaan ${u.type} — layout drawing not yet available`
                          : `Ishaan ${u.type} flat layout`
                      }
                      class={`w-full h-auto object-contain rounded-[2px] ${
                        u.planPending ? "opacity-60" : "mix-blend-multiply"
                      }`}
                      loading="lazy"
                    />
                    <span
                      class={`absolute top-7 left-7 font-display text-[11px] font-bold uppercase tracking-[0.14em] px-3 py-1.5 rounded-[2px] ${
                        u.planPending
                          ? "bg-stone text-muted border border-dashed border-line"
                          : "bg-ink text-stone"
                      }`}
                    >
                      {u.planPending ? "Layout pending" : "Flat layout"}
                    </span>
                    {u.planPending && (
                      <p class="text-mutedlight text-xs leading-relaxed mt-4 italic">
                        Placeholder image — the {u.type} layout drawing has not been supplied yet.
                      </p>
                    )}
                  </div>
                </div>
              )}

              {/* details */}
              <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="font-display font-bold text-4xl lg:text-5xl tracking-tight">
                    {u.type}
                  </h3>
                  <span class="font-display text-xs font-bold uppercase tracking-[0.12em] bg-olive-100 text-olive-dark px-3 py-1.5 rounded-full">
                    {u.units}
                  </span>
                </div>
                {/* No series on file — print nothing. Fill `series` in
                    src/data/ishaan.ts and the line comes back. */}
                {!isTBD(u.series) && (
                  <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-olive-600 mt-4">
                    {u.series}
                  </p>
                )}
                <p class="text-muted text-lg leading-relaxed mt-6 max-w-md">{u.blurb}</p>

                {/* RERA carpet figures from the approved plan */}
                <AreaStats stats={u.stats} heading="Areas — approved plan" class="mt-9 max-w-md" />

                {/* The green-tick feature list that used to sit here was
                    removed on the owner's instruction — a ticked bullet
                    reads as a promise about the delivered flat. The TBD
                    placeholder went with it: there is nothing pending to
                    fill in. What the home is stays with the approved plan
                    above and the drawing alongside. Do not reinstate it. */}
              </div>
            </article>
          ))
        }
      </div>

      {
        features.areaStats && (
          <p class="reveal text-mutedlight text-xs leading-relaxed mt-16 lg:mt-20 max-w-3xl">
            {unitTypesNote}
          </p>
        )
      }
    </div>
  </section>

  <!-- ============================ FLOOR PLANS ============================ -->
  <section id="floorplans" class="bg-stone py-24 lg:py-32 border-t border-line scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="reveal max-w-3xl mb-16 lg:mb-24">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Floor plans</span
        >
        <h2
          class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          How Ishaan is laid out.
        </h2>
        <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">
          Twelve homes stacked above a ground floor kept for the building itself.
        </p>
      </div>

      <div class="flex flex-col gap-24 lg:gap-32">
        {
          floorPlans.map((fp, i) => (
            /* No `plan` → no image column, details full width. See the
               note on `FloorPlan.plan` in src/data/ishaan.ts. */
            <article
              class={`reveal grid gap-12 lg:gap-20 items-center ${fp.plan ? "lg:grid-cols-2" : ""}`}
            >
              {/* floor-plan render */}
