  <style>
    /* ============================================================
       Scroll-scrubbed reel. A tall section pins the video; scroll through
       the section maps 1:1 onto the clip's timeline. Badges cross-fade at
       the supplied timestamps. Static (no-JS / reduced-motion) fallback:
       the section collapses to one viewport with a plainly looping video
       and all badges hidden but the first.
       ============================================================ */
    .pvid {
      position: relative;
      /* scrub track: the taller this is, the slower/steadier the scrub.
         ~100vh of it is pinned, the rest is the scroll distance. */
      height: 360vh;
    }
    .pvid-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    .pvid-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      background: #0f120a;
    }
    .pvid-scrim {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(to top, rgba(15, 18, 10, 0.72) 0%, rgba(15, 18, 10, 0) 42%),
        linear-gradient(to bottom, rgba(15, 18, 10, 0.5) 0%, rgba(15, 18, 10, 0) 30%);
    }

    .pvid-head {
      position: absolute;
      top: clamp(1.5rem, 5vh, 3rem);
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      pointer-events: none;
    }
    .pvid-eyebrow {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.24em;
      color: var(--color-olive-100);
      background: rgba(15, 18, 10, 0.35);
      backdrop-filter: blur(4px);
      padding: 0.5rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 2px;
    }

    /* --- badges: stacked lower-left, one shown at a time when live --- */
    .pvid-badges {
      position: absolute;
      left: clamp(1.25rem, 5vw, 4rem);
      bottom: clamp(3.5rem, 9vh, 6rem);
      max-width: min(90vw, 30rem);
    }
    .pvid-badge {
      margin: 0;
      grid-area: 1 / 1;
    }
    /* When live, all badges overlap in one cell and we fade between them. */
    .pvid-live .pvid-badges {
      display: grid;
    }
    .pvid-live .pvid-badge {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .pvid-live .pvid-badge.is-active {
      opacity: 1;
      transform: none;
    }
    /* Static fallback: show only the first badge, no overlap. */
    .pvid:not(.pvid-live) .pvid-badge:not(:first-child) {
      display: none;
    }

    .pvid-badge figcaption {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      background: rgba(15, 18, 10, 0.44);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-left: 3px solid var(--color-olive);
      border-radius: 3px;
      padding: 1.25rem 1.5rem;
    }
    .pvid-badge-kicker {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-olive-100);
    }
    .pvid-badge-title {
      font-weight: 900;
      font-size: clamp(1.6rem, 3.2vw, 2.4rem);
      line-height: 1.02;
      letter-spacing: -0.01em;
      color: #fff;
    }
    .pvid-badge-sub {
      font-size: clamp(0.95rem, 1.4vw, 1.1rem);
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.72);
    }

    /* --- timeline ticks --- */
    .pvid-ticks {
      position: absolute;
      right: clamp(1.25rem, 5vw, 4rem);
      bottom: clamp(3.5rem, 9vh, 6rem);
      display: flex;
      gap: 0.5rem;
    }
    .pvid-tick {
      width: 2rem;
      height: 3px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.28);
      transition: background 0.35s ease;
    }
    .pvid-tick.is-on {
      background: var(--color-olive-100);
    }
    .pvid:not(.pvid-live) .pvid-ticks {
      display: none;
    }

    /* --- scroll hint --- */
    .pvid-hint {
      position: absolute;
      left: 50%;
      bottom: clamp(1rem, 3vh, 2rem);
      transform: translateX(-50%);
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: rgba(255, 255, 255, 0.7);
      transition: opacity 0.4s ease;
    }
    .pvid:not(.pvid-live) .pvid-hint {
      display: none;
    }
    .pvid-hint.is-hidden {
      opacity: 0;
    }

    /* Reduced motion: don't pin/scrub — one viewport, plain loop. */
    @media (prefers-reduced-motion: reduce) {
      .pvid {
        height: auto;
      }
      .pvid-sticky {
        position: relative;
        height: 100vh;
      }
    }
  </style>

  <script is:inline>
    // Hero film holds on its poster frame for reduced-motion visitors.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const heroVideo = document.getElementById("hero-video");
      if (heroVideo) {
        heroVideo.removeAttribute("autoplay");
        heroVideo.pause();
      }
    }

    // Scroll-reveal: fade/lift elements in as they enter the viewport.
    // Only wired up when the head guard enabled reveal-on (JS + motion OK).
    if (document.documentElement.classList.contains("reveal-on")) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      document
        .querySelectorAll(".reveal, .reveal-img")
        .forEach((el) => io.observe(el));
    }
  </script>

  <script is:inline>
    // Scroll-scrubbed reel: map scroll through the pinned section onto the
    // clip's currentTime, and cross-fade the badge whose timestamp we've most
    // recently passed. Only wired up when reveal-on (JS + motion OK); else the
    // video just loops on its own.
    (function () {
      const section = document.querySelector("[data-pvid]");
      if (!section) return;
      const video = section.querySelector("[data-reel-el]");
      const badges = Array.from(section.querySelectorAll("[data-reel-badge]"));
      const ticks = Array.from(section.querySelectorAll(".pvid-tick"));
      const hint = section.querySelector("[data-reel-hint]");
      if (!video) return;

      const live = document.documentElement.classList.contains("reveal-on");

      if (!live) {
        // Fallback: just play the muted loop.
        video.autoplay = true;
        const play = () => video.play().catch(() => {});
        if (video.readyState >= 2) play();
        else video.addEventListener("loadeddata", play, { once: true });
        return;
      }

      section.classList.add("pvid-live");

      const times = badges.map((b) => parseFloat(b.dataset.t) || 0);

      let duration = 0;
      let ready = false;
      video.addEventListener("loadedmetadata", () => {
        duration = video.duration || 0;
        ready = true;
        update(); // paint initial frame/badge
      });
      // In case metadata is already available.
      if (video.readyState >= 1 && video.duration) {
        duration = video.duration;
        ready = true;
      }

      let activeBadge = -1;
      function setBadge(i) {
        if (i === activeBadge) return;
        activeBadge = i;
        badges.forEach((b, idx) => b.classList.toggle("is-active", idx === i));
        ticks.forEach((t, idx) => t.classList.toggle("is-on", idx <= i));
      }

      let raf = 0;
      function update() {
        raf = 0;
        if (!ready || !duration) return;
        const rect = section.getBoundingClientRect();
        const scrollable = section.offsetHeight - window.innerHeight;
        const progress = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;

        // Nudge in a hair from the ends so we always land on a decoded frame.
        const t = clamp(progress * duration, 0, Math.max(0, duration - 0.05));
        // Seeking every frame can thrash the decoder — only seek on real change.
        if (Math.abs(video.currentTime - t) > 0.03) {
          try {
            video.currentTime = t;
          } catch (e) {}
        }

        // Which badge timestamp have we most recently passed?
        let idx = -1;
        for (let i = 0; i < times.length; i++) if (t >= times[i]) idx = i;
        setBadge(idx);

        if (hint) hint.classList.toggle("is-hidden", progress > 0.02);
      }

      function onScroll() {
        if (!raf) raf = requestAnimationFrame(update);
      }

      // Keep the decoder warm without actually playing.
      video.pause();

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();

      function clamp(v, lo, hi) {
        return v < lo ? lo : v > hi ? hi : v;
      }
    })();
  </script>
</BaseLayout>
