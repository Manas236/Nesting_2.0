---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import QrBlock from "../../components/QrBlock.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import { brand, contact, projects } from "../../data/site";
import {
  rudra,
  sales,
  heroStats,
  overview,
  floorPlans,
  homeConfigs,
  amenityGroups,
  developerNotes,
  whyRudra,
  gallery,
} from "../../data/rudra";

/* ---------- Line-icon set (24×24, stroke currentColor) ----------
   Keyed to the `icon` fields in src/data/rudra.ts. Kept here as
   presentation, the way the homepage keeps its amenity icons.     */
const icons: Record<string, string> = {
  tower: `<rect x="7" y="3" width="10" height="18" rx="1"/><path d="M4 21h16"/><path d="M10.5 7h.01M13.5 7h.01M10.5 11h.01M13.5 11h.01M10.5 15h.01M13.5 15h.01"/>`,
  elevator: `<rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M12 2.5v19"/><path d="m9.6 8.5-1.1 1.6h2.2z"/><path d="m9.6 15.5-1.1-1.6h2.2z"/><path d="M14.5 9h2.5M14.5 12h2.5M14.5 15h2.5"/>`,
  lobby: `<path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/><path d="M4 21h16"/><path d="M14.2 12h.01"/>`,
  parking: `<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M9.5 16.5v-9h3.4a2.8 2.8 0 0 1 0 5.6H9.5"/>`,
  bolt: `<path d="M13 3 5 13.5h5.5L9 21l8-10.5h-5.5z"/>`,
  waterproof: `<path d="M12 3 5 6v5c0 4.6 3 8.1 7 9 4-.9 7-4.4 7-9V6z"/><path d="M12 9.5c1.2 1.6 2 2.7 2 3.7a2 2 0 0 1-4 0c0-1 .8-2.1 2-3.7z"/>`,
  rooftop: `<circle cx="12" cy="12.5" r="3.2"/><path d="M12 4.5v2M5 12.5H3.2M20.8 12.5H19M6.9 7.4 5.7 6.2M18.3 6.2l-1.2 1.2"/><path d="M3 20.5h18"/>`,
  shop: `<path d="M3.5 9 5 5h14l1.5 4z"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-5.5h5V20"/>`,
  star: `<path d="m12 4 2.3 5 5.4.5-4.1 3.6 1.3 5.3L12 16.6 7.1 18.4l1.3-5.3-4.1-3.6 5.4-.5z"/>`,
  people: `<circle cx="9" cy="8.5" r="2.5"/><circle cx="16" cy="9.5" r="2"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><path d="M15.5 14c2.6 0 4.5 2 4.5 4.5"/>`,
  window: `<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M12 3v18M4 12h16"/>`,
  tiles: `<rect x="3.5" y="3.5" width="17" height="17" rx="1"/><path d="M3.5 12h17M12 3.5v17"/>`,
  faucet: `<path d="M12 3.5c2.6 3.7 4.2 6.2 4.2 8.3a4.2 4.2 0 0 1-8.4 0c0-2.1 1.6-4.6 4.2-8.3z"/>`,
  wall: `<rect x="3.5" y="5" width="17" height="14" rx="1"/><path d="M3.5 9.7h17M3.5 14.3h17M9 5v4.7M15 5v4.7M6 9.7v4.6M12 9.7v4.6M18 9.7v4.6M9 14.3V19M15 14.3V19"/>`,
};

const arrow = `<path d="M5 12h14M13 6l6 6-6 6"/>`;
const pin = `<path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/>`;
const check = `<path d="m5 12.5 4 4 10-10"/>`;

/* ---------- Scroll-scrubbed reel ----------
   Rudra2.mp4 is scrubbed by scroll instead of playing on its own — scroll
   through the pinned section IS the video timeline. Each badge fades in
   when the clip's currentTime crosses its `t` (seconds) and stays until
   the next takes over. Timestamps: 00:01 / 00:05 / 00:08 / 00:10 (same as
   Prithvi — adjust the `t` values freely; copy is placeholder). The video
   is served all-keyframe (Rudra2-scrub.mp4) so the scrub stays smooth. */
const reelVideo = "/images/projects/Rudra2-scrub.mp4";
const reelBadges = [
  { t: 1, kicker: "Arrival", title: "Rudra, Karanjade", sub: "Where Nesting Tree began" },
  { t: 5, kicker: "Street level", title: "Four shops & parking", sub: "The ground floor" },
  { t: 8, kicker: "The homes", title: "Twenty above", sub: "One 1BHK, four 1RK layouts" },
  { t: 10, kicker: "Delivered", title: "Sold out & society-formed", sub: "The first proof" },
];

const sections = [
  { label: "Overview", href: "#overview" },
  { label: "Floor plans", href: "#floorplans" },
  { label: "Homes", href: "#homes" },
  { label: "Amenities", href: "#amenities" },
  { label: "Gallery", href: "#gallery" },
];

/* Hero film. The still render stays on as the poster, so the first paint is
   instant and reduced-motion visitors keep the premium frame. Distinct from
   `reelVideo` above, which is the scroll-scrubbed clip further down the page. */
const heroVideo = "/images/projects/Rudrar_Backdrop.mp4";

const pageTitle = `Rudra — Delivered G+4 Residential & Commercial, Karanjade · ${brand.name}`;
const pageDesc =
  "Rudra by Nesting Tree — the company's first delivered project. A completed, sold-out, society-formed G+4 building of 20 homes and 4 shops at Sector R2, Karanjade, Navi Mumbai. MahaRERA P52000026245.";
---

<BaseLayout title={pageTitle} description={pageDesc} image={rudra.hero}>
  <!-- ============================ NAVBAR ============================ -->
  <SiteHeader sections={sections} ctaHref="#enquire" />

  <!-- ============================ HERO ============================ -->
  <section id="top" class="relative h-[100svh] min-h-[680px] w-full overflow-hidden bg-ink">
    <video
      id="hero-video"
      class="hero-img-reveal absolute top-0 left-0 w-full h-full object-cover object-[center_28%] lg:object-[center_22%]"
      src={heroVideo}
      poster={rudra.hero}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Rudra — delivered residential & commercial building by Nesting Tree, Karanjade"></video>
    <!-- top scrim for nav legibility + bottom scrim for copy -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/45 via-transparent to-transparent"></div>

    <div
      class="relative h-full max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col justify-end pb-16 lg:pb-24"
    >
      <!-- breadcrumb -->
      <nav class="hero-rise font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.18em] text-white/65 mb-7" style="--rise-d:0.15s">
        <a href="/projects" class="hover:text-white transition-colors">Projects</a>
        <span class="mx-2.5 text-white/35">/</span>
        <span class="text-olive-100">Rudra</span>
      </nav>

      <!-- status + proof pills -->
      <div class="hero-rise flex flex-wrap items-center gap-2.5 mb-7" style="--rise-d:0.28s">
        <span
          class="inline-flex items-center gap-2 font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-olive text-white px-3.5 py-1.5 rounded-[2px]"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={check}></svg>
          {rudra.status}
        </span>
        {
          rudra.pills.map((p) => (
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-white/12 text-white border border-white/25 px-3.5 py-1.5 rounded-[2px] backdrop-blur-sm">
              {p}
            </span>
          ))
        }
        <span
          class="font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-white/12 text-white border border-white/25 px-3.5 py-1.5 rounded-[2px] backdrop-blur-sm"
        >
          MahaRERA {rudra.maharera}
        </span>
      </div>

      <h1
        class="hero-rise font-display font-black text-white text-[3.5rem] sm:text-8xl lg:text-[8.5rem] leading-[0.9] tracking-tight"
        style="--rise-d:0.4s"
      >
        Rudra
      </h1>
      <p class="hero-rise text-white/80 text-lg sm:text-xl lg:text-2xl mt-7 max-w-2xl leading-relaxed" style="--rise-d:0.54s">
        {rudra.tagline}
      </p>

      <p class="hero-rise flex items-start gap-2.5 text-white/65 text-sm sm:text-base mt-8 max-w-xl leading-relaxed" style="--rise-d:0.66s">
        <svg
          class="w-4.5 h-4.5 mt-0.5 shrink-0 text-olive-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={pin}
        ></svg>
        {rudra.address}
      </p>
    </div>
  </section>

  <!-- ====================== HEADLINE STATS BAND ====================== -->
  <section class="bg-ink text-stone border-t border-white/10">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {
          heroStats.map((s, i) => (
            <div
              class={`reveal py-12 lg:py-16 px-2 sm:px-4 lg:px-8 ${
                i % 2 === 1 ? "border-l border-white/10" : ""
              } ${i >= 2 ? "border-t border-white/10 lg:border-t-0" : ""} ${
                i !== 0 ? "lg:border-l lg:border-white/10" : ""
              }`}
              style={`--reveal-d:${(i * 0.08).toFixed(2)}s`}
            >
              <p class="font-display font-black text-5xl sm:text-6xl lg:text-7xl tracking-tight text-white leading-none">
                {s.figure}
              </p>
              <p class="font-display text-xs sm:text-sm font-bold uppercase tracking-[0.16em] text-olive-100 mt-4">
                {s.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ OVERVIEW ============================ -->
  <section id="overview" class="bg-stone py-24 lg:py-32 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">
        <!-- main column -->
        <div class="lg:col-span-8">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >Project overview</span
          >
          <h2
            class="reveal font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05] max-w-2xl" style="--reveal-d:0.08s"
          >
            Where Nesting Tree began
          </h2>
          <p class="reveal text-muted text-lg sm:text-xl leading-relaxed mt-7 max-w-2xl" style="--reveal-d:0.16s">
            {overview.intro}
          </p>

          <!-- key facts -->
          <dl class="reveal mt-12 border-t border-line">
            {
              overview.facts.map((f) => (
                <div class="grid sm:grid-cols-3 gap-2 sm:gap-8 py-6 border-b border-line">
                  <dt class="font-display text-xs font-bold uppercase tracking-[0.14em] text-muted pt-1">
                    {f.label}
                  </dt>
                  <dd class="sm:col-span-2 font-display font-semibold text-lg lg:text-xl tracking-tight text-ink">
                    {f.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          <!-- space mix -->
          <div class="reveal mt-14">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Space mix</span
            >
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line mt-5">
              {
                overview.spaceMix.map((u) => (
                  <div class="bg-card p-6 lg:p-8">
                    <p class="font-display font-black text-3xl lg:text-4xl tracking-tight text-ink leading-none">
                      {u.figure}
                    </p>
                    <p class="text-muted text-sm leading-snug mt-3">{u.label}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- highlights at a glance -->
          <div class="reveal mt-14">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Highlights at a glance</span
            >
            <ul class="grid sm:grid-cols-2 gap-x-10 gap-y-4 mt-6 max-w-2xl">
              {
                overview.highlights.map((h) => (
                  <li class="flex items-start gap-3 text-ink border-b border-line pb-4">
                    <svg
                      class="w-5 h-5 mt-0.5 shrink-0 text-olive-600"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={check}
                    />
                    <span class="text-base leading-snug">{h}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- location & connectivity -->
          <div class="reveal mt-14 bg-olive-50 border border-olive-100 rounded-[3px] p-8 lg:p-10">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Location & connectivity</span
            >
            <p class="text-inksoft text-lg leading-relaxed mt-4 max-w-2xl">
              {overview.connectivity}
            </p>
            <a
              href={rudra.mapsUrl}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 font-display font-bold uppercase tracking-[0.06em] text-sm text-olive-600 mt-7"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={pin}
              ></svg>
              View on Google Maps
              <svg
                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={arrow}
              ></svg>
            </a>
          </div>
        </div>

        <!-- sticky "completed & sold out" rail -->
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <div class="reveal reveal-right bg-ink text-stone rounded-[4px] p-8 lg:p-9">
              <span class="inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-100"
                >Completed & sold out</span
              >
              <p class="font-display font-black text-2xl lg:text-3xl tracking-tight mt-3 leading-tight">
                Delivered, sold and society-formed.
              </p>
              <p class="text-stone/60 text-base leading-relaxed mt-4">
                Every home and shop at Rudra is sold and handed over, with the residents' society
                now formed. For resale enquiries or to ask about other Nesting Tree projects, get
                in touch.
              </p>

              <a
                href={sales.phoneHref}
                class="flex items-center gap-4 mt-8 pt-7 border-t border-white/10 group"
              >
                <span
                  class="w-11 h-11 rounded-full bg-olive/25 border border-olive-100/30 flex items-center justify-center shrink-0 text-olive-100"
                >
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"
                    ></path></svg
                  >
                </span>
                <span>
                  <span class="block font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/50"
                    >{sales.name} · Sales</span
                  >
                  <span class="block font-display font-bold text-xl tracking-tight group-hover:text-olive-100 transition-colors"
                    >{sales.phone}</span
                  >
                </span>
              </a>

              <p class="flex items-start gap-3 mt-6 text-stone/60 text-sm leading-relaxed">
                <svg
                  class="w-4.5 h-4.5 mt-0.5 shrink-0 text-olive-100"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.lobby}
                ></svg>
                <span><span class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/45 block mb-1">Office</span>{sales.office}</span>
              </p>

              <a
                href="#enquire"
                class="block text-center font-display font-bold uppercase tracking-[0.06em] text-sm bg-white text-ink px-6 py-4 rounded-[2px] mt-8 hover:bg-stone transition-colors"
                >Enquire about Rudra</a
              >
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============================ FLOOR PLANS ============================ -->
  <section id="floorplans" class="bg-card py-24 lg:py-32 border-t border-line scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="reveal max-w-3xl mb-16 lg:mb-24">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Floor plans</span
        >
        <h2
          class="font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          How Rudra is laid out.
        </h2>
        <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">
          Shops and parking on the ground floor; five homes — one 1BHK and four 1RK — on each of
          the four upper floors.
        </p>
      </div>

      <div class="flex flex-col gap-24 lg:gap-32">
        {
          floorPlans.map((fp, i) => (
            <article class="reveal grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
              {/* floor-plan render */}
              <div class={`relative ${i % 2 === 1 ? "lg:order-2" : ""}`}>
                <div class="absolute -inset-3 sm:-inset-5 bg-olive-50 rounded-[4px] -z-0" />
                <div class="relative bg-stone border border-line rounded-[3px] p-4 sm:p-6 lg:p-8">
                  <img
                    src={fp.plan}
                    alt={`Rudra ${fp.title} plan — ${fp.label}`}
                    class="w-full h-auto object-contain rounded-[2px] mix-blend-multiply"
                    loading="lazy"
                  />
                  <span class="absolute top-7 left-7 font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-ink text-stone px-3 py-1.5 rounded-[2px]">
                    Floor plan
                  </span>
                </div>
              </div>

              {/* details */}
              <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                <h3 class="font-display font-black text-4xl lg:text-5xl tracking-tight">
                  {fp.title}
                </h3>
                <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-olive-600 mt-4">
                  {fp.label}
                </p>
                <p class="text-muted text-lg leading-relaxed mt-6 max-w-md">{fp.blurb}</p>

                <ul class="mt-8 grid sm:grid-cols-2 gap-x-8 gap-y-3.5 max-w-lg">
                  {fp.points.map((pt) => (
                    <li class="flex items-start gap-3 text-ink">
                      <svg
                        class="w-5 h-5 mt-0.5 shrink-0 text-olive-600"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={check}
                      />
                      <span class="text-base leading-snug">{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== SCROLL-SCRUBBED REEL =====================
       Rudra2.mp4 is pinned; scroll scrubs its timeline. Badges cross-fade
       at the supplied timestamps. Gated on `reveal-on` (JS + motion OK) —
       otherwise it falls back to a plain looping muted video. -->
  <section id="reel" class="pvid bg-ink" data-pvid data-reel-video={reelVideo} aria-label="Rudra walkthrough">
    <div class="pvid-sticky">
      <video
        class="pvid-video"
        data-reel-el
        src={reelVideo}
        muted
        playsinline
        preload="auto"
        loop
        poster={rudra.hero}
      ></video>

      <!-- readability scrims -->
      <div class="pvid-scrim" aria-hidden="true"></div>

      <!-- section eyebrow -->
      <div class="pvid-head">
        <span class="pvid-eyebrow font-display">The walkthrough</span>
      </div>

      <!-- cross-fading badges (only the active one shows when live) -->
      <div class="pvid-badges" data-reel-badges>
        {
          reelBadges.map((b, i) => (
            <figure class="pvid-badge" data-reel-badge data-t={b.t} data-index={i}>
              <figcaption>
                <span class="pvid-badge-kicker font-display">{b.kicker}</span>
                <span class="pvid-badge-title font-display">{b.title}</span>
                <span class="pvid-badge-sub">{b.sub}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <!-- timeline ticks — one per badge, fills as the scrub passes each -->
      <div class="pvid-ticks" data-reel-ticks aria-hidden="true">
        {reelBadges.map((_, i) => <span class="pvid-tick" data-index={i} />)}
      </div>

      <!-- scroll hint (fades once scrubbing starts) -->
      <span class="pvid-hint font-display" data-reel-hint>Scroll to play</span>
    </div>
  </section>

  <!-- ===================== HOME CONFIGURATIONS ===================== -->
  <section id="homes" class="bg-stone py-24 lg:py-32 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="reveal max-w-3xl mb-16 lg:mb-20">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Home configurations</span
        >
        <h2
          class="font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          One 1BHK, four 1RK layouts.
        </h2>
        <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">
          Rudra pairs a large 1BHK with a range of efficient 1RK homes — from a value 340 sq. ft.
          layout up to a spacious 450 sq. ft. plan.
        </p>
      </div>

