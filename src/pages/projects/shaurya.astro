---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import QrBlock from "../../components/QrBlock.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import { brand, contact, projects } from "../../data/site";
import {
  TBD,
  shaurya,
  sales,
  heroStats,
  overview,
  unitTypes,
  floorPlans,
  levels,
  amenityGroups,
  amenitiesNeeded,
  developerNotes,
  whyShaurya,
  gallery,
} from "../../data/shaurya";

/* ---------- Line-icon set (24Ã—24, stroke currentColor) ----------
   Keyed to the `icon` fields in src/data/shaurya.ts. Kept here as
   presentation, the way the other project pages keep their icons. */
const icons: Record<string, string> = {
  tower: `<rect x="7" y="3" width="10" height="18" rx="1"/><path d="M4 21h16"/><path d="M10.5 7h.01M13.5 7h.01M10.5 11h.01M13.5 11h.01M10.5 15h.01M13.5 15h.01"/>`,
  elevator: `<rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M12 2.5v19"/><path d="m9.6 8.5-1.1 1.6h2.2z"/><path d="m9.6 15.5-1.1-1.6h2.2z"/><path d="M14.5 9h2.5M14.5 12h2.5M14.5 15h2.5"/>`,
  lobby: `<path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/><path d="M4 21h16"/><path d="M14.2 12h.01"/>`,
  parking: `<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M9.5 16.5v-9h3.4a2.8 2.8 0 0 1 0 5.6H9.5"/>`,
  star: `<path d="m12 4 2.3 5 5.4.5-4.1 3.6 1.3 5.3L12 16.6 7.1 18.4l1.3-5.3-4.1-3.6 5.4-.5z"/>`,
  window: `<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M12 3v18M4 12h16"/>`,
  grill: `<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M9 4v16M14 4v16M4 9h16M4 14h16"/>`,
  rooftop: `<circle cx="12" cy="12.5" r="3.2"/><path d="M12 4.5v2M5 12.5H3.2M20.8 12.5H19M6.9 7.4 5.7 6.2M18.3 6.2l-1.2 1.2"/><path d="M3 20.5h18"/>`,
  waterproof: `<path d="M12 3 5 6v5c0 4.6 3 8.1 7 9 4-.9 7-4.4 7-9V6z"/><path d="M12 9.5c1.2 1.6 2 2.7 2 3.7a2 2 0 0 1-4 0c0-1 .8-2.1 2-3.7z"/>`,
};

const arrow = `<path d="M5 12h14M13 6l6 6-6 6"/>`;
const pin = `<path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/>`;
const check = `<path d="m5 12.5 4 4 10-10"/>`;

/* A value we were never given renders muted and italic, so a gap
   always reads as a gap and never as a fact. */
const isTBD = (v: string) => v.includes(TBD);

const sections = [
  { label: "Overview", href: "#overview" },
  { label: "Homes", href: "#homes" },
  { label: "Floor plans", href: "#floorplans" },
  { label: "Amenities", href: "#amenities" },
  { label: "Gallery", href: "#gallery" },
  { label: "About", href: "#developer" },
];

/* Hero film. The still render stays on as the poster, so the first paint is
   instant and reduced-motion visitors keep the premium frame. */
const heroVideo = "/images/projects/Shaurya_Backdrop.mp4";

const pageTitle = `Shaurya â€” Delivered G+4 Residential, Karanjade Â· ${brand.name}`;
const pageDesc =
  "Shaurya by Nesting Tree â€” a completed, sold-out, purely residential G+4 building on a corner plot. Eight homes (4 Ã— 1BHK + 4 Ã— 1RK), an automatic high-speed lift and ample parking. Delivered and handed over.";
---

<BaseLayout title={pageTitle} description={pageDesc} image="/images/og/shaurya.jpg">
  <!-- ============================ NAVBAR ============================ -->
  <SiteHeader sections={sections} ctaHref="#enquire" />

  <!-- ============================ HERO ============================ -->
  <section id="top" class="relative h-[100svh] min-h-[680px] w-full overflow-hidden bg-ink">
    <video
      id="hero-video"
      class="hero-img-reveal absolute top-0 left-0 w-full h-full object-cover"
      style={`object-position:${shaurya.heroPosition}`}
      src={heroVideo}
      poster={shaurya.hero}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Shaurya â€” delivered residential building by Nesting Tree, Karanjade"></video>
    <!-- top scrim for nav legibility + bottom scrim for copy -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/45 via-transparent to-transparent"></div>

    <div
      class="relative h-full max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12 flex flex-col justify-end pb-16 lg:pb-24"
    >
      <!-- breadcrumb -->
      <nav
        class="hero-rise font-display text-[11px] sm:text-xs font-bold uppercase tracking-[0.18em] text-white/65 mb-7"
        style="--rise-d:0.15s"
      >
        <a href="/projects" class="hover:text-white transition-colors">Projects</a>
        <span class="mx-2.5 text-white/35">/</span>
        <span class="text-olive-100">Shaurya</span>
      </nav>

      <!-- status + proof pills -->
      <div class="hero-rise flex flex-wrap items-center gap-2.5 mb-7" style="--rise-d:0.28s">
        <span
          class="inline-flex items-center gap-2 font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-olive text-white px-3.5 py-1.5 rounded-[2px]"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={check}
          ></svg>
          {shaurya.status}
        </span>
        {
          shaurya.pills.map((p) => (
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-white/12 text-white border border-white/25 px-3.5 py-1.5 rounded-[2px] backdrop-blur-sm">
              {p}
            </span>
          ))
        }
        {
          /* The MahaRERA pill appears only once a number is supplied. */
          !isTBD(shaurya.maharera) && (
            <span class="font-display text-[11px] font-bold uppercase tracking-[0.14em] bg-white/12 text-white border border-white/25 px-3.5 py-1.5 rounded-[2px] backdrop-blur-sm">
              MahaRERA {shaurya.maharera}
            </span>
          )
        }
      </div>

      <h1
        class="hero-rise font-display font-black text-white text-[3.5rem] sm:text-8xl lg:text-[8.5rem] leading-[0.9] tracking-tight"
        style="--rise-d:0.4s"
      >
        Shaurya
      </h1>
      <p
        class="hero-rise text-white/80 text-lg sm:text-xl lg:text-2xl mt-7 max-w-2xl leading-relaxed"
        style="--rise-d:0.54s"
      >
        {shaurya.tagline}
      </p>

      <p
        class="hero-rise flex items-start gap-2.5 text-white/65 text-sm sm:text-base mt-8 max-w-xl leading-relaxed"
        style="--rise-d:0.66s"
      >
        <svg
          class="w-4.5 h-4.5 mt-0.5 shrink-0 text-olive-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={pin}
        ></svg>
        <span class={isTBD(shaurya.address) ? "italic text-white/45" : ""}>
          {isTBD(shaurya.address) ? `Address â€” ${TBD}` : shaurya.address}
        </span>
      </p>
    </div>
  </section>

  <!-- ====================== HEADLINE STATS BAND ====================== -->
  <section class="bg-ink text-stone border-t border-white/10">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {
          heroStats.map((s, i) => (
            <div
              class={`reveal py-12 lg:py-16 px-2 sm:px-4 lg:px-8 ${
                i % 2 === 1 ? "border-l border-white/10" : ""
              } ${i >= 2 ? "border-t border-white/10 lg:border-t-0" : ""} ${
                i !== 0 ? "lg:border-l lg:border-white/10" : ""
              }`}
              style={`--reveal-d:${(i * 0.08).toFixed(2)}s`}
            >
              <p class="font-display font-black text-5xl sm:text-6xl lg:text-7xl tracking-tight text-white leading-none">
                {s.figure}
              </p>
              <p class="font-display text-xs sm:text-sm font-bold uppercase tracking-[0.16em] text-olive-100 mt-4">
                {s.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ OVERVIEW ============================ -->
  <section id="overview" class="bg-stone py-24 lg:py-32 scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-20">
        <!-- main column -->
        <div class="lg:col-span-8">
          <span class="reveal font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
            >Project overview</span
          >
          <h2
            class="reveal font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05] max-w-2xl"
            style="--reveal-d:0.08s"
          >
            Eight homes, purely residential
          </h2>
          <p
            class="reveal text-muted text-lg sm:text-xl leading-relaxed mt-7 max-w-2xl"
            style="--reveal-d:0.16s"
          >
            {overview.intro}
          </p>

          <!-- key facts -->
          <dl class="reveal mt-12 border-t border-line">
            {
              overview.facts.map((f) => (
                <div class="grid sm:grid-cols-3 gap-2 sm:gap-8 py-6 border-b border-line">
                  <dt class="font-display text-xs font-bold uppercase tracking-[0.14em] text-muted pt-1">
                    {f.label}
                  </dt>
                  <dd
                    class={
                      isTBD(f.value)
                        ? "sm:col-span-2 text-mutedlight text-base italic pt-1"
                        : "sm:col-span-2 font-display font-semibold text-lg lg:text-xl tracking-tight text-ink"
                    }
                  >
                    {f.value}
                  </dd>
                </div>
              ))
            }
          </dl>

          <!-- unit mix -->
          <div class="reveal mt-14">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Unit mix</span
            >
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line mt-5">
              {
                overview.unitMix.map((u) => (
                  <div class="bg-card p-6 lg:p-8">
                    <p class="font-display font-black text-4xl lg:text-5xl tracking-tight text-ink leading-none">
                      {u.figure}
                    </p>
                    <p class="text-muted text-sm leading-snug mt-3">{u.label}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- location & connectivity -->
          <div class="reveal mt-14 bg-olive-50 border border-olive-100 rounded-[3px] p-8 lg:p-10">
            <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-600"
              >Location & connectivity</span
            >
            <p class="text-inksoft text-lg leading-relaxed mt-4 max-w-2xl">
              {overview.connectivity}
            </p>
            <a
              href={shaurya.mapsUrl}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2 font-display font-bold uppercase tracking-[0.06em] text-sm text-olive-600 mt-7"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={pin}
              ></svg>
              View on Google Maps
              <svg
                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={arrow}
              ></svg>
            </a>
          </div>
        </div>

        <!-- sticky "completed & sold out" rail -->
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <div class="reveal reveal-right bg-ink text-stone rounded-[4px] p-8 lg:p-9">
              <span class="inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-[0.2em] text-olive-100"
                >Completed & sold out</span
              >
              <p class="font-display font-black text-2xl lg:text-3xl tracking-tight mt-3 leading-tight">
                Delivered, sold and handed over.
              </p>
              <p class="text-stone/60 text-base leading-relaxed mt-4">
                Every home at Shaurya is sold and handed over, with the residents' society now being
                formed. For resale enquiries or to ask about other Nesting Tree projects, get in
                touch.
              </p>

              <a
                href={sales.phoneHref}
                class="flex items-center gap-4 mt-8 pt-7 border-t border-white/10 group"
              >
                <span
                  class="w-11 h-11 rounded-full bg-olive/25 border border-olive-100/30 flex items-center justify-center shrink-0 text-olive-100"
                >
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.5 21 3 14.5 3 6a2 2 0 0 1 1-2Z"
                    ></path></svg
                  >
                </span>
                <span>
                  <span class="block font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/50"
                    >{sales.name} Â· Sales</span
                  >
                  <span class="block font-display font-bold text-xl tracking-tight group-hover:text-olive-100 transition-colors"
                    >{sales.phone}</span
                  >
                </span>
              </a>

              <p class="flex items-start gap-3 mt-6 text-stone/60 text-sm leading-relaxed">
                <svg
                  class="w-4.5 h-4.5 mt-0.5 shrink-0 text-olive-100"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.lobby}
                ></svg>
                <span><span class="font-display text-[11px] font-bold uppercase tracking-[0.16em] text-stone/45 block mb-1">Office</span>{sales.office}</span>
              </p>

              <a
                href="#enquire"
                class="block text-center font-display font-bold uppercase tracking-[0.06em] text-sm bg-white text-ink px-6 py-4 rounded-[2px] mt-8 hover:bg-stone transition-colors"
                >Enquire about Shaurya</a
              >
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===================== HOME LAYOUTS ===================== -->
  <section id="homes" class="bg-card py-24 lg:py-32 border-t border-line scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="reveal max-w-3xl mb-16 lg:mb-24">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Home layouts</span
        >
        <h2
          class="font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          Two ways to call Shaurya home.
        </h2>
        <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">
          Four one-bedroom apartments and four 1RK homes â€” eight in all, across the four floors.
        </p>
      </div>

      <div class="flex flex-col gap-24 lg:gap-32">
        {
          unitTypes.map((u, i) => (
            <article class="reveal grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
              {/* home layout render */}
              <div class={`relative ${i % 2 === 1 ? "lg:order-2" : ""}`}>
                <div class="absolute -inset-3 sm:-inset-5 bg-olive-50 rounded-[4px] -z-0" />
                <div class="relative bg-stone border border-line rounded-[3px] p-4 sm:p-6 lg:p-8">
                  <img
                    src={u.plan}
                    alt={
                      u.planPending
                        ? `Shaurya ${u.type} â€” layout drawing not yet available`
                        : `Shaurya ${u.type} home layout`
                    }
                    class={`w-full h-auto object-contain rounded-[2px] ${
                      u.planPending ? "opacity-60" : "mix-blend-multiply"
                    }`}
                    loading="lazy"
                  />
                  <span
                    class={`absolute top-7 left-7 font-display text-[11px] font-bold uppercase tracking-[0.14em] px-3 py-1.5 rounded-[2px] ${
                      u.planPending
                        ? "bg-stone text-muted border border-dashed border-line"
                        : "bg-ink text-stone"
                    }`}
                  >
                    {u.planPending ? "Layout pending" : "Home layout"}
                  </span>
                  {u.planPending && (
                    <p class="text-mutedlight text-xs leading-relaxed mt-4 italic">
                      Placeholder image â€” the {u.type} layout drawing has not been supplied yet.
                    </p>
                  )}
                </div>
              </div>

              {/* details */}
              <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="font-display font-black text-4xl lg:text-5xl tracking-tight">
                    {u.type}
                  </h3>
                  <span class="font-display text-xs font-bold uppercase tracking-[0.12em] bg-olive-100 text-olive-dark px-3 py-1.5 rounded-full">
                    {u.units}
                  </span>
                </div>
                <p
                  class={
                    isTBD(u.series)
                      ? "text-mutedlight text-sm italic mt-4"
                      : "font-display text-sm font-bold uppercase tracking-[0.16em] text-olive-600 mt-4"
                  }
                >
                  {isTBD(u.series) ? `Series â€” ${TBD}` : u.series}
                </p>
                <p class="text-muted text-lg leading-relaxed mt-6 max-w-md">{u.blurb}</p>

                {/* key features â€” hidden while empty rather than faked */}
                {u.features.length > 0 && (
                  <ul class="mt-7 flex flex-col gap-3 max-w-md">
                    {u.features.map((f) => (
                      <li class="flex items-start gap-3 text-ink">
                        <svg
                          class="w-5 h-5 mt-0.5 shrink-0 text-olive-600"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          set:html={check}
                        />
                        <span class="text-base leading-snug">{f}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {/* room dimensions */}
                <div class="mt-9 border-t border-line max-w-md">
                  <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-muted pt-5 pb-1">
                    Room dimensions
                  </p>
                  {u.rooms.length > 0 ? (
                    <dl>
                      {u.rooms.map((r) => (
                        <div class="flex items-baseline justify-between gap-4 py-3 border-b border-line">
                          <dt class="text-muted text-base">{r.room}</dt>
                          <dd class="font-display font-semibold tracking-tight text-ink text-base tabular-nums">
                            {r.dim}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  ) : (
                    <p class="text-mutedlight text-base italic py-3">{TBD}</p>
                  )}
                </div>

                {u.features.length === 0 && (
                  <p class="text-mutedlight text-sm italic mt-5 max-w-md">
                    Key features for the {u.type} â€” {TBD}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ FLOOR PLANS ============================
       Mirrors the floor-plans section on prithvi.astro. All three Shaurya
       drawings are real renders, so the `planPending` branch below never
       fires today â€” it is kept for parity with the other project pages. -->
  <section id="floorplans" class="bg-stone py-24 lg:py-32 border-t border-line scroll-mt-20">
    <div class="max-w-[1600px] mx-auto px-5 sm:px-6 lg:px-12">
      <div class="reveal max-w-3xl mb-16 lg:mb-24">
        <span class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
          >Floor plans</span
        >
        <h2
          class="font-display font-black text-4xl sm:text-5xl lg:text-6xl tracking-tight mt-4 leading-[1.05]"
        >
          How Shaurya is laid out.
        </h2>
        <p class="text-muted text-lg sm:text-xl leading-relaxed mt-6">
          Parking at the base, two homes to a floor for four floors, and an open terrace over the
          top.
        </p>
      </div>

      <div class="flex flex-col gap-24 lg:gap-32">
        {
          floorPlans.map((fp, i) => (
            <article class="reveal grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
              {/* floor-plan render */}
              <div class={`relative ${i % 2 === 1 ? "lg:order-2" : ""}`}>
                <div class="absolute -inset-3 sm:-inset-5 bg-olive-50 rounded-[4px] -z-0" />
                <div class="relative bg-stone border border-line rounded-[3px] p-4 sm:p-6 lg:p-8">
                  <img
                    src={fp.plan}
                    alt={
                      fp.planPending
                        ? `Shaurya ${fp.title} â€” plan drawing not yet available`
                        : `Shaurya ${fp.title} plan â€” ${fp.label}`
                    }
                    class={`w-full h-auto object-contain rounded-[2px] ${
                      fp.planPending ? "opacity-60" : "mix-blend-multiply"
                    }`}
                    loading="lazy"
                  />
                  <span
                    class={`absolute top-7 left-7 font-display text-[11px] font-bold uppercase tracking-[0.14em] px-3 py-1.5 rounded-[2px] ${
                      fp.planPending
                        ? "bg-stone text-muted border border-dashed border-line"
                        : "bg-ink text-stone"
                    }`}
                  >
                    {fp.planPending ? "Plan pending" : "Floor plan"}
                  </span>
                  {fp.planPending && (
                    <p class="text-mutedlight text-xs leading-relaxed mt-4 italic">
                      Placeholder image â€” the {fp.title.toLowerCase()} drawing has not been supplied
                      yet.
                    </p>
                  )}
                </div>
              </div>

              {/* details */}
              <div class={i % 2 === 1 ? "lg:order-1" : ""}>
                <h3 class="font-display font-black text-4xl lg:text-5xl tracking-tight">
