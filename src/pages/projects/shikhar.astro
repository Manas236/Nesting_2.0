  <style>
    /* ============================================================
       Ride-the-peak amenities. A mountain photo is pinned on the left;
       a dashed trail threads six waypoints from base to summit. As each
       stage panel on the right scrolls to centre, its marker lights up
       and the trail fills behind it. Typography stays on Tailwind; this
       owns the mechanics: image, scrim, trail, markers, active/dim.
       ============================================================ */

    /* --- The pinned mountain canvas --- */
    .climb-canvas {
      /* gradient stands in until peak.jpg lands */
      background: linear-gradient(155deg, #b9c0a8 0%, #d7dac9 45%, var(--color-card) 100%);
    }
    .climb-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 40% center;
    }
    .climb-scrim {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
          to right,
          rgba(15, 18, 10, 0.28) 0%,
          rgba(15, 18, 10, 0) 34%,
          rgba(244, 242, 236, 0) 58%,
          var(--color-card) 100%
        ),
        linear-gradient(to bottom, rgba(15, 18, 10, 0.22), rgba(15, 18, 10, 0) 34%);
    }
    /* Mobile banner: the right-fade above only makes sense beside the
       desktop text column. Here the image is full-width with nothing to
       its right, so drop the fade and just darken the base for the flag. */
    @media (max-width: 1023px) {
      .climb-scrim {
        background: linear-gradient(
          to bottom,
          rgba(15, 18, 10, 0.28) 0%,
          rgba(15, 18, 10, 0) 32%,
          rgba(15, 18, 10, 0) 60%,
          rgba(15, 18, 10, 0.42) 100%
        );
      }
    }

    /* --- Dashed summit trail --- */
    .climb-trail {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
    }
    .climb-trail-base {
      fill: none;
      stroke: rgba(255, 255, 255, 0.85);
      stroke-width: 4;
      stroke-linecap: round;
      /* round dots (near-zero dash + round cap), evenly spaced in px */
      stroke-dasharray: 0.01 15;
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
    }
    .climb-trail-lit {
      fill: none;
      stroke: var(--color-olive);
      stroke-width: 4;
      stroke-linecap: round;
      /* pathLength=1 → one full-length dash we reveal via dashoffset */
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      filter: drop-shadow(0 0 5px rgba(110, 122, 69, 0.95));
      transition: stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* --- Summit flag --- */
    .climb-flag {
      position: absolute;
      transform: translate(-8%, -100%);
      display: flex;
      align-items: flex-end;
      gap: 0.5rem;
      pointer-events: none;
    }
    .climb-flag-icon {
      width: 26px;
      height: 26px;
      color: var(--color-olive);
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
    .climb-flag-label {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
      padding-bottom: 1px;
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
    }
    .climb-flag-label b {
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: 0.02em;
      color: #fff;
    }
    .climb-flag-label span {
      font-size: 0.66rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: rgba(255, 255, 255, 0.88);
    }

    /* --- Waypoint markers --- */
    .cmark {
      position: absolute;
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      gap: 0.6rem;
      white-space: nowrap;
      pointer-events: none;
    }
    .cmark-dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      border: 2px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        background 0.45s, border-color 0.45s, box-shadow 0.45s;
    }
    .cmark-label {
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.65);
      transition: color 0.4s;
    }
    .cmark-label b {
      font-weight: 800;
      margin-right: 0.5rem;
      letter-spacing: 0.04em;
    }
    /* climbed past → filled; current → big glow; ahead → faint (default) */
    .cmark.done .cmark-dot {
      background: var(--color-olive);
      border-color: #fff;
    }
    .cmark.current .cmark-dot {
      background: var(--color-olive);
      border-color: #fff;
      transform: scale(1.6);
      box-shadow: 0 0 0 5px rgba(110, 122, 69, 0.35),
        0 0 20px 4px rgba(110, 122, 69, 0.7);
    }
    .cmark.current .cmark-label {
      color: #fff;
    }
    .climb-live .cmark:not(.done):not(.current) .cmark-label {
      color: rgba(255, 255, 255, 0.62);
    }

    /* --- Right column: stage panels --- */
    .climb-stages {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .cstage {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      padding: 2rem 0;
    }
    @media (min-width: 1024px) {
      .cstage {
        grid-template-columns: 1fr;
        min-height: 100vh;
        align-content: center;
        padding: 0 1rem 0 3.5rem;
      }
    }

    /* Mobile climb rail (no pin) */
    .cstage-rail {
      position: relative;
    }
    .cstage-rail::before {
      content: "";
      position: absolute;
      left: 5px;
      top: 8px;
      bottom: -2rem;
      width: 2px;
      background: var(--color-line);
    }
    .cstage:last-child .cstage-rail::before {
      display: none;
    }
    .cstage-dot {
      position: relative;
      z-index: 1;
      display: block;
      width: 12px;
      height: 12px;
      margin-top: 6px;
      border-radius: 50%;
      background: var(--color-card);
      border: 2px solid var(--color-line);
      transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
    }
    @media (min-width: 1024px) {
      .cstage-rail {
        display: none;
      }
    }

    .cstage-meta {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      flex-wrap: wrap;
    }
    .cstage-floor {
      font-variant-numeric: tabular-nums;
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: 0.05em;
      color: var(--color-olive-600);
    }
    .cstage-cat {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-muted);
    }
    .cstage-flag {
      font-size: 0.62rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--color-olive-dark);
      background: var(--color-olive-100);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }
    .cstage-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.25rem;
      height: 3.25rem;
      margin-top: 1.4rem;
      border-radius: 3px;
      background: var(--color-olive-50);
      color: var(--color-olive-600);
      transition: background 0.4s, color 0.4s, transform 0.4s;
    }
    .cstage-title {
      font-size: clamp(1.9rem, 3.6vw, 3.1rem);
      line-height: 1.03;
      margin-top: 1.1rem;
    }
    .cstage-blurb {
      color: var(--color-muted);
      font-size: clamp(1.05rem, 1.4vw, 1.2rem);
      line-height: 1.6;
      margin-top: 1rem;
      max-width: 38ch;
    }
    .cstage-list {
      list-style: none;
      margin: 1.5rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .cstage-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      font-size: 0.98rem;
      color: var(--color-ink);
    }
    .cstage-list svg {
      width: 1.1rem;
      height: 1.1rem;
      flex-shrink: 0;
      margin-top: 0.15rem;
      color: var(--color-olive);
    }
    .cstage-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 2rem;
      padding: 0.85rem 1.4rem;
      border-radius: 3px;
      background: var(--color-olive);
      color: #fff;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      transition: background 0.3s, transform 0.3s;
    }
    .cstage-btn:hover {
      background: var(--color-olive-600);
      transform: translateY(-1px);
    }
    .cstage-btn svg {
      width: 1rem;
      height: 1rem;
    }

    /* JS-on: dim inactive stages on desktop, spotlight the active one */
    .climb-live .cstage {
      transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (min-width: 1024px) {
      .climb-live .cstage {
        opacity: 0.22;
        transform: translateY(10px);
      }
      .climb-live .cstage.is-active {
        opacity: 1;
        transform: none;
      }
    }
    .cstage.is-active .cstage-icon {
      background: var(--color-olive);
      color: #fff;
      transform: scale(1.06);
    }
    .cstage.is-active .cstage-dot {
      background: var(--color-olive);
      border-color: var(--color-olive);
      box-shadow: 0 0 0 4px rgba(110, 122, 69, 0.16);
    }

    @media (prefers-reduced-motion: reduce) {
      .climb-trail-lit,
      .cmark-dot,
      .cmark-label,
      .cstage,
      .cstage-icon,
      .cstage-dot,
      .cstage-btn {
        transition: none;
      }
    }
  </style>

  <script is:inline>
    const header = document.getElementById("site-header");
    const onScroll = () =>
      header.classList.toggle("is-scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    toggle.addEventListener("click", () => menu.classList.toggle("open"));
    menu.querySelectorAll(".mobile-link").forEach((link) =>
      link.addEventListener("click", () => menu.classList.remove("open"))
    );

    // Scroll-reveal: fade/lift elements in as they enter the viewport.
    // Only wired up when the head guard enabled reveal-on (JS + motion OK).
    if (document.documentElement.classList.contains("reveal-on")) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in-view");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      document
        .querySelectorAll(".reveal, .reveal-img")
        .forEach((el) => io.observe(el));
    }

    // Ride the peak: light up the waypoint for whichever stage panel is
    // centred in the viewport, and fill the trail up to it.
    (function () {
      const sec = document.querySelector("[data-climb]");
      if (!sec) return;
      const stages = Array.from(sec.querySelectorAll(".cstage"));
      const markers = Array.from(sec.querySelectorAll(".cmark"));
      const lit = sec.querySelector("[data-trail-lit]");
      if (!stages.length) return;

      sec.classList.add("climb-live");

      // Waypoint coordinates as percentages of the pinned image.
      const pts = markers.map((m) => ({
        x: parseFloat(m.dataset.x),
        y: parseFloat(m.dataset.y),
      }));

      const trail = sec.querySelector("[data-trail]");
      const base = sec.querySelector("[data-trail-base]");
      const canvas = trail ? trail.closest(".climb-canvas") : null;

      // Draw the trail in real pixels so it lands on the dots and keeps
      // even dashes; recompute the per-waypoint length fractions for fill.
      let frac = pts.map(() => 0);
      function drawTrail() {
        if (!canvas || !base) return;
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        if (!w || !h) return;
        const px = pts.map((p) => ({ x: (p.x / 100) * w, y: (p.y / 100) * h }));
        const d = px
          .map((p, i) => `${i ? "L" : "M"} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
          .join(" ");
        base.setAttribute("d", d);
        if (lit) lit.setAttribute("d", d);
        let total = 0;
        const cum = [0];
        for (let i = 1; i < px.length; i++) {
          total += Math.hypot(px[i].x - px[i - 1].x, px[i].y - px[i - 1].y);
          cum.push(total);
        }
        frac = cum.map((c) => (total ? c / total : 0));
      }

      let active = -1;
      function setActive(i) {
        active = i;
        stages.forEach((s, idx) => s.classList.toggle("is-active", idx === i));
        markers.forEach((m, idx) => {
          m.classList.toggle("done", idx < i);
          m.classList.toggle("current", idx === i);
        });
        if (lit) lit.style.strokeDashoffset = String(1 - (frac[i] || 0));
      }

      const io = new IntersectionObserver(
        (entries) => {
          let target = null;
          for (const e of entries) if (e.isIntersecting) target = e.target;
          if (target) setActive(Number(target.dataset.index));
        },
        { rootMargin: "-50% 0px -50% 0px", threshold: 0 }
      );
      stages.forEach((s) => io.observe(s));

      // Redraw + light the first stage so the section never opens all-dimmed.
      drawTrail();
      setActive(0);
      window.addEventListener(
        "resize",
        () => {
          drawTrail();
          if (active >= 0) setActive(active);
        },
        { passive: true }
      );
    })();
  </script>
</BaseLayout>
