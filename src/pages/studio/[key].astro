---
/* ============================================================
   GET /studio/<slug> — the editor sign-in page
   ------------------------------------------------------------
   The only page on the site that is not linked from anywhere, and the
   only one whose own URL is a secret. Reaching it gets you a
   passphrase box and nothing else: the slug controls who FINDS this
   page, the passphrase is what actually opens anything. See the note
   at the top of src/lib/edit-auth.ts.

   A WRONG SLUG IS A 404, and not a 404-flavoured "unauthorised". The
   response is the same bytes the site serves for a path that was never
   a route at all: same status, same body, same headers. There is
   nothing to tell a scanner it has found the right prefix and only the
   wrong segment, and the slug comparison itself is constant-time. A
   dictionary run against /studio/ learns nothing from any answer it
   gets — which is the point, and nginx's 5/minute limit on the prefix
   is what makes running one pointless as well as useless.

   HOW THAT 404 IS PRODUCED, because the obvious way does not work.
   `Astro.rewrite("/404")` is the documented route and it throws here:
   /404 is PRERENDERED (deliberately — see the long note in
   src/pages/404.astro about how much 404 traffic is bots), so its
   component is not in the server manifest and the rewrite fails with
   "Unexpectedly unable to find a component instance for route /404",
   which is a 500. A 500 where every other bad path gives a 404 is
   itself the tell this page must not have.

   So the response below is the one Astro's own router emits for an
   unmatched route: a bodyless 404 carrying `X-Astro-Error`. The App
   sees that header, strips it, and serves dist/client/404.html through
   the adapter — the identical code path, reading the identical file
   off disk, that answers /nonsense. Verified byte-for-byte against a
   genuine miss on Astro 7.0.0.

   That header is Astro internal (core/constants.js), not public API,
   so it is the thing to re-check on an Astro major. If it ever stops
   being honoured the failure is safe and visible: the page answers a
   bare 404 with an empty body rather than leaking anything. The test
   is in DEPLOYMENT.md §8 — curl a wrong slug, expect 404 and the
   branded page.

   Kept to one dynamic segment under /studio/ so the rest of the site's
   routing is untouched. /studio, /studio/, and /studio/a/b all miss
   this route entirely and get the ordinary 404.
   ============================================================ */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { checkSlug, isAuthed } from "../../lib/edit-auth";

export const prerender = false;

if (!checkSlug(Astro.params.key ?? "")) {
  return new Response(null, { status: 404, headers: { "X-Astro-Error": "true" } });
}

/* Set only after the slug has passed, so the 404 above carries none of
   them and stays byte-identical to every other 404.

   Referrer-Policy is the one worth explaining: the site-wide policy is
   strict-origin-when-cross-origin, which still sends the FULL URL on
   same-origin requests — and this page's full URL is the secret. The
   sign-in POST below would put the slug in a Referer header and from
   there into nginx's access log. no-referrer stops that. nginx repeats
   this header on the /studio/ prefix for the same reason; see the note
   there for why it has to. */
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "no-store");

const authed = isAuthed(Astro.request);

const field =
  "w-full bg-card border border-line rounded-[2px] px-4 py-3.5 text-ink " +
  "placeholder:text-mutedlight focus:outline-none focus:border-olive " +
  "focus:ring-2 focus:ring-olive/20 transition";
---

<BaseLayout title="Sign in — Nesting Tree" noindex>
  <main class="bg-stone min-h-screen flex items-center justify-center px-5 py-20">
    <div class="w-full max-w-md">
      <span
        class="font-display text-xs font-bold uppercase tracking-[0.22em] text-olive-600"
        >Nesting Tree</span
      >
      <h1
        class="font-display font-bold text-3xl sm:text-4xl tracking-tight mt-4 leading-[1.08]"
      >
        {authed ? "You are signed in to edit." : "Sign in to edit."}
      </h1>

      {
        authed ? (
          <div class="mt-8">
            <p class="text-muted leading-relaxed">
              Editing is on for this browser. Open any page and the
              <strong class="text-ink font-semibold"> Edit text</strong> button is
              in the corner.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3.5">
              <a href="/" class="btn btn-primary-light">
                Go to the site
              </a>
              <button id="out" type="button" class="btn btn-ghost-light">
                Sign out
              </button>
            </div>
            <p id="err" class="mt-5 text-sm text-red-700 hidden" role="alert" />
          </div>
        ) : (
          <div class="mt-8">
            <p class="text-muted leading-relaxed">
              Enter the shared passphrase to turn on in-page editing for this
              browser. It lasts seven days.
            </p>

            <label
              for="pass"
              class="block font-display text-xs font-bold uppercase tracking-[0.14em] text-muted mt-8 mb-2"
            >
              Passphrase
            </label>
            <input
              id="pass"
              type="password"
              autocomplete="current-password"
              autofocus
              placeholder="••••••••••••"
              class={field}
            />

            <p id="err" class="mt-4 text-sm text-red-700 hidden" role="alert" />

            <button id="go" type="button" class="btn btn-primary-light mt-6">
              Sign in
            </button>
          </div>
        )
      }
    </div>
  </main>

  <script is:inline>
    (function () {
      var err = document.getElementById("err");

      function fail(message) {
        if (!err) return;
        err.textContent = message;
        err.classList.remove("hidden");
      }

      function post(method, body) {
        return fetch("/api/edit-session", {
          method: method,
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: body ? JSON.stringify(body) : undefined,
        });
      }

      var out = document.getElementById("out");
      if (out) {
        out.addEventListener("click", function () {
          post("DELETE").then(
            function () {
              location.reload();
            },
            function () {
              fail("Could not reach the server. Try again.");
            }
          );
        });
        return;
      }

      var pass = document.getElementById("pass");
      var go = document.getElementById("go");
      if (!pass || !go) return;

      var busy = false;

      function submit() {
        if (busy) return;
        if (err) err.classList.add("hidden");

        var value = pass.value;
        if (!value) {
          fail("Enter the passphrase.");
          return;
        }

        busy = true;
        go.disabled = true;

        post("POST", { passphrase: value }).then(
          function (res) {
            if (res.ok) {
              // replace, not assign: the secret URL must not be left in
              // the address bar or sitting one Back press away in the
              // history of a browser somebody else may pick up.
              window.location.replace("/");
              return;
            }
            busy = false;
            go.disabled = false;
            pass.value = "";
            pass.focus();
            fail(
              res.status === 429
                ? "Too many attempts. Wait a minute and try again."
                : "That passphrase is not right."
            );
          },
          function () {
            busy = false;
            go.disabled = false;
            fail("Could not reach the server. Try again.");
          }
        );
      }

      go.addEventListener("click", submit);
      pass.addEventListener("keydown", function (e) {
        if (e.key === "Enter") submit();
      });
    })();
  </script>
</BaseLayout>
